+/* ------------------------------------------------------------------------- */
+/* Bridge Handlers: Sandboxed File I/O                                       */
+/* ------------------------------------------------------------------------- */
+
+static void handle_file(VelaHost *host, gint64 id, const gchar *method, JsonObject *params) {
+    const gchar *uri = json_object_has_member(params, "uri") ? json_object_get_string_member(params, "uri") : "";
+    gchar *path = resolve_internal_uri(host, uri);
+
+    if (g_strcmp0(method, "file.copy") == 0 || g_strcmp0(method, "file.move") == 0) {
+        g_free(path);
+        gchar *src = resolve_internal_uri(host, json_object_get_string_member(params, "srcUri"));
+        gchar *dst = resolve_internal_uri(host, json_object_get_string_member(params, "dstUri"));
+        if (!src || !dst) {
+            g_free(src); g_free(dst);
+            bridge_resolve_err(host, id, "Invalid file URI");
+            return;
+        }
+        gchar *parent = g_path_get_dirname(dst);
+        g_mkdir_with_parents(parent, 0755);
+        g_free(parent);
+        GFile *gf_src = g_file_new_for_path(src);
+        GFile *gf_dst = g_file_new_for_path(dst);
+        GError *err = NULL;
+        gboolean ok = (g_strcmp0(method, "file.copy") == 0)
+                          ? g_file_copy(gf_src, gf_dst, G_FILE_COPY_OVERWRITE, NULL, NULL, NULL, &err)
+                          : g_file_move(gf_src, gf_dst, G_FILE_COPY_OVERWRITE, NULL, NULL, NULL, &err);
+        g_object_unref(gf_src);
+        g_object_unref(gf_dst);
+        g_free(src);
+        g_free(dst);
+        if (!ok) {
+            bridge_resolve_err(host, id, err ? err->message : "File operation failed");
+            if (err) g_error_free(err);
+        } else {
+            bridge_resolve(host, id, TRUE, NULL);
+        }
+        return;
+    }
+
+    if (!path) {
+        bridge_resolve_err(host, id, "Invalid internal:// URI");
+        return;
+    }
+
+    if (g_strcmp0(method, "file.readText") == 0) {
+        gchar *text = NULL;
+        GError *err = NULL;
+        if (!g_file_get_contents(path, &text, NULL, &err)) {
+            bridge_resolve_err(host, id, err->message);
+            g_error_free(err);
+        } else {
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "text");
+            json_builder_add_string_value(b, text);
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+            g_free(text);
+        }
+    } else if (g_strcmp0(method, "file.writeText") == 0) {
+        const gchar *text = json_object_get_string_member(params, "text");
+        gboolean append = json_object_has_member(params, "append") && json_object_get_boolean_member(params, "append");
+        gchar *parent = g_path_get_dirname(path);
+        g_mkdir_with_parents(parent, 0755);
+        g_free(parent);
+        FILE *f = fopen(path, append ? "ab" : "wb");
+        if (!f) {
+            bridge_resolve_err(host, id, g_strerror(errno));
+        } else {
+            if (text && *text) fwrite(text, 1, strlen(text), f);
+            fclose(f);
+            bridge_resolve(host, id, TRUE, NULL);
+        }
+    } else if (g_strcmp0(method, "file.readBase64") == 0) {
+        gchar *data = NULL;
+        gsize len = 0;
+        GError *err = NULL;
+        if (!g_file_get_contents(path, &data, &len, &err)) {
+            bridge_resolve_err(host, id, err->message);
+            g_error_free(err);
+        } else {
+            gchar *b64 = g_base64_encode((const guchar *)data, len);
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "base64");
+            json_builder_add_string_value(b, b64);
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+            g_free(b64);
+            g_free(data);
+        }
+    } else if (g_strcmp0(method, "file.writeBase64") == 0) {
+        const gchar *b64 = json_object_get_string_member(params, "base64");
+        gboolean append = json_object_has_member(params, "append") && json_object_get_boolean_member(params, "append");
+        gsize out_len = 0;
+        guchar *raw = g_base64_decode(b64 ? b64 : "", &out_len);
+        gchar *parent = g_path_get_dirname(path);
+        g_mkdir_with_parents(parent, 0755);
+        g_free(parent);
+        FILE *f = fopen(path, append ? "ab" : "wb");
+        if (!f) {
+            bridge_resolve_err(host, id, g_strerror(errno));
+        } else {
+            if (out_len > 0) fwrite(raw, 1, out_len, f);
+            fclose(f);
+            bridge_resolve(host, id, TRUE, NULL);
+        }
+        g_free(raw);
+    } else if (g_strcmp0(method, "file.delete") == 0) {
+        if (g_unlink(path) == 0 || errno == ENOENT) bridge_resolve(host, id, TRUE, NULL);
+        else bridge_resolve_err(host, id, g_strerror(errno));
+    } else if (g_strcmp0(method, "file.access") == 0) {
+        if (g_file_test(path, G_FILE_TEST_EXISTS)) bridge_resolve(host, id, TRUE, NULL);
+        else bridge_resolve_err(host, id, "File does not exist");
+    } else if (g_strcmp0(method, "file.mkdir") == 0) {
+        if (g_mkdir_with_parents(path, 0755) == 0) bridge_resolve(host, id, TRUE, NULL);
+        else bridge_resolve_err(host, id, g_strerror(errno));
+    } else if (g_strcmp0(method, "file.rmdir") == 0) {
+        if (g_rmdir(path) == 0) bridge_resolve(host, id, TRUE, NULL);
+        else bridge_resolve_err(host, id, g_strerror(errno));
+    } else if (g_strcmp0(method, "file.list") == 0) {
+        GDir *gd = g_dir_open(path, 0, NULL);
+        if (!gd) {
+            bridge_resolve_err(host, id, "Cannot open directory");
+        } else {
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "fileList");
+            json_builder_begin_array(b);
+            const gchar *entry;
+            while ((entry = g_dir_read_name(gd)) != NULL) {
+                gchar *child = g_build_filename(path, entry, NULL);
+                struct stat st;
+                if (stat(child, &st) == 0) {
+                    gchar *child_uri = g_strdup_printf("%s%s%s", uri, g_str_has_suffix(uri, "/") ? "" : "/", entry);
+                    json_builder_begin_object(b);
+                    json_builder_set_member_name(b, "uri");
+                    json_builder_add_string_value(b, child_uri);
+                    json_builder_set_member_name(b, "length");
+                    json_builder_add_int_value(b, st.st_size);
+                    json_builder_set_member_name(b, "lastModifiedTime");
+                    json_builder_add_int_value(b, (gint64)st.st_mtime * 1000);
+                    json_builder_end_object(b);
+                    g_free(child_uri);
+                }
+                g_free(child);
+            }
+            json_builder_end_array(b);
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+            g_dir_close(gd);
+        }
+    } else if (g_strcmp0(method, "file.get") == 0) {
+        struct stat st;
+        if (stat(path, &st) != 0) {
+            bridge_resolve_err(host, id, g_strerror(errno));
+        } else {
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "uri");
+            json_builder_add_string_value(b, uri);
+            json_builder_set_member_name(b, "length");
+            json_builder_add_int_value(b, st.st_size);
+            json_builder_set_member_name(b, "lastModifiedTime");
+            json_builder_add_int_value(b, (gint64)st.st_mtime * 1000);
+            json_builder_set_member_name(b, "type");
+            json_builder_add_string_value(b, S_ISDIR(st.st_mode) ? "dir" : "file");
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+        }
+    }
+    g_free(path);
+}
