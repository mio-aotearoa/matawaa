+/* ------------------------------------------------------------------------- */
+/* Bridge Handlers: Vibrator, Crypto, Device, Network, Launcher              */
+/* ------------------------------------------------------------------------- */
+
+static void trigger_vibrator(const gchar *mode) {
+    gboolean is_short = (mode && g_strcmp0(mode, "short") == 0);
+    /* 1. Try AsteroidOS ngfd over system D-Bus */
+    GDBusConnection *bus = g_bus_get_sync(G_BUS_TYPE_SYSTEM, NULL, NULL);
+    if (bus) {
+        GVariantBuilder props;
+        g_variant_builder_init(&props, G_VARIANT_TYPE("a{sv}"));
+        GVariant *res = g_dbus_connection_call_sync(
+            bus,
+            "com.nokia.NonGraphicFeedback1.Backend",
+            "/com/nokia/NonGraphicFeedback1",
+            "com.nokia.NonGraphicFeedback1",
+            "Play",
+            g_variant_new("(sa{sv})", is_short ? "feedback_press" : "alarm_clock", &props),
+            NULL, G_DBUS_CALL_FLAGS_NONE, 300, NULL, NULL);
+        if (res) g_variant_unref(res);
+        g_object_unref(bus);
+        if (res) return;
+    }
+    /* 2. Fallback to Android/Qualcomm timed_output vibrator sysfs */
+    FILE *f = fopen("/sys/class/timed_output/vibrator/enable", "w");
+    if (f) {
+        fprintf(f, "%d\n", is_short ? 35 : 140);
+        fclose(f);
+    }
+}
+
+static GChecksumType parse_algo(const gchar *algo) {
+    if (!algo) return G_CHECKSUM_SHA256;
+    if (g_ascii_strcasecmp(algo, "MD5") == 0) return G_CHECKSUM_MD5;
+    if (g_ascii_strcasecmp(algo, "SHA1") == 0) return G_CHECKSUM_SHA1;
+    if (g_ascii_strcasecmp(algo, "SHA512") == 0) return G_CHECKSUM_SHA512;
+    return G_CHECKSUM_SHA256;
+}
+
+static void scan_apps_dir(VelaHost *host, const gchar *apps_dir, JsonBuilder *arr_builder) {
+    GDir *gd = g_dir_open(apps_dir, 0, NULL);
+    if (!gd) return;
+    const gchar *entry;
+    while ((entry = g_dir_read_name(gd)) != NULL) {
+        if (entry[0] == '.') continue;
+        gchar *app_path = g_build_filename(apps_dir, entry, NULL);
+        gchar *bjson = g_build_filename(app_path, "bundle.json", NULL);
+        gchar *mjson = g_build_filename(app_path, "manifest.json", NULL);
+        gchar *src_mjson = g_build_filename(app_path, "src", "manifest.json", NULL);
+
+        const gchar *meta_file = NULL;
+        gboolean is_bundle = FALSE;
+        if (g_file_test(bjson, G_FILE_TEST_IS_REGULAR)) {
+            meta_file = bjson;
+            is_bundle = TRUE;
+        } else if (g_file_test(mjson, G_FILE_TEST_IS_REGULAR)) {
+            meta_file = mjson;
+        } else if (g_file_test(src_mjson, G_FILE_TEST_IS_REGULAR)) {
+            meta_file = src_mjson;
+        }
+
+        if (meta_file) {
+            JsonParser *parser = json_parser_new();
+            if (json_parser_load_from_file(parser, meta_file, NULL)) {
+                JsonObject *root = json_node_get_object(json_parser_get_root(parser));
+                JsonObject *man = (is_bundle && root && json_object_has_member(root, "manifest"))
+                                      ? json_object_get_object_member(root, "manifest")
+                                      : root;
+                if (man) {
+                    const gchar *pkg = json_object_has_member(man, "package") ? json_object_get_string_member(man, "package") : entry;
+                    const gchar *name = json_object_has_member(man, "name") ? json_object_get_string_member(man, "name") : pkg;
+                    const gchar *ver = json_object_has_member(man, "versionName") ? json_object_get_string_member(man, "versionName") : "1.0";
+                    const gchar *icon = json_object_has_member(man, "icon") ? json_object_get_string_member(man, "icon") : "";
+
+                    json_builder_begin_object(arr_builder);
+                    json_builder_set_member_name(arr_builder, "package");
+                    json_builder_add_string_value(arr_builder, pkg);
+                    json_builder_set_member_name(arr_builder, "name");
+                    json_builder_add_string_value(arr_builder, name);
+                    json_builder_set_member_name(arr_builder, "versionName");
+                    json_builder_add_string_value(arr_builder, ver);
+                    json_builder_set_member_name(arr_builder, "path");
+                    json_builder_add_string_value(arr_builder, app_path);
+                    if (is_bundle && icon && *icon) {
+                        g_hash_table_insert(host->launcher_icon_dirs, g_strdup(pkg), g_strdup(app_path));
+                        const gchar *clean_icon = (*icon == '/') ? icon + 1 : icon;
+                        gchar *icon_url = g_strdup_printf("vela://app-icon/%s/%s", pkg, clean_icon);
+                        json_builder_set_member_name(arr_builder, "iconUrl");
+                        json_builder_add_string_value(arr_builder, icon_url);
+                        g_free(icon_url);
+                    }
+                    json_builder_end_object(arr_builder);
+                }
+            }
+            g_object_unref(parser);
+        }
+        g_free(src_mjson);
+        g_free(mjson);
+        g_free(bjson);
+        g_free(app_path);
+    }
+    g_dir_close(gd);
+}
+
+typedef struct {
+    VelaHost *host;
+    gint64 id;
+} ClipboardReadCtx;
+
+static void on_clipboard_read(GObject *source, GAsyncResult *res, gpointer user_data) {
+    ClipboardReadCtx *ctx = (ClipboardReadCtx *)user_data;
+    GError *err = NULL;
+    gchar *text = gdk_clipboard_read_text_finish(GDK_CLIPBOARD(source), res, &err);
+    if (err) {
+        g_error_free(err);
+        text = g_strdup("");
+    }
+    JsonBuilder *b = json_builder_new();
+    json_builder_begin_object(b);
+    json_builder_set_member_name(b, "text");
+    json_builder_add_string_value(b, text ? text : "");
+    json_builder_end_object(b);
+    JsonNode *n = json_builder_get_root(b);
+    bridge_resolve(ctx->host, ctx->id, TRUE, n);
+    json_node_free(n);
+    g_object_unref(b);
+    g_free(text);
+    g_free(ctx);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Main Script Message Dispatcher                                            */
+/* ------------------------------------------------------------------------- */
+
+static void on_bridge_message(WebKitUserContentManager *ucm, JSCValue *value, gpointer user_data) {
+    (void)ucm;
+    VelaHost *host = (VelaHost *)user_data;
+    gchar *raw = jsc_value_to_string(value);
+    if (!raw) return;
+
+    JsonParser *parser = json_parser_new();
+    if (!json_parser_load_from_data(parser, raw, -1, NULL)) {
+        g_object_unref(parser);
+        g_free(raw);
+        return;
+    }
+
+    JsonObject *req = json_node_get_object(json_parser_get_root(parser));
+    gint64 id = json_object_get_int_member(req, "id");
+    const gchar *method = json_object_get_string_member(req, "method");
+    JsonObject *params = json_object_has_member(req, "params")
+                             ? json_object_get_object_member(req, "params")
+                             : NULL;
+
+    if (g_strcmp0(method, "http.fetch") == 0) {
+        handle_http_request(host, id, params, FALSE);
+    } else if (g_strcmp0(method, "request.download") == 0) {
+        handle_http_request(host, id, params, TRUE);
+    } else if (g_str_has_prefix(method, "storage.")) {
+        handle_storage(host, id, method, params);
+    } else if (g_str_has_prefix(method, "file.")) {
+        handle_file(host, id, method, params);
+    } else if (g_str_has_prefix(method, "interconnect.")) {
+        handle_interconnect(host, id, method, params);
+    } else if (g_strcmp0(method, "vibrator.vibrate") == 0) {
+        const gchar *mode = (params && json_object_has_member(params, "mode"))
+                                ? json_object_get_string_member(params, "mode")
+                                : "long";
+        trigger_vibrator(mode);
+        bridge_resolve(host, id, TRUE, NULL);
+    } else if (g_strcmp0(method, "device.getInfo") == 0) {
+        int w = gtk_widget_get_width(host->window);
+        int h = gtk_widget_get_height(host->window);
+        if (w <= 0) w = 416;
+        if (h <= 0) h = 416;
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "brand"); json_builder_add_string_value(b, "Matawaa");
+        json_builder_set_member_name(b, "manufacturer"); json_builder_add_string_value(b, "AsteroidOS");
+        json_builder_set_member_name(b, "model"); json_builder_add_string_value(b, "AsteroidWatch");
+        json_builder_set_member_name(b, "product"); json_builder_add_string_value(b, "matawaa");
+        json_builder_set_member_name(b, "osType"); json_builder_add_string_value(b, "VelaCompat");
+        json_builder_set_member_name(b, "osVersionName"); json_builder_add_string_value(b, "1.0.0");
+        json_builder_set_member_name(b, "platformVersionName"); json_builder_add_string_value(b, "1.1.0");
+        json_builder_set_member_name(b, "platformVersionCode"); json_builder_add_int_value(b, 1100);
+        json_builder_set_member_name(b, "language"); json_builder_add_string_value(b, "zh");
+        json_builder_set_member_name(b, "region"); json_builder_add_string_value(b, "CN");
+        json_builder_set_member_name(b, "windowWidth"); json_builder_add_int_value(b, w);
+        json_builder_set_member_name(b, "windowHeight"); json_builder_add_int_value(b, h);
+        json_builder_set_member_name(b, "screenWidth"); json_builder_add_int_value(b, w);
+        json_builder_set_member_name(b, "screenHeight"); json_builder_add_int_value(b, h);
+        json_builder_set_member_name(b, "screenDensity"); json_builder_add_int_value(b, 1);
+        json_builder_set_member_name(b, "screenShape"); json_builder_add_string_value(b, w == h ? "circle" : "rect");
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "device.getDeviceId") == 0) {
+        gchar *mid = NULL;
+        if (!g_file_get_contents("/etc/machine-id", &mid, NULL, NULL)) {
+            mid = g_strdup("matawaa-watch-device");
+        }
+        g_strstrip(mid);
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "deviceId");
+        json_builder_add_string_value(b, mid);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+        g_free(mid);
+    } else if (g_strcmp0(method, "crypto.hashDigest") == 0) {
+        const gchar *data = json_object_get_string_member(params, "data");
+        const gchar *algo = json_object_get_string_member(params, "algo");
+        gchar *digest = g_compute_checksum_for_string(parse_algo(algo), data ? data : "", -1);
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "digest");
+        json_builder_add_string_value(b, digest);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+        g_free(digest);
+    } else if (g_strcmp0(method, "crypto.hmacDigest") == 0) {
+        const gchar *data = json_object_get_string_member(params, "data");
+        const gchar *key = json_object_get_string_member(params, "key");
+        const gchar *algo = json_object_get_string_member(params, "algo");
+        gchar *digest = g_compute_hmac_for_string(parse_algo(algo),
+                                                  (const guchar *)(key ? key : ""),
+                                                  key ? strlen(key) : 0,
+                                                  data ? data : "", -1);
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "digest");
+        json_builder_add_string_value(b, digest);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+        g_free(digest);
+    } else if (g_strcmp0(method, "clipboard.set") == 0) {
+        const gchar *text = json_object_get_string_member(params, "text");
+        GdkDisplay *disp = gtk_widget_get_display(host->window);
+        if (disp) gdk_clipboard_set_text(gdk_display_get_clipboard(disp), text ? text : "");
+        bridge_resolve(host, id, TRUE, NULL);
+    } else if (g_strcmp0(method, "clipboard.get") == 0) {
+        GdkDisplay *disp = gtk_widget_get_display(host->window);
+        if (!disp) {
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "text");
+            json_builder_add_string_value(b, "");
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+        } else {
+            ClipboardReadCtx *cctx = g_new0(ClipboardReadCtx, 1);
+            cctx->host = host;
+            cctx->id = id;
+            gdk_clipboard_read_text_async(gdk_display_get_clipboard(disp), NULL, on_clipboard_read, cctx);
+        }
+    } else if (g_strcmp0(method, "qr.encode") == 0) {
+        const gchar *text = (params && json_object_has_member(params, "text"))
+                                ? json_object_get_string_member(params, "text")
+                                : "";
+        QRcode *qr = QRcode_encodeString(text ? text : "", 0, QR_ECLEVEL_M, QR_MODE_8, 1);
+        if (!qr) {
+            bridge_resolve_err(host, id, "QR encoding failed");
+        } else {
+            int w = qr->width;
+            gchar *bits = g_malloc((gsize)w * (gsize)w + 1);
+            for (int i = 0; i < w * w; i++) {
+                bits[i] = (qr->data[i] & 1) ? '1' : '0';
+            }
+            bits[w * w] = '\0';
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "width");
+            json_builder_add_int_value(b, w);
+            json_builder_set_member_name(b, "bits");
+            json_builder_add_string_value(b, bits);
+            json_builder_end_object(b);
+            JsonNode *n = json_builder_get_root(b);
+            bridge_resolve(host, id, TRUE, n);
+            json_node_free(n);
+            g_object_unref(b);
+            g_free(bits);
+            QRcode_free(qr);
+        }
+    } else if (g_strcmp0(method, "network.getType") == 0) {
+        GNetworkMonitor *mon = g_network_monitor_get_default();
+        gboolean online = g_network_monitor_get_network_available(mon);
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "type");
+        json_builder_add_string_value(b, online ? "wifi" : "none");
+        json_builder_set_member_name(b, "metered");
+        json_builder_add_boolean_value(b, g_network_monitor_get_network_metered(mon));
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "launcher.listApps") == 0) {
+        g_hash_table_remove_all(host->launcher_icon_dirs);
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "apps");
+        json_builder_begin_array(b);
+        gchar *user_apps = g_build_filename(g_get_user_data_dir(), "asteroid-vela", "apps", NULL);
+        scan_apps_dir(host, user_apps, b);
+        g_free(user_apps);
+        scan_apps_dir(host, "/var/lib/vela/apps", b);
+        scan_apps_dir(host, "/run/current-system/sw/share/vela/apps", b);
+        json_builder_end_array(b);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "launcher.launchApp") == 0) {
+        const gchar *path = json_object_get_string_member(params, "path");
+        GError *err = NULL;
+        if (!activate_app_path(host, path, &err)) {
+            bridge_resolve_err(host, id, err ? err->message : "Launch failed");
+            if (err) g_error_free(err);
+        } else {
+            bridge_resolve(host, id, TRUE, NULL);
+        }
+    } else if (g_strcmp0(method, "app.terminate") == 0) {
+        bridge_resolve(host, id, TRUE, NULL);
+        if (host->launched_from_cli) {
+            g_application_quit(G_APPLICATION(host->gtk_app));
+        } else {
+            webkit_web_view_load_uri(host->webview, "vela://runtime/launcher.html");
+        }
+    } else {
+        bridge_resolve_err(host, id, "Unknown bridge method");
+    }
+
+    g_object_unref(parser);
+    g_free(raw);
+}
+
+/* ------------------------------------------------------------------------- */
+/* GTK Application Activation                                                */
+/* ------------------------------------------------------------------------- */
+
+static void on_activate(GtkApplication *app, gpointer user_data) {
+    VelaHost *host = (VelaHost *)user_data;
+
+    host->window = gtk_application_window_new(app);
+    gtk_window_set_title(GTK_WINDOW(host->window), "Vela Apps");
+    gtk_window_set_default_size(GTK_WINDOW(host->window), 416, 416);
+
+    WebKitWebContext *ctx = webkit_web_context_get_default();
+    webkit_web_context_register_uri_scheme(ctx, "vela", on_vela_uri_scheme, host, NULL);
+
+    WebKitUserContentManager *ucm = webkit_user_content_manager_new();
+    webkit_user_content_manager_register_script_message_handler(ucm, "velaBridge", NULL);
+    g_signal_connect(ucm, "script-message-received::velaBridge", G_CALLBACK(on_bridge_message), host);
+
+    host->webview = WEBKIT_WEB_VIEW(g_object_new(
+        WEBKIT_TYPE_WEB_VIEW,
+        "web-context", ctx,
+        "user-content-manager", ucm,
+        NULL));
+
+    WebKitSettings *settings = webkit_web_view_get_settings(host->webview);
+    webkit_settings_set_enable_javascript(settings, TRUE);
+    webkit_settings_set_javascript_can_access_clipboard(settings, TRUE);
+    webkit_settings_set_enable_write_console_messages_to_stdout(settings, TRUE);
+
+    GdkRGBA black = {0.0, 0.0, 0.0, 1.0};
+    webkit_web_view_set_background_color(host->webview, &black);
+
+    gtk_window_set_child(GTK_WINDOW(host->window), GTK_WIDGET(host->webview));
+    gtk_window_present(GTK_WINDOW(host->window));
+
+    if (host->cli_target) {
+        GError *err = NULL;
+        if (!activate_app_path(host, host->cli_target, &err)) {
+            g_printerr("[asteroid-vela] Failed to launch %s: %s\n",
+                       host->cli_target, err ? err->message : "unknown error");
+            if (err) g_error_free(err);
+            webkit_web_view_load_uri(host->webview, "vela://runtime/launcher.html");
+        }
+    } else {
+        webkit_web_view_load_uri(host->webview, "vela://runtime/launcher.html");
+    }
+}
+
+int main(int argc, char **argv) {
+    VelaHost host = {0};
+    host.soup = soup_session_new();
+    host.launcher_icon_dirs = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, g_free);
+
+    const gchar *env_runtime = g_getenv("VELA_RUNTIME_DIR");
+    host.runtime_dir = g_strdup(env_runtime && *env_runtime ? env_runtime : VELA_DATADIR "/runtime");
+
+    const gchar *env_compiler = g_getenv("VELA_COMPILER_BIN");
+    host.compiler_bin = g_strdup(env_compiler && *env_compiler ? env_compiler : "vela-compile");
+
+    if (argc > 1 && argv[1][0] != '-') {
+        host.cli_target = g_strdup(argv[1]);
+        host.launched_from_cli = TRUE;
+    }
+
+    host.gtk_app = gtk_application_new("org.asteroidos.vela", G_APPLICATION_NON_UNIQUE);
+    g_signal_connect(host.gtk_app, "activate", G_CALLBACK(on_activate), &host);
+
+    /* Pass only argv[0] so GApplication doesn't reject our positional app path */
+    int fake_argc = 1;
+    int status = g_application_run(G_APPLICATION(host.gtk_app), fake_argc, argv);
+
+    g_clear_object(&host.ws_conn);
+    g_clear_object(&host.soup);
+    g_hash_table_destroy(host.launcher_icon_dirs);
+    g_free(host.runtime_dir);
+    g_free(host.compiler_bin);
+    g_free(host.cli_target);
+    g_free(host.active_bundle_dir);
+    g_free(host.active_package);
+    g_object_unref(host.gtk_app);
+    return status;
+}
