+      instance._childComponents.push(childInst);
+      if (attrs.id) instance._childVms.set(String(evalInterpolation(attrs.id, vm, locals)), childInst._vm);
+      childInst._domRoot = host;
+      renderComponentInto(childInst._vm, host);
