+        el.addEventListener("load", () => {
+          invokeEventHandler(handlerExpr, vm, locals, { width: el.naturalWidth, height: el.naturalHeight });
+        });
+      } else if (evName === "change") {
+        el.addEventListener("input", () => {
+          const payload = tag === "switch"
+            ? { checked: el.checked }
+            : tag === "slider"
+              ? { progress: Number(el.value), value: Number(el.value) }
+              : { value: el.value, text: el.value };
+          invokeEventHandler(handlerExpr, vm, locals, payload);
+        });
+      } else {
+        el.addEventListener(evName, (e) => {
+          invokeEventHandler(handlerExpr, vm, locals, e);
+        });
+      }
+    }
+
+    // Render children (except void/widget elements whose content is generated above)
+    if (!["image", "img", "input", "progress", "slider", "switch", "qrcode"].includes(tag)) {
+      renderChildren(node.children || [], el, instance, locals);
+    }
+
+    parentDom.appendChild(el);
+  }
+
+  function renderComponentInto(vm, container) {
+    const inst = vm._compId ? vm : null;
+    // Retrieve raw instance via internal fields
+    const raw = {
+      _compId: vm._compId,
+      _meta: vm._meta,
+      _def: vm._def,
+      _vm: vm,
+      _elementMap: vm._elementMap,
+      _childVms: vm._childVms,
+      _childComponents: vm._childComponents,
+    };
+    // Preserve scroll positions across re-renders
+    const scrollPositions = [];
+    container.querySelectorAll(".vela-scroll, .vela-list").forEach((s, idx) => {
+      scrollPositions[idx] = { top: s.scrollTop, left: s.scrollLeft };
+    });
+
+    // Clean previous child component instances
+    if (raw._childComponents) {
+      for (const c of raw._childComponents) c._destroy();
+      raw._childComponents.length = 0;
+    }
+    raw._elementMap.clear();
+    raw._childVms.clear();
+
+    const frag = document.createDocumentFragment();
+    renderChildren(raw._meta.template || [], frag, raw, {});
+    container.innerHTML = "";
+    container.appendChild(frag);
+
+    // Restore scroll positions
+    container.querySelectorAll(".vela-scroll, .vela-list").forEach((s, idx) => {
+      if (scrollPositions[idx]) {
+        s.scrollTop = scrollPositions[idx].top;
+        s.scrollLeft = scrollPositions[idx].left;
+      }
+    });
+  }
+
+  // =========================================================================
+  // 9. Router & Page Lifecycle
+  // =========================================================================
+  function resolveRouteComponent(uri) {
+    const pages = (APP_MANIFEST.router && APP_MANIFEST.router.pages) || {};
+    const clean = String(uri || "").replace(/^\/+/, "");
+    // Direct key match: `pages/home`
+    if (pages[clean]) {
+      const compName = pages[clean].component || "index";
+      const uxPath = `${clean}/${compName}.ux`;
+      if (APP_META.components[uxPath]) return { routePath: clean, routeName: compName, compId: uxPath };
+    }
+    // Match by `path` field (e.g. `/home` -> `pages/home`)
+    for (const [pageDir, cfg] of Object.entries(pages)) {
+      if (cfg.path && (cfg.path === uri || cfg.path.replace(/^\/+/, "") === clean)) {
+        const compName = cfg.component || "index";
+        const uxPath = `${pageDir}/${compName}.ux`;
+        if (APP_META.components[uxPath]) return { routePath: pageDir, routeName: compName, compId: uxPath };
+      }
+    }
+    // Fallback: try `<clean>.ux` or `<clean>/index.ux`
+    if (APP_META.components[clean + ".ux"]) return { routePath: clean, routeName: clean, compId: clean + ".ux" };
+    if (APP_META.components[clean + "/index.ux"]) return { routePath: clean, routeName: "index", compId: clean + "/index.ux" };
+    return null;
+  }
+
+  function destroyPage(page) {
+    if (!page) return;
+    if (typeof page.inst._def.onHide === "function") {
+      try { page.inst._def.onHide.call(page.inst._vm); } catch (_) {}
+    }
+    page.inst._destroy();
+    if (page.dom && page.dom.parentNode) page.dom.parentNode.removeChild(page.dom);
+  }
+
+  function navigateTo(uri, params, replace) {
+    const resolved = resolveRouteComponent(uri);
+    if (!resolved) {
+      showToastUI("Page not found: " + uri);
+      return;
+    }
+
+    if (activePage) {
+      if (replace) {
+        const old = pageStack.pop();
+        destroyPage(old);
+      } else {
+        if (typeof activePage.inst._def.onHide === "function") {
+          try { activePage.inst._def.onHide.call(activePage.inst._vm); } catch (_) {}
+        }
+        activePage.dom.style.display = "none";
+      }
+    }
+
+    const dom = document.createElement("div");
+    dom.className = "vela-page";
+    if (APP_MANIFEST.display && APP_MANIFEST.display.backgroundColor) {
+      dom.style.backgroundColor = APP_MANIFEST.display.backgroundColor;
+    }
+
+    const inst = instantiateComponent(resolved.compId, null, null, params, null);
+    inst._domRoot = dom;
+
+    const vp = document.getElementById("vela-viewport");
+    vp.appendChild(dom);
+    renderComponentInto(inst._vm, dom);
+
+    const page = {
+      routePath: resolved.routePath,
+      routeName: resolved.routeName,
+      compId: resolved.compId,
+      inst,
+      dom,
+    };
+    pageStack.push(page);
+    activePage = page;
+
+    if (typeof inst._def.onReady === "function") {
+      try { inst._def.onReady.call(inst._vm); } catch (e) { console.error("[vela] onReady error:", e); }
+    }
+    if (typeof inst._def.onShow === "function") {
+      try { inst._def.onShow.call(inst._vm); } catch (e) { console.error("[vela] onShow error:", e); }
+    }
+  }
+
+  function navigateBack(targetPath) {
+    if (activePage && typeof activePage.inst._def.onBackPress === "function") {
+      try {
+        if (activePage.inst._def.onBackPress.call(activePage.inst._vm) === true) return;
+      } catch (_) {}
+    }
+    if (pageStack.length <= 1) {
+      systemModules.app.terminate();
+      return;
+    }
+    const popped = pageStack.pop();
+    destroyPage(popped);
+
+    if (targetPath) {
+      while (pageStack.length > 1 && pageStack[pageStack.length - 1].routePath !== targetPath.replace(/^\/+/, "")) {
+        destroyPage(pageStack.pop());
+      }
+    }
+
+    activePage = pageStack[pageStack.length - 1];
+    activePage.dom.style.display = "flex";
+    if (typeof activePage.inst._def.onShow === "function") {
+      try { activePage.inst._def.onShow.call(activePage.inst._vm); } catch (_) {}
+    }
+  }
+
+  // Watch edge-swipe-right gesture -> back navigation
+  (function setupBackGesture() {
+    let startX = 0, startY = 0, tracking = false;
+    window.addEventListener("pointerdown", (e) => {
+      if (e.clientX <= 36) {
+        startX = e.clientX;
+        startY = e.clientY;
+        tracking = true;
+      }
+    }, { passive: true });
+    window.addEventListener("pointerup", (e) => {
+      if (!tracking) return;
+      tracking = false;
+      const dx = e.clientX - startX;
+      const dy = Math.abs(e.clientY - startY);
+      if (dx > 85 && dy < 70) {
+        navigateBack();
+      }
+    }, { passive: true });
+    onNativeEvent("system.back", () => navigateBack());
+  })();
+
+  // =========================================================================
+  // 10. Bootstrap
+  // =========================================================================
+  function showFatalError(title, detail) {
+    const el = document.getElementById("vela-error-banner");
+    if (!el) return;
+    el.innerHTML = `<div style="font-size:18px;font-weight:700">${title}</div>`
+      + `<div style="font-size:13px;color:rgba(255,255,255,0.7);line-height:1.45">${detail}</div>`
+      + `<button style="margin-top:10px;padding:8px 18px;border:none;border-radius:14px;background:#0d84ff;color:#fff;font-size:14px" onclick="window.__velaExit()">Back</button>`;
+    el.classList.add("visible");
+  }
+  window.__velaExit = () => systemModules.app.terminate();
+
+  async function bootstrap() {
+    try {
+      const resp = await window.fetch("vela://app/bundle.json");
+      APP_META = await resp.json();
+      APP_MANIFEST = APP_META.manifest || {};
+      APP_I18N = APP_META.i18n || {};
+
+      applyDesignWidthScale();
+
+      if (APP_META.mode === "rpk-jsc") {
+        showFatalError("Unsupported JSC Bytecode Package", APP_META.error || "Requires .ux source or non-JSC .rpk");
+        return;
+      }
+
+      if (APP_META.mode === "rpk-js") {
+        // Evaluate pre-built plain-JS app.js and entry page
+        const scripts = APP_META.scripts || {};
+        if (scripts["app.js"]) {
+          new Function(scripts["app.js"])();
+        }
+        const entry = APP_MANIFEST.router && APP_MANIFEST.router.entry;
+        const pageCfg = entry && APP_MANIFEST.router.pages && APP_MANIFEST.router.pages[entry];
+        const pageJs = entry && pageCfg ? `${entry}/${pageCfg.component || "index"}.js` : null;
+        if (pageJs && scripts[pageJs]) {
+          new Function(scripts[pageJs])();
+        } else {
+          showFatalError("Plain-JS RPK Loaded", "Entry page script not found: " + pageJs);
+        }
+        return;
+      }
+
+      // Instantiate app.ux
+      if (window.__VELA_BUNDLE__ && window.__VELA_BUNDLE__.components["app.ux"]) {
+        const mod = { exports: {} };
+        window.__VELA_BUNDLE__.components["app.ux"](createRequire("app.ux"), mod.exports, mod);
+        APP_DEF = (mod.exports && mod.exports.__esModule) ? mod.exports.default : (mod.exports.default || mod.exports);
+        APP_INSTANCE.$def = APP_DEF;
+        if (typeof APP_DEF.onCreate === "function") {
+          try { APP_DEF.onCreate.call(APP_DEF); } catch (e) { console.error("[vela] app.onCreate error:", e); }
+        }
+      }
+
+      // Navigate to entry page
+      const entryUri = APP_MANIFEST.router && APP_MANIFEST.router.entry;
+      if (!entryUri) {
+        showFatalError("Invalid Manifest", "Missing router.entry in manifest.json");
+        return;
+      }
+      navigateTo(entryUri, {}, false);
+    } catch (err) {
+      console.error("[vela] Bootstrap failed:", err);
+      showFatalError("Vela Runtime Error", String(err && err.stack ? err.message : err));
+    }
+  }
+
+  window.addEventListener("DOMContentLoaded", bootstrap);
+})();
