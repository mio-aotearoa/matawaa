diff --git a/overlay/asteroidos/vela/default.nix b/overlay/asteroidos/vela/default.nix
new file mode 100644
index 00000000..fc9430b5
--- /dev/null
+++ b/overlay/asteroidos/vela/default.nix
@@ -0,0 +1,97 @@
+# Xiaomi Vela QuickApp (.rpk / .ux) compatibility layer for AsteroidOS
+{
+  lib,
+  stdenv,
+  cmake,
+  pkg-config,
+  webkitgtk_6_0,
+  gtk4,
+  libsoup_3,
+  json-glib,
+  qrencode,
+  wrapGAppsHook4,
+  glib,
+  glib-networking,
+  python3,
+  buildPackages,
+}:
+
+let
+  velaRuntime = stdenv.mkDerivation {
+    pname = "asteroid-vela";
+    version = "1.0.0";
+
+    src = ./.;
+
+    strictDeps = true;
+
+    nativeBuildInputs = [
+      cmake
+      pkg-config
+      wrapGAppsHook4
+    ];
+
+    buildInputs = [
+      webkitgtk_6_0
+      gtk4
+      libsoup_3
+      json-glib
+      qrencode
+      glib
+      glib-networking
+      python3
+    ];
+
+    dontWrapGApps = false;
+
+    # Match the AsteroidOS watch WebKitGTK Wayland software rendering profile
+    # verified on Fossil Hoki, and expose `vela-compile` on PATH.
+    preFixup = ''
+      gappsWrapperArgs+=(--unset LD_PRELOAD --unset LD_LIBRARY_PATH)
+      gappsWrapperArgs+=(--set GDK_BACKEND wayland)
+      gappsWrapperArgs+=(--set GSK_RENDERER cairo)
+      gappsWrapperArgs+=(--set WEBKIT_DISABLE_DMABUF_RENDERER 1)
+      gappsWrapperArgs+=(--set WEBKIT_DISABLE_COMPOSITING_MODE 1)
+      gappsWrapperArgs+=(--set WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS 1)
+      gappsWrapperArgs+=(--prefix PATH : "$out/bin")
+    '';
+
+    passthru = {
+      # Helper to pre-compile a Xiaomi Vela QuickApp (.ux source or .rpk) at
+      # Nix build time and install it into $out/share/vela/apps/<package>/.
+      mkVelaApp =
+        {
+          pname,
+          version ? "1.0.0",
+          src,
+          packageName ? pname,
+          subDir ? "",
+          meta ? { },
+        }:
+        stdenv.mkDerivation {
+          inherit pname version src;
+          nativeBuildInputs = [ buildPackages.python3 ];
+          dontConfigure = true;
+          dontBuild = true;
+          installPhase = ''
+            runHook preInstall
+            appSrc="$PWD${lib.optionalString (subDir != "") "/${subDir}"}"
+            mkdir -p "$out/share/vela/apps/${packageName}"
+            ${buildPackages.python3}/bin/python3 ${./tools/vela-compile.py} \
+              "$appSrc" -o "$out/share/vela/apps/${packageName}"
+            runHook postInstall
+          '';
+          inherit meta;
+        };
+    };
+
+    meta = with lib; {
+      description = "Xiaomi Vela QuickApp (.rpk / .ux) compatibility layer for AsteroidOS";
+      homepage = "https://iot.mi.com/vela/quickapp/";
+      license = licenses.gpl3Plus;
+      platforms = platforms.linux;
+      mainProgram = "asteroid-vela";
+    };
+  };
+in
+velaRuntime
