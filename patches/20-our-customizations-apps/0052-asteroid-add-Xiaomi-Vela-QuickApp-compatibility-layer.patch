+<body>
+  <div id="vela-viewport"></div>
+  <div id="vela-toast"></div>
+  <div id="vela-dialog-backdrop">
+    <div class="vela-dialog-box">
+      <div class="vela-dialog-title" id="vela-dialog-title"></div>
+      <div class="vela-dialog-message" id="vela-dialog-message"></div>
+      <div class="vela-dialog-buttons" id="vela-dialog-buttons"></div>
