+/* ------------------------------------------------------------------------- */
+/* Bridge Handlers: Storage                                                  */
+/* ------------------------------------------------------------------------- */
+
+static JsonObject *load_storage_obj(VelaHost *host) {
+    gchar *dir = vela_pkg_data_dir(host);
+    gchar *path = g_build_filename(dir, "storage.json", NULL);
+    g_free(dir);
+    JsonObject *obj = NULL;
+    JsonParser *parser = json_parser_new();
+    if (json_parser_load_from_file(parser, path, NULL)) {
+        JsonNode *root = json_parser_get_root(parser);
+        if (root && JSON_NODE_HOLDS_OBJECT(root)) {
+            obj = json_object_ref(json_node_get_object(root));
+        }
+    }
+    g_object_unref(parser);
+    g_free(path);
+    return obj ? obj : json_object_new();
+}
+
+static void save_storage_obj(VelaHost *host, JsonObject *obj) {
+    gchar *dir = vela_pkg_data_dir(host);
+    gchar *path = g_build_filename(dir, "storage.json", NULL);
+    g_free(dir);
+    JsonNode *root = json_node_new(JSON_NODE_OBJECT);
+    json_node_set_object(root, obj);
+    gchar *str = json_node_to_string(root);
+    g_file_set_contents(path, str, -1, NULL);
+    g_free(str);
+    json_node_free(root);
+    g_free(path);
+}
+
+static void handle_storage(VelaHost *host, gint64 id, const gchar *method, JsonObject *params) {
+    JsonObject *store = load_storage_obj(host);
+    if (g_strcmp0(method, "storage.get") == 0) {
+        const gchar *k = json_object_get_string_member(params, "key");
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        gboolean found = k && json_object_has_member(store, k);
+        json_builder_set_member_name(b, "found");
+        json_builder_add_boolean_value(b, found);
+        if (found) {
+            json_builder_set_member_name(b, "value");
+            json_builder_add_string_value(b, json_object_get_string_member(store, k));
+        }
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "storage.set") == 0) {
+        const gchar *k = json_object_get_string_member(params, "key");
+        const gchar *v = json_object_get_string_member(params, "value");
+        if (k) {
+            json_object_set_string_member(store, k, v ? v : "");
+            save_storage_obj(host, store);
+        }
+        bridge_resolve(host, id, TRUE, NULL);
+    } else if (g_strcmp0(method, "storage.delete") == 0) {
+        const gchar *k = json_object_get_string_member(params, "key");
+        if (k) {
+            json_object_remove_member(store, k);
+            save_storage_obj(host, store);
+        }
+        bridge_resolve(host, id, TRUE, NULL);
+    } else if (g_strcmp0(method, "storage.clear") == 0) {
+        JsonObject *empty = json_object_new();
+        save_storage_obj(host, empty);
+        json_object_unref(empty);
+        bridge_resolve(host, id, TRUE, NULL);
+    }
+    json_object_unref(store);
+}
