@@ -0,0 +1,64 @@
+cmake_minimum_required(VERSION 3.16)
+project(asteroid-vela VERSION 1.0.0 LANGUAGES C)
+
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(WEBKIT REQUIRED IMPORTED_TARGET webkitgtk-6.0)
+pkg_check_modules(GTK4 REQUIRED IMPORTED_TARGET gtk4)
+pkg_check_modules(SOUP REQUIRED IMPORTED_TARGET libsoup-3.0)
+pkg_check_modules(JSONGLIB REQUIRED IMPORTED_TARGET json-glib-1.0)
+pkg_check_modules(QRENCODE REQUIRED IMPORTED_TARGET libqrencode)
+
+include(GNUInstallDirs)
+
+add_executable(asteroid-vela src/main.c)
+
+target_compile_definitions(asteroid-vela PRIVATE
+    VELA_DATADIR="${CMAKE_INSTALL_FULL_DATADIR}/asteroid-vela"
+)
+
+target_link_libraries(asteroid-vela PRIVATE
+    PkgConfig::WEBKIT
+    PkgConfig::GTK4
+    PkgConfig::SOUP
+    PkgConfig::JSONGLIB
+    PkgConfig::QRENCODE
+    m
+)
+
+install(TARGETS asteroid-vela
+    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
+)
+
+install(PROGRAMS tools/vela-compile.py
+    DESTINATION ${CMAKE_INSTALL_BINDIR}
+    RENAME vela-compile
+)
+
+install(DIRECTORY runtime/
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/asteroid-vela/runtime
+)
+
+install(FILES asteroid-vela.desktop
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/applications
+)
+
+install(FILES asteroid-vela.desktop
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/applications
+    RENAME org.asteroidos.vela.desktop
+)
+
+install(FILES asteroid-vela.svg
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps
+)
+
+install(FILES asteroid-vela.svg
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/asteroid
+)
+
+install(FILES asteroid-vela.svg
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps
+    RENAME org.asteroidos.vela.svg
+)
