+    // Built-in Vela tags -> HTML DOM elements
+    let el;
+    if (tag === "image" || tag === "img") {
+      el = document.createElement("img");
+      el.className = "vela-image";
+      el.draggable = false;
+    } else if (tag === "text") {
+      el = document.createElement("span");
+      el.className = "vela-text";
+    } else if (tag === "span") {
+      el = document.createElement("span");
+      el.className = "vela-span";
+    } else if (tag === "scroll") {
+      el = document.createElement("div");
+      el.className = "vela-scroll";
+    } else if (tag === "list") {
+      el = document.createElement("div");
+      el.className = "vela-list";
+    } else if (tag === "list-item") {
+      el = document.createElement("div");
+      el.className = "vela-list-item";
+    } else if (tag === "stack") {
+      el = document.createElement("div");
+      el.className = "vela-stack";
+    } else if (tag === "swiper") {
+      el = document.createElement("div");
+      el.className = "vela-swiper";
+    } else if (tag === "progress") {
+      el = document.createElement("div");
+      el.className = "vela-progress";
+      const bar = document.createElement("div");
+      bar.className = "vela-progress-bar";
+      const pct = Number(evalInterpolation(attrs.percent || "0", vm, locals)) || 0;
+      bar.style.width = Math.max(0, Math.min(100, pct)) + "%";
+      el.appendChild(bar);
+    } else if (tag === "slider") {
+      el = document.createElement("input");
+      el.type = "range";
+      el.className = "vela-slider";
+      if (attrs.min != null) el.min = String(evalInterpolation(attrs.min, vm, locals));
+      if (attrs.max != null) el.max = String(evalInterpolation(attrs.max, vm, locals));
+      if (attrs.step != null) el.step = String(evalInterpolation(attrs.step, vm, locals));
+      if (attrs.value != null) el.value = String(evalInterpolation(attrs.value, vm, locals));
+    } else if (tag === "switch") {
+      el = document.createElement("input");
+      el.type = "checkbox";
+      el.className = "vela-switch";
+      el.checked = Boolean(evalInterpolation(attrs.checked, vm, locals));
+    } else if (tag === "input") {
+      const itype = String(evalInterpolation(attrs.type || "text", vm, locals)).toLowerCase();
+      el = document.createElement("input");
+      el.type = itype === "button" ? "button" : itype === "checkbox" ? "checkbox" : itype === "radio" ? "radio" : "text";
+      el.className = itype === "button" ? "vela-input-button" : "vela-input-text";
+      if (attrs.value != null) el.value = String(evalInterpolation(attrs.value, vm, locals));
+      if (attrs.placeholder != null) el.placeholder = String(evalInterpolation(attrs.placeholder, vm, locals));
+      if (attrs.checked != null) el.checked = Boolean(evalInterpolation(attrs.checked, vm, locals));
+    } else if (tag === "marquee") {
+      el = document.createElement("div");
+      el.className = "vela-marquee";
+    } else if (tag === "qrcode") {
+      el = document.createElement("canvas");
+      el.className = "vela-qrcode";
+      el.width = 180;
+      el.height = 180;
+      const val = String(evalInterpolation(attrs.value || "", vm, locals) || "");
+      renderQrCanvas(el, val);
+    } else if (tag === "canvas") {
+      el = document.createElement("canvas");
+    } else if (tag === "a") {
+      el = document.createElement("a");
+      el.className = "vela-text";
+    } else {
+      el = document.createElement("div");
+      el.className = "vela-div";
+    }
+
+    if (scopeAttr) el.setAttribute(scopeAttr, "");
+
+    // Apply attributes
+    for (const [k, rawV] of Object.entries(attrs)) {
+      const val = evalInterpolation(rawV, vm, locals);
+      if (k === "class") {
+        const extra = String(val || "").trim();
+        if (extra) el.className = el.className ? el.className + " " + extra : extra;
+      } else if (k === "style") {
+        if (typeof val === "string") el.setAttribute("style", (el.getAttribute("style") || "") + ";" + val);
+        else if (val && typeof val === "object") Object.assign(el.style, val);
+      } else if (k === "id") {
+        const idStr = String(val || "");
+        el.id = idStr;
+        if (idStr) instance._elementMap.set(idStr, el);
+      } else if (k === "src" && (tag === "image" || tag === "img")) {
+        el.src = resolveAssetUrl(String(val || ""));
+      } else if (k === "scroll-y") {
+        el.setAttribute("data-scroll-y", String(Boolean(val && val !== "false")));
+      } else if (k === "scroll-x") {
+        el.setAttribute("data-scroll-x", String(Boolean(val && val !== "false")));
+      } else if (k === "disabled") {
+        el.disabled = Boolean(val && val !== "false");
+      } else if (k !== "type" && k !== "value" && k !== "percent" && k !== "checked") {
+        if (val !== undefined && val !== null) el.setAttribute(k, String(val));
+      }
+    }
+
+    // `show` directive
+    if ("show" in dir) {
+      const visible = evalInterpolation(dir.show, vm, locals);
+      if (!visible) el.style.display = "none";
+    }
+
+    // Bind events
+    for (const [evName, handlerExpr] of Object.entries(events)) {
+      if (evName === "longpress") {
+        let lpTimer = null;
+        const start = (e) => {
+          lpTimer = setTimeout(() => {
+            lpTimer = null;
+            invokeEventHandler(handlerExpr, vm, locals, e);
+          }, 500);
+        };
+        const cancel = () => {
+          if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; }
+        };
+        el.addEventListener("pointerdown", start);
+        el.addEventListener("pointerup", cancel);
+        el.addEventListener("pointercancel", cancel);
+        el.addEventListener("pointermove", cancel);
+      } else if (evName === "scroll") {
+        el.addEventListener("scroll", () => {
+          invokeEventHandler(handlerExpr, vm, locals, {
+            scrollX: el.scrollLeft,
+            scrollY: el.scrollTop,
+          });
+        });
+      } else if (evName === "scrollbottom") {
+        el.addEventListener("scroll", () => {
+          if (el.scrollTop + el.clientHeight >= el.scrollHeight - 12) {
+            invokeEventHandler(handlerExpr, vm, locals, {});
+          }
+        });
