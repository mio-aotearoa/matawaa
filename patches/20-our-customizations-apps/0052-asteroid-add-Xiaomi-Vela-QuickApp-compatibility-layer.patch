+  </div>
+  <div id="vela-error-banner"></div>
+  <script src="vela://app/bundle.js"></script>
+  <script src="vela://runtime/runtime.js"></script>
+</body>
+</html>
diff --git a/overlay/asteroidos/vela/runtime/vela-base.css b/overlay/asteroidos/vela/runtime/vela-base.css
new file mode 100644
index 00000000..a98160a1
--- /dev/null
+++ b/overlay/asteroidos/vela/runtime/vela-base.css
@@ -0,0 +1,319 @@
+/* Authentic Xiaomi Vela QuickApp Flexbox & Component Base Styles */
+*, *::before, *::after {
+  box-sizing: border-box;
+  -webkit-tap-highlight-color: transparent;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+html, body {
+  margin: 0;
+  padding: 0;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  background-color: #000000;
+  color: #ffffff;
+  font-family: "Noto Sans CJK SC", "Noto Sans", "DejaVu Sans", sans-serif;
+  touch-action: manipulation;
+}
+
+#vela-viewport {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  overflow: hidden;
+  background-color: #000000;
+  transform-origin: top left;
+}
+
+.vela-page {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  background-color: #000000;
+}
+
+/* Vela <div> defaults to display:flex; flex-direction:row */
+.vela-div {
+  display: flex;
+  flex-direction: row;
+  flex-shrink: 0;
+}
+
+.vela-text {
+  display: inline-block;
+  font-size: 24px;
+  color: #ffffff;
+  line-height: 1.3;
+  word-break: break-word;
+  white-space: pre-wrap;
+}
+
+.vela-span {
+  display: inline;
+}
+
+.vela-image {
+  display: block;
+  object-fit: cover;
+  flex-shrink: 0;
+}
+
