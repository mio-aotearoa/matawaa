+    if (raw.startsWith("{{") && raw.endsWith("}}")) raw = raw.slice(2, -2).trim();
+
+    let itemVar = "$item";
+    let idxVar = "$idx";
+    let listExpr = raw;
+
+    const m2 = raw.match(/^\(\s*([A-Za-z_$][\w$]*)\s*,\s*([A-Za-z_$][\w$]*)\s*\)\s+in\s+([\s\S]+)$/);
+    const m1 = raw.match(/^([A-Za-z_$][\w$]*)\s+in\s+([\s\S]+)$/);
+    if (m2) {
+      idxVar = m2[1];
+      itemVar = m2[2];
+      listExpr = m2[3];
+    } else if (m1) {
+      itemVar = m1[1];
+      listExpr = m1[2];
+    }
+
+    const listVal = evalExpr(listExpr, vm, locals);
+    if (!listVal) return;
+
+    const entries = Array.isArray(listVal)
+      ? listVal.map((v, k) => [k, v])
+      : typeof listVal === "number"
+        ? Array.from({ length: listVal }, (_, k) => [k, k])
+        : typeof listVal === "object"
+          ? Object.entries(listVal)
+          : [];
+
+    for (const [k, v] of entries) {
+      const childLocals = Object.assign({}, locals, {
+        $item: v,
+        $idx: k,
+        [itemVar]: v,
+        [idxVar]: k,
+      });
+      renderElement(node, parentDom, instance, childLocals, scopeAttr, true);
+    }
+  }
+
+  function renderElement(node, parentDom, instance, locals, scopeAttr, skipFor) {
+    const vm = instance._vm;
+    const tag = node.tag;
+    const attrs = node.attrs || {};
+    const events = node.events || {};
+    const dir = node.directives || {};
+
+    if (!skipFor && "for" in dir) {
+      renderForDirective(node, dir.for, parentDom, instance, locals, scopeAttr);
+      return;
+    }
+
+    // Transparent <block>
+    if (tag === "block") {
+      renderChildren(node.children || [], parentDom, instance, locals);
+      return;
+    }
+
+    // Custom component imported via <import name="..." src="...">
+    const importedCompId = instance._meta.imports && instance._meta.imports[tag];
+    if (importedCompId && APP_META.components[importedCompId]) {
+      const props = {};
+      for (const [k, v] of Object.entries(attrs)) {
+        props[k] = evalInterpolation(v, vm, locals);
+        // Also camelCase kebab props
+        if (k.includes("-")) {
