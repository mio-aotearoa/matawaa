+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
+  <title>Vela Apps</title>
+  <style>
+    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
+    html, body {
+      margin: 0; padding: 0; width: 100%; height: 100%;
+      background: #000; color: #fff;
+      font-family: "Noto Sans CJK SC", "Noto Sans", "DejaVu Sans", sans-serif;
+      overflow: hidden;
+    }
+    .root {
+      width: 100%; height: 100%;
+      display: flex; flex-direction: column;
+      padding: 28px 18px 20px;
+      overflow-y: auto;
+      scrollbar-width: none;
+    }
+    .root::-webkit-scrollbar { display: none; }
+    .hdr {
+      text-align: center;
+      margin-bottom: 14px;
+    }
+    .hdr-title {
+      font-size: 20px; font-weight: 700; letter-spacing: 0.4px;
+    }
+    .hdr-sub {
+      font-size: 12px; color: rgba(255,255,255,0.48); margin-top: 3px;
+    }
+    .grid {
+      display: flex; flex-direction: column; gap: 10px;
+      padding-bottom: 36px;
+    }
+    .card {
+      display: flex; flex-direction: row; align-items: center; gap: 12px;
+      background: #1e1e1e; border: 1px solid rgba(255,255,255,0.08);
+      border-radius: 18px; padding: 11px 14px; cursor: pointer;
+    }
+    .card:active { background: #2d2d2d; }
+    .icon {
+      width: 42px; height: 42px; border-radius: 12px;
+      background: #2e2e2e; object-fit: cover; flex-shrink: 0;
+      display: flex; align-items: center; justify-content: center;
+      font-size: 20px; font-weight: 700; color: #0d84ff;
+    }
+    .meta { flex: 1; min-width: 0; }
+    .name {
+      font-size: 16px; font-weight: 600; color: #fff;
+      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+    }
+    .pkg {
+      font-size: 11px; color: rgba(255,255,255,0.45);
+      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
+      margin-top: 2px;
+    }
+    .empty {
+      margin: auto; text-align: center; padding: 16px;
+      color: rgba(255,255,255,0.65); font-size: 14px; line-height: 1.5;
+    }
+    .empty code {
+      display: inline-block; margin-top: 8px; padding: 6px 10px;
+      border-radius: 10px; background: #1c1c1c; color: #7cc4ff;
+      font-size: 11px; word-break: break-all;
+    }
+  </style>
+</head>
+<body>
+  <div class="root">
+    <div class="hdr">
+      <div class="hdr-title">Vela Apps</div>
+      <div class="hdr-sub" id="status">Scanning installed apps...</div>
+    </div>
+    <div class="grid" id="grid"></div>
+  </div>
+  <script>
+    const pending = new Map();
+    let nextId = 1;
+    window.__velaBridgeResolve = (id, ok, val) => {
+      const p = pending.get(id);
+      if (!p) return;
+      pending.delete(id);
+      ok ? p.resolve(val) : p.reject(new Error(val));
+    };
+    function callNative(method, params) {
+      return new Promise((resolve, reject) => {
+        const id = nextId++;
+        pending.set(id, { resolve, reject });
+        window.webkit.messageHandlers.velaBridge.postMessage(JSON.stringify({ id, method, params: params || {} }));
+      });
+    }
+    async function load() {
+      const grid = document.getElementById("grid");
+      const status = document.getElementById("status");
+      try {
+        const res = await callNative("launcher.listApps", {});
+        const apps = (res && res.apps) || [];
+        if (!apps.length) {
+          status.textContent = "No Vela apps installed";
+          grid.innerHTML = `<div class="empty">
+            Install any Xiaomi Vela QuickApp (.rpk or .ux source):
+            <code>vela-compile --install /path/to/app</code>
+          </div>`;
+          return;
+        }
+        status.textContent = `${apps.length} app${apps.length === 1 ? "" : "s"} installed`;
+        grid.innerHTML = "";
+        for (const app of apps) {
+          const card = document.createElement("div");
+          card.className = "card";
+          const iconHtml = app.iconUrl
+            ? `<img class="icon" src="${app.iconUrl}" alt="" />`
+            : `<div class="icon">${(app.name || "V").slice(0, 1).toUpperCase()}</div>`;
+          card.innerHTML = `
+            ${iconHtml}
+            <div class="meta">
+              <div class="name">${app.name || app.package}</div>
+              <div class="pkg">${app.package} · v${app.versionName || "1.0"}</div>
+            </div>`;
+          card.addEventListener("click", () => {
+            callNative("launcher.launchApp", { path: app.path });
+          });
+          grid.appendChild(card);
+        }
+      } catch (e) {
+        status.textContent = "Failed to load apps";
+        grid.innerHTML = `<div class="empty">${String(e)}</div>`;
+      }
+    }
+    load();
+  </script>
+</body>
+</html>
diff --git a/overlay/asteroidos/vela/runtime/runtime.js b/overlay/asteroidos/vela/runtime/runtime.js
new file mode 100644
index 00000000..16da3225
--- /dev/null
+++ b/overlay/asteroidos/vela/runtime/runtime.js
@@ -0,0 +1,1884 @@
+/**
+ * Xiaomi Vela QuickApp Compatibility Runtime for AsteroidOS (Matawaa)
+ *
+ * Implements:
+ * - Native GTK4/WebKitGTK bridge (`window.webkit.messageHandlers.velaBridge`)
+ * - All 15 `@system.*` feature modules (router, prompt, vibrator, storage, file,
+ *   fetch, request, device, app, network, crypto, clipboard, audio, folme, interconnect)
+ * - CommonJS + QuickApp alias resolver + built-in shims (dayjs, semver)
+ * - `$app_define$` / `$app_bootstrap$` compatibility shim for plain-JS `.rpk` bundles
+ * - Reactive Proxy-based component engine (`data`/`public`/`protected`/`private`/
+ *   `props`/`computed`/`$watch`/`$emit`/`$on`/`$child`/`$element`/`$nextTick`/`$t`/`$app`)
+ * - Declarative Vela template renderer (`if`/`elif`/`else`, `show`, `for`, `tid`,
+ *   `{{ expr }}`, custom `<import>` components, built-in Vela widgets)
+ * - Touch / longpress / edge-swipe-back gesture handling & `designWidth` scaling
+ */
+(function () {
+  "use strict";
+
+  // =========================================================================
+  // 1. Native Bridge (JS <-> C WebKitGTK host)
+  // =========================================================================
+  const pendingCalls = new Map();
+  const bridgeListeners = new Map();
+  let nextBridgeId = 1;
+
+  window.__velaBridgeResolve = function (id, ok, result) {
+    const entry = pendingCalls.get(id);
+    if (!entry) return;
+    pendingCalls.delete(id);
+    if (ok) entry.resolve(result);
+    else entry.reject(new Error(typeof result === "string" ? result : JSON.stringify(result)));
+  };
+
+  window.__velaBridgeEvent = function (channel, payload) {
+    const list = bridgeListeners.get(channel);
+    if (!list) return;
+    for (const fn of list.slice()) {
+      try {
+        fn(payload);
+      } catch (e) {
+        console.error("[vela] bridge event handler error:", e);
+      }
+    }
+  };
+
+  function onNativeEvent(channel, fn) {
+    if (!bridgeListeners.has(channel)) bridgeListeners.set(channel, []);
+    bridgeListeners.get(channel).push(fn);
+    return () => {
+      const arr = bridgeListeners.get(channel);
+      if (!arr) return;
+      const idx = arr.indexOf(fn);
+      if (idx >= 0) arr.splice(idx, 1);
+    };
+  }
+
+  function hasNativeBridge() {
+    return !!(window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.velaBridge);
+  }
+
+  function callNative(method, params) {
+    if (!hasNativeBridge()) {
+      return Promise.reject(new Error("Native bridge unavailable: " + method));
+    }
+    return new Promise((resolve, reject) => {
+      const id = nextBridgeId++;
+      pendingCalls.set(id, { resolve, reject });
+      try {
+        window.webkit.messageHandlers.velaBridge.postMessage(
+          JSON.stringify({ id, method, params: params || {} })
+        );
+      } catch (err) {
+        pendingCalls.delete(id);
+        reject(err);
+      }
+    });
+  }
+
+  // Helper to invoke Vela's dual callback + Promise API pattern
+  function runVelaAsync(opts, promiseFactory) {
+    opts = opts || {};
+    return promiseFactory().then(
+      (res) => {
+        if (typeof opts.success === "function") opts.success(res);
+        if (typeof opts.complete === "function") opts.complete(res);
+        return res;
+      },
+      (err) => {
+        const msg = err && err.message ? err.message : String(err);
+        const code = (err && typeof err.code === "number") ? err.code : 200;
+        if (typeof opts.fail === "function") opts.fail(msg, code);
+        if (typeof opts.complete === "function") opts.complete();
+        if (typeof opts.fail !== "function") {
+          return Promise.reject(err);
+        }
+      }
+    );
+  }
+
+  // =========================================================================
+  // 2. Runtime Global State & Viewport Scaling
+  // =========================================================================
+  let APP_META = null;
+  let APP_MANIFEST = {};
+  let APP_I18N = {};
+  let APP_DEF = {};
+  let APP_INSTANCE = {
+    $def: APP_DEF,
+    exit() {
+      systemModules.app.terminate();
+    },
+  };
+
+  const pageStack = [];
+  let activePage = null;
+
+  // Expose Node-like `global` alias expected by some Vela apps (e.g. HyperBilibili)
+  if (typeof window.global === "undefined") {
+    window.global = window;
+  }
+
+  function applyDesignWidthScale() {
+    const vp = document.getElementById("vela-viewport");
+    if (!vp) return;
+    const dwRaw = APP_MANIFEST && APP_MANIFEST.config && APP_MANIFEST.config.designWidth;
+    const winW = window.innerWidth || 416;
+    const winH = window.innerHeight || 416;
+    const dw = typeof dwRaw === "number" && dwRaw > 0 ? dwRaw : winW;
+    const scale = winW / dw;
+    vp.style.width = dw + "px";
+    vp.style.height = Math.round(winH / scale) + "px";
+    vp.style.transform = `scale(${scale})`;
+    document.documentElement.style.setProperty("--vela-scale", String(scale));
+    document.documentElement.style.setProperty("--vela-design-width", dw + "px");
+  }
+  window.addEventListener("resize", applyDesignWidthScale);
+
+  // =========================================================================
+  // 3. Asset & URI Resolution
+  // =========================================================================
+  function resolveAssetUrl(src) {
+    if (!src || typeof src !== "string") return "";
+    if (/^(https?:|data:|blob:|vela:)/i.test(src)) return src;
+    if (src.startsWith("internal://")) {
+      return "vela://internal/" + src.slice("internal://".length);
+    }
+    const clean = src.replace(/^\/+/, "");
+    return "vela://app/assets/" + clean;
+  }
+
+  // =========================================================================
+  // 4. Built-in `@system.*` Feature Modules
+  // =========================================================================
+  let toastTimer = null;
+  function showToastUI(message, duration) {
+    const el = document.getElementById("vela-toast");
+    if (!el) return;
+    el.textContent = String(message == null ? "" : message);
+    el.classList.add("visible");
+    if (toastTimer) clearTimeout(toastTimer);
+    const ms = duration === 1 || duration === "long" ? 3500 : 1800;
+    toastTimer = setTimeout(() => el.classList.remove("visible"), ms);
+  }
+
+  function showDialogUI(opts) {
+    opts = opts || {};
+    const backdrop = document.getElementById("vela-dialog-backdrop");
+    const titleEl = document.getElementById("vela-dialog-title");
+    const msgEl = document.getElementById("vela-dialog-message");
+    const btnsEl = document.getElementById("vela-dialog-buttons");
+    if (!backdrop) return;
+
+    titleEl.textContent = opts.title || "";
+    titleEl.style.display = opts.title ? "block" : "none";
+    msgEl.textContent = opts.message || "";
+    btnsEl.innerHTML = "";
+
