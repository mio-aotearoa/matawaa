diff --git a/overlay/asteroidos/vela/src/main.c b/overlay/asteroidos/vela/src/main.c
new file mode 100644
index 00000000..c28a467c
--- /dev/null
+++ b/overlay/asteroidos/vela/src/main.c
@@ -0,0 +1,1261 @@
+/*
+ * AsteroidOS Xiaomi Vela QuickApp Compatibility Layer Host (asteroid-vela)
+ *
+ * Native GTK4 + WebKitGTK 6.0 + libsoup 3.0 + json-glib host providing:
+ * - Custom `vela://` URI scheme (runtime assets, app bundles, internal:// sandbox)
+ * - CORS-free `@system.fetch` and `@system.request.download` via libsoup-3.0
+ * - Persistent `@system.storage` and sandboxed `@system.file`
+ * - Native `@system.vibrator` (ngfd D-Bus + sysfs fallback), `@system.device`,
+ *   `@system.clipboard`, `@system.crypto` (GLib GChecksum/GHmac), `@system.network`,
+ *   and `@system.interconnect` (WebSocket bridge via libsoup-3.0)
+ * - Built-in Vela App Launcher UI + direct CLI app launching
+ */
+
+#include <errno.h>
+#include <gio/gio.h>
+#include <glib/gstdio.h>
+#include <gtk/gtk.h>
+#include <json-glib/json-glib.h>
+#include <libsoup/soup.h>
+#include <qrencode.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <webkit/webkit.h>
+
+#ifndef VELA_DATADIR
+#define VELA_DATADIR "/usr/share/asteroid-vela"
+#endif
+
+typedef struct {
+    GtkApplication *gtk_app;
+    GtkWidget *window;
+    WebKitWebView *webview;
+    SoupSession *soup;
+    SoupWebsocketConnection *ws_conn;
+    gboolean ws_connected;
+    gchar *runtime_dir;
+    gchar *compiler_bin;
+    gchar *cli_target;
+    gboolean launched_from_cli;
+    gchar *active_bundle_dir;
+    gchar *active_package;
+    GHashTable *launcher_icon_dirs; /* pkg -> bundle_dir */
+} VelaHost;
+
+/* ------------------------------------------------------------------------- */
+/* Helpers                                                                   */
+/* ------------------------------------------------------------------------- */
+
+static gchar *vela_data_root(void) {
+    const gchar *xdg = g_get_user_data_dir();
+    gchar *dir = g_build_filename(xdg, "asteroid-vela", NULL);
+    g_mkdir_with_parents(dir, 0755);
+    return dir;
+}
+
+static gchar *vela_cache_root(void) {
+    const gchar *xdg = g_get_user_cache_dir();
+    gchar *dir = g_build_filename(xdg, "asteroid-vela", NULL);
+    g_mkdir_with_parents(dir, 0755);
+    return dir;
+}
+
+static gchar *vela_pkg_data_dir(VelaHost *host) {
+    gchar *root = vela_data_root();
+    const gchar *pkg = (host->active_package && *host->active_package) ? host->active_package : "default";
+    gchar *dir = g_build_filename(root, "data", pkg, NULL);
+    g_free(root);
+    g_mkdir_with_parents(dir, 0755);
+    return dir;
+}
+
+static gboolean is_safe_rel_path(const gchar *rel) {
+    if (!rel || !*rel) return FALSE;
+    if (rel[0] == '/') return FALSE;
+    gchar **parts = g_strsplit(rel, "/", -1);
+    gboolean ok = TRUE;
+    for (int i = 0; parts[i] != NULL; i++) {
+        if (g_strcmp0(parts[i], "..") == 0) {
+            ok = FALSE;
+            break;
+        }
+    }
+    g_strfreev(parts);
+    return ok;
+}
+
+/* Resolve `internal://files/foo` -> `~/.local/share/asteroid-vela/data/<pkg>/files/foo` */
+static gchar *resolve_internal_uri(VelaHost *host, const gchar *uri) {
+    if (!uri || !g_str_has_prefix(uri, "internal://")) return NULL;
+    const gchar *rest = uri + strlen("internal://");
+    const gchar *slash = strchr(rest, '/');
+    gchar *area = slash ? g_strndup(rest, slash - rest) : g_strdup(rest);
+    const gchar *sub = slash ? slash + 1 : "";
+
+    if (g_strcmp0(area, "files") != 0 && g_strcmp0(area, "cache") != 0 && g_strcmp0(area, "mass") != 0) {
+        g_free(area);
+        return NULL;
+    }
+    if (*sub && !is_safe_rel_path(sub)) {
+        g_free(area);
+        return NULL;
+    }
+
+    gchar *pkg_dir = vela_pkg_data_dir(host);
+    gchar *area_dir = g_build_filename(pkg_dir, area, NULL);
+    g_mkdir_with_parents(area_dir, 0755);
+    gchar *full = (*sub) ? g_build_filename(area_dir, sub, NULL) : g_strdup(area_dir);
+    g_free(area_dir);
+    g_free(pkg_dir);
+    g_free(area);
+    return full;
+}
+
+static const gchar *guess_mime(const gchar *path) {
+    if (g_str_has_suffix(path, ".html")) return "text/html; charset=utf-8";
+    if (g_str_has_suffix(path, ".js")) return "application/javascript; charset=utf-8";
+    if (g_str_has_suffix(path, ".css")) return "text/css; charset=utf-8";
+    if (g_str_has_suffix(path, ".json")) return "application/json; charset=utf-8";
+    if (g_str_has_suffix(path, ".svg")) return "image/svg+xml";
+    if (g_str_has_suffix(path, ".png")) return "image/png";
+    if (g_str_has_suffix(path, ".jpg") || g_str_has_suffix(path, ".jpeg")) return "image/jpeg";
+    if (g_str_has_suffix(path, ".gif")) return "image/gif";
+    if (g_str_has_suffix(path, ".webp")) return "image/webp";
+    if (g_str_has_suffix(path, ".ttf")) return "font/ttf";
+    if (g_str_has_suffix(path, ".otf")) return "font/otf";
+    if (g_str_has_suffix(path, ".woff2")) return "font/woff2";
+    if (g_str_has_suffix(path, ".mp3")) return "audio/mpeg";
+    if (g_str_has_suffix(path, ".wav")) return "audio/wav";
+    if (g_str_has_suffix(path, ".txt")) return "text/plain; charset=utf-8";
+    return "application/octet-stream";
+}
+
+static gchar *json_node_to_string(JsonNode *node) {
+    JsonGenerator *gen = json_generator_new();
+    json_generator_set_root(gen, node);
+    gchar *str = json_generator_to_data(gen, NULL);
+    g_object_unref(gen);
+    return str;
+}
+
+static void bridge_resolve(VelaHost *host, gint64 id, gboolean ok, JsonNode *result_node) {
+    if (!host->webview) return;
+    gchar *payload = result_node ? json_node_to_string(result_node) : g_strdup("null");
+    gchar *js = g_strdup_printf("window.__velaBridgeResolve && window.__velaBridgeResolve(%" G_GINT64_FORMAT ", %s, %s);",
+                                id, ok ? "true" : "false", payload);
+    webkit_web_view_evaluate_javascript(host->webview, js, -1, NULL, NULL, NULL, NULL, NULL);
+    g_free(js);
+    g_free(payload);
+}
+
+static void bridge_resolve_err(VelaHost *host, gint64 id, const gchar *msg) {
+    JsonNode *n = json_node_new(JSON_NODE_VALUE);
+    json_node_set_string(n, msg ? msg : "error");
+    bridge_resolve(host, id, FALSE, n);
+    json_node_free(n);
+}
+
+static void bridge_emit_event(VelaHost *host, const gchar *channel, JsonNode *payload_node) {
+    if (!host->webview) return;
+    gchar *payload = payload_node ? json_node_to_string(payload_node) : g_strdup("{}");
+    gchar *js = g_strdup_printf("window.__velaBridgeEvent && window.__velaBridgeEvent(\"%s\", %s);",
+                                channel, payload);
+    webkit_web_view_evaluate_javascript(host->webview, js, -1, NULL, NULL, NULL, NULL, NULL);
+    g_free(js);
+    g_free(payload);
+}
+
+/* ------------------------------------------------------------------------- */
+/* App Compilation & Activation                                              */
+/* ------------------------------------------------------------------------- */
+
+static gchar *read_bundle_package_name(const gchar *bundle_dir) {
+    gchar *bjson = g_build_filename(bundle_dir, "bundle.json", NULL);
+    gchar *pkg = NULL;
+    JsonParser *parser = json_parser_new();
+    if (json_parser_load_from_file(parser, bjson, NULL)) {
+        JsonObject *root = json_node_get_object(json_parser_get_root(parser));
+        if (root && json_object_has_member(root, "manifest")) {
+            JsonObject *man = json_object_get_object_member(root, "manifest");
+            if (man && json_object_has_member(man, "package")) {
+                pkg = g_strdup(json_object_get_string_member(man, "package"));
+            }
+        }
+    }
+    g_object_unref(parser);
+    g_free(bjson);
+    return pkg ? pkg : g_strdup("unknown.vela.app");
+}
+
+static gboolean activate_app_path(VelaHost *host, const gchar *path, GError **err) {
+    gchar *bundle_dir = NULL;
+    gchar *bjson_check = g_build_filename(path, "bundle.json", NULL);
+
+    if (g_file_test(bjson_check, G_FILE_TEST_IS_REGULAR)) {
+        bundle_dir = g_strdup(path);
+    } else {
+        /* Compile raw .ux directory or .rpk archive into cache */
+        gchar *cache = vela_cache_root();
+        gchar *hash = g_compute_checksum_for_string(G_CHECKSUM_SHA1, path, -1);
+        bundle_dir = g_build_filename(cache, hash, NULL);
+        g_free(hash);
+        g_free(cache);
+
+        gchar *argv[] = {
+            host->compiler_bin,
+            (gchar *)path,
+            "-o",
+            bundle_dir,
+            NULL
+        };
+        gchar *out = NULL, *err_out = NULL;
+        gint status = 0;
+        gboolean ok = g_spawn_sync(NULL, argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, &out, &err_out, &status, err);
+        g_free(out);
+        if (!ok || status != 0) {
+            if (err && !*err) {
+                g_set_error(err, G_IO_ERROR, G_IO_ERROR_FAILED, "vela-compile failed: %s",
+                            err_out ? err_out : "unknown error");
+            }
+            g_free(err_out);
+            g_free(bundle_dir);
+            g_free(bjson_check);
+            return FALSE;
+        }
+        g_free(err_out);
+    }
+    g_free(bjson_check);
+
+    g_free(host->active_bundle_dir);
+    host->active_bundle_dir = bundle_dir;
+    g_free(host->active_package);
+    host->active_package = read_bundle_package_name(bundle_dir);
+
+    webkit_web_view_load_uri(host->webview, "vela://runtime/shell.html");
+    return TRUE;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Custom `vela://` URI Scheme Handler                                       */
+/* ------------------------------------------------------------------------- */
+
+static void send_file_to_scheme_request(WebKitURISchemeRequest *req, const gchar *file_path) {
+    GError *err = NULL;
+    gchar *contents = NULL;
+    gsize len = 0;
+    if (!g_file_get_contents(file_path, &contents, &len, &err)) {
+        webkit_uri_scheme_request_finish_error(req, err);
+        g_error_free(err);
+        return;
+    }
+    GInputStream *stream = g_memory_input_stream_new_from_data(contents, len, g_free);
+    webkit_uri_scheme_request_finish(req, stream, len, guess_mime(file_path));
+    g_object_unref(stream);
+}
+
+static void on_vela_uri_scheme(WebKitURISchemeRequest *req, gpointer user_data) {
+    VelaHost *host = (VelaHost *)user_data;
+    const gchar *uri = webkit_uri_scheme_request_get_uri(req);
+
+    /* Strip query/fragment */
+    gchar *clean_uri = g_strdup(uri);
+    gchar *q = strpbrk(clean_uri, "?#");
+    if (q) *q = '\0';
+
+    if (g_str_has_prefix(clean_uri, "vela://runtime/")) {
+        const gchar *rel = clean_uri + strlen("vela://runtime/");
+        if (!is_safe_rel_path(rel)) {
+            GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Invalid path");
+            webkit_uri_scheme_request_finish_error(req, err);
+            g_error_free(err);
+        } else {
+            gchar *full = g_build_filename(host->runtime_dir, rel, NULL);
+            send_file_to_scheme_request(req, full);
+            g_free(full);
+        }
+    } else if (g_str_has_prefix(clean_uri, "vela://app/")) {
+        const gchar *rel = clean_uri + strlen("vela://app/");
+        if (!host->active_bundle_dir || !is_safe_rel_path(rel)) {
+            GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "App file not found");
+            webkit_uri_scheme_request_finish_error(req, err);
+            g_error_free(err);
+        } else {
+            gchar *full = g_build_filename(host->active_bundle_dir, rel, NULL);
+            send_file_to_scheme_request(req, full);
+            g_free(full);
+        }
+    } else if (g_str_has_prefix(clean_uri, "vela://internal/")) {
+        const gchar *rest = clean_uri + strlen("vela://internal/");
+        gchar *internal_uri = g_strdup_printf("internal://%s", rest);
+        gchar *full = resolve_internal_uri(host, internal_uri);
+        g_free(internal_uri);
+        if (!full) {
+            GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, "Invalid internal path");
+            webkit_uri_scheme_request_finish_error(req, err);
+            g_error_free(err);
+        } else {
+            send_file_to_scheme_request(req, full);
+            g_free(full);
+        }
+    } else if (g_str_has_prefix(clean_uri, "vela://app-icon/")) {
+        const gchar *rest = clean_uri + strlen("vela://app-icon/");
+        const gchar *slash = strchr(rest, '/');
+        if (!slash) {
+            GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Invalid icon URI");
+            webkit_uri_scheme_request_finish_error(req, err);
+            g_error_free(err);
+        } else {
+            gchar *pkg = g_strndup(rest, slash - rest);
+            const gchar *rel = slash + 1;
+            const gchar *dir = g_hash_table_lookup(host->launcher_icon_dirs, pkg);
+            if (!dir || !is_safe_rel_path(rel)) {
+                GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Icon not found");
+                webkit_uri_scheme_request_finish_error(req, err);
+                g_error_free(err);
+            } else {
+                gchar *full = g_build_filename(dir, "assets", rel, NULL);
+                send_file_to_scheme_request(req, full);
+                g_free(full);
+            }
+            g_free(pkg);
+        }
+    } else {
+        GError *err = g_error_new_literal(G_IO_ERROR, G_IO_ERROR_NOT_FOUND, "Unknown vela:// URI");
+        webkit_uri_scheme_request_finish_error(req, err);
+        g_error_free(err);
+    }
+
+    g_free(clean_uri);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Bridge Handlers: HTTP Fetch & Download (libsoup-3.0)                      */
+/* ------------------------------------------------------------------------- */
+
+typedef struct {
+    VelaHost *host;
+    gint64 id;
+    SoupMessage *msg;
+    gboolean is_download;
+    gchar *download_path;
+    gchar *download_uri;
+} HttpCallCtx;
+
+static void on_http_finished(GObject *source, GAsyncResult *res, gpointer user_data) {
+    HttpCallCtx *ctx = (HttpCallCtx *)user_data;
+    GError *err = NULL;
+    GBytes *bytes = soup_session_send_and_read_finish(SOUP_SESSION(source), res, &err);
+    if (err) {
+        bridge_resolve_err(ctx->host, ctx->id, err->message);
+        g_error_free(err);
+    } else {
+        guint status = soup_message_get_status(ctx->msg);
+        gsize len = 0;
+        const gchar *data = g_bytes_get_data(bytes, &len);
+
+        if (ctx->is_download) {
+            GError *werr = NULL;
+            if (!g_file_set_contents(ctx->download_path, data ? data : "", len, &werr)) {
+                bridge_resolve_err(ctx->host, ctx->id, werr->message);
+                g_error_free(werr);
+            } else {
+                JsonBuilder *b = json_builder_new();
+                json_builder_begin_object(b);
+                gchar *tok = g_strdup_printf("dl_%" G_GINT64_FORMAT, ctx->id);
+                json_builder_set_member_name(b, "token");
+                json_builder_add_string_value(b, tok);
+                json_builder_set_member_name(b, "uri");
+                json_builder_add_string_value(b, ctx->download_uri);
+                json_builder_set_member_name(b, "code");
+                json_builder_add_int_value(b, status);
+                json_builder_end_object(b);
+                JsonNode *root = json_builder_get_root(b);
+                bridge_resolve(ctx->host, ctx->id, TRUE, root);
+                json_node_free(root);
+                g_object_unref(b);
+                g_free(tok);
+            }
+        } else {
+            gchar *str_data = g_strndup(data ? data : "", len);
+            JsonBuilder *b = json_builder_new();
+            json_builder_begin_object(b);
+            json_builder_set_member_name(b, "code");
+            json_builder_add_int_value(b, status);
+            json_builder_set_member_name(b, "data");
+            json_builder_add_string_value(b, str_data);
+            json_builder_set_member_name(b, "headers");
+            json_builder_begin_object(b);
+            SoupMessageHeaders *rh = soup_message_get_response_headers(ctx->msg);
+            SoupMessageHeadersIter iter;
+            const gchar *hk, *hv;
+            soup_message_headers_iter_init(&iter, rh);
+            while (soup_message_headers_iter_next(&iter, &hk, &hv)) {
+                json_builder_set_member_name(b, hk);
+                json_builder_add_string_value(b, hv);
+            }
+            json_builder_end_object(b);
+            json_builder_end_object(b);
+            JsonNode *root = json_builder_get_root(b);
+            bridge_resolve(ctx->host, ctx->id, TRUE, root);
+            json_node_free(root);
+            g_object_unref(b);
+            g_free(str_data);
+        }
+        g_bytes_unref(bytes);
+    }
+    g_object_unref(ctx->msg);
+    g_free(ctx->download_path);
+    g_free(ctx->download_uri);
+    g_free(ctx);
+}
+
+static void handle_http_request(VelaHost *host, gint64 id, JsonObject *params, gboolean is_download) {
+    const gchar *url = json_object_has_member(params, "url") ? json_object_get_string_member(params, "url") : "";
+    const gchar *method = (!is_download && json_object_has_member(params, "method"))
+                              ? json_object_get_string_member(params, "method")
+                              : "GET";
+    SoupMessage *msg = soup_message_new(method, url);
+    if (!msg) {
+        bridge_resolve_err(host, id, "Invalid URL");
+        return;
+    }
+
+    SoupMessageHeaders *req_headers = soup_message_get_request_headers(msg);
+    const gchar *content_type = "application/json";
+    if (json_object_has_member(params, "headers")) {
+        JsonObject *hdrs = json_object_get_object_member(params, "headers");
+        GList *keys = json_object_get_members(hdrs);
+        for (GList *l = keys; l != NULL; l = l->next) {
+            const gchar *k = (const gchar *)l->data;
+            const gchar *v = json_object_get_string_member(hdrs, k);
+            if (k && v) {
+                if (g_ascii_strcasecmp(k, "Content-Type") == 0) content_type = v;
+                soup_message_headers_replace(req_headers, k, v);
+            }
+        }
+        g_list_free(keys);
+    }
+
+    if (!is_download && json_object_has_member(params, "body")) {
+        const gchar *body = json_object_get_string_member(params, "body");
+        if (body && *body) {
+            GBytes *b = g_bytes_new(body, strlen(body));
+            soup_message_set_request_body_from_bytes(msg, content_type, b);
+            g_bytes_unref(b);
+        }
+    }
+
+    HttpCallCtx *ctx = g_new0(HttpCallCtx, 1);
+    ctx->host = host;
+    ctx->id = id;
+    ctx->msg = msg;
+    ctx->is_download = is_download;
+
+    if (is_download) {
+        const gchar *fn = json_object_has_member(params, "filename")
+                              ? json_object_get_string_member(params, "filename")
+                              : "";
+        gchar *safe_fn = (fn && *fn && is_safe_rel_path(fn))
+                             ? g_strdup(fn)
+                             : g_strdup_printf("dl_%" G_GINT64_FORMAT ".bin", id);
+        ctx->download_uri = g_strdup_printf("internal://cache/%s", safe_fn);
+        ctx->download_path = resolve_internal_uri(host, ctx->download_uri);
+        gchar *parent = g_path_get_dirname(ctx->download_path);
+        g_mkdir_with_parents(parent, 0755);
+        g_free(parent);
+        g_free(safe_fn);
+    }
+
+    soup_session_send_and_read_async(host->soup, msg, G_PRIORITY_DEFAULT, NULL, on_http_finished, ctx);
+}
