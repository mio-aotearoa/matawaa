+#!/usr/bin/env python3
+"""
+Vela QuickApp (.ux source / .rpk package) compiler and bundler for AsteroidOS.
+
+Compiles a Xiaomi Vela QuickApp project directory (containing manifest.json or
+src/manifest.json) or an .rpk ZIP archive into a self-contained runtime bundle
+directory consumable by `asteroid-vela`.
+
+Zero external Python dependencies (pure Python 3 standard library).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import html.parser
+import json
+import os
+import re
+import shutil
+import sys
+import zipfile
+from pathlib import Path
+from typing import Any
+
+
+# ---------------------------------------------------------------------------
+# Helpers
+# ---------------------------------------------------------------------------
+
+def sha1_short(text: str) -> str:
+    return hashlib.sha1(text.encode("utf-8")).hexdigest()[:8]
+
+
+def posix_norm(path: str) -> str:
+    parts: list[str] = []
+    for part in path.replace("\\", "/").split("/"):
+        if not part or part == ".":
+            continue
+        if part == "..":
+            if parts:
+                parts.pop()
+        else:
+            parts.append(part)
+    return "/".join(parts)
+
+
+# ---------------------------------------------------------------------------
+# Light-weight TypeScript type-annotation stripper (handles real Vela TS apps)
+# ---------------------------------------------------------------------------
+
+def strip_typescript(code: str) -> str:
+    """
+    Strip TypeScript-only syntax (interfaces, type aliases, type annotations,
+    `as Type`, `import type`, access modifiers, generic call/decl params) while
+    preserving string literals, template literals, regexes, and comments.
+    """
+    # 1. Remove `import type ...;` lines
+    code = re.sub(r"^\s*import\s+type\b[^;\n]*;?\s*$", "", code, flags=re.M)
+    # 2. Remove `export type { ... };` lines
+    code = re.sub(r"^\s*export\s+type\s*\{[^}]*\}\s*(?:from\s*['\"][^'\"]+['\"])?\s*;?\s*$", "", code, flags=re.M)
+
+    # 3. Remove `interface Foo { ... }` and `export interface Foo extends Bar { ... }`
+    #    using balanced brace scanning
+    def remove_brace_blocks(src: str, keyword_pat: str) -> str:
+        out = []
+        i = 0
+        n = len(src)
+        pat = re.compile(keyword_pat, re.M)
+        while i < n:
+            m = pat.search(src, i)
+            if not m:
+                out.append(src[i:])
+                break
+            out.append(src[i:m.start()])
+            # find opening '{'
+            j = m.end()
+            while j < n and src[j] != "{":
+                j += 1
+            if j >= n:
+                break
+            depth = 0
+            in_str = None
+            while j < n:
+                ch = src[j]
+                if in_str:
+                    if ch == "\\" and j + 1 < n:
+                        j += 2
+                        continue
+                    if ch == in_str:
+                        in_str = None
+                else:
+                    if ch in ("'", '"', "`"):
+                        in_str = ch
+                    elif ch == "{":
+                        depth += 1
+                    elif ch == "}":
+                        depth -= 1
+                        if depth == 0:
+                            j += 1
+                            break
+                j += 1
+            i = j
+        return "".join(out)
+
+    code = remove_brace_blocks(
+        code,
+        r"(?:^|\n)[ \t]*declare\s+(?:var|let|const|global|module|namespace)\b[^;{\n]*(?=\{)",
+    )
+    code = re.sub(r"^\s*declare\s+(?:var|let|const|function|class)\b[^;\n]*;?\s*$", "", code, flags=re.M)
+    code = remove_brace_blocks(
+        code,
+        r"(?:^|\n)[ \t]*(?:export\s+)?(?:declare\s+)?interface\s+[A-Za-z_$][\w$]*(?:<[^>]*>)?(?:\s+extends\s+[^{]+)?\s*(?=\{)",
+    )
+    # Remove single/multi-line `type Foo = ...;` (simple or object type)
+    code = remove_brace_blocks(
+        code,
+        r"(?:^|\n)[ \t]*(?:export\s+)?type\s+[A-Za-z_$][\w$]*(?:<[^>]*>)?\s*=\s*(?=\{)",
+    )
+    code = re.sub(
+        r"(?:^|\n)[ \t]*(?:export\s+)?type\s+[A-Za-z_$][\w$]*(?:<[^>]*>)?\s*=[^;\n]+;?",
+        "\n",
+        code,
+    )
+
+    # 4. Convert simple `enum Foo { A = 1, B = "x" }` into JS object
+    def replace_enum(m: re.Match) -> str:
+        exp = m.group(1) or ""
+        name = m.group(2)
+        body = m.group(3)
+        entries = []
+        auto_val = 0
+        for raw_item in body.split(","):
+            item = re.sub(r"//.*", "", raw_item).strip()
+            if not item:
+                continue
+            if "=" in item:
+                k, v = item.split("=", 1)
+                k = k.strip()
+                v = v.strip()
+                entries.append(f"{k}: {v}")
+                if v.isdigit():
+                    auto_val = int(v) + 1
+            else:
+                entries.append(f"{item}: {auto_val}")
+                auto_val += 1
+        return f"{exp}const {name} = {{ " + ", ".join(entries) + " };"
+
+    code = re.sub(
+        r"(export\s+)?(?:const\s+)?enum\s+([A-Za-z_$][\w$]*)\s*\{([^}]*)\}",
+        replace_enum,
+        code,
+    )
+
+    # 5. Strip access modifiers in class properties/methods: public/private/protected/readonly/abstract
+    code = re.sub(r"\babstract\s+class\b", "class", code)
+    code = re.sub(r"(?m)^[ \t]*(?:public|private|protected)?\s*abstract\s+[^;{\n]+;\s*$", "", code)
+    code = re.sub(
+        r"(?<=[\n;{])[ \t]*(?:public|private|protected)\s+(?:readonly\s+)?(?=(?:static\s+|async\s+)?[A-Za-z_$#])",
+        "",
+        code,
+    )
+    code = re.sub(
+        r"(?<=[\n;{])[ \t]*readonly\s+(?=[A-Za-z_$#])",
+        "",
+        code,
+    )
+
+    # 6. Strip `implements Foo, Bar` on classes
+    code = re.sub(r"\bimplements\s+[A-Za-z_$][\w$.,\s<>]*(?=\{)", "", code)
+
+    # 7. Strip type annotations on function parameters, variables, return types, `as Type`
+    #    Be careful not to touch strings or comments!
+    type_atom = r"(?:(?:[A-Za-z_$][\w$.]*(?:<[^<>()]*(?:<[^<>()]*>[^<>()]*)?>)?|\{[^{}]*\}|\[[^\[\]]*\]|\([^()]*\)|'[^']*'|\"[^\"]*\")(?:\[\])*)"
+    type_expr = rf"{type_atom}(?:\s*[|&]\s*{type_atom})*"
+
+    # Function return type: `): ReturnType {` or `): ReturnType =>`
+    code = re.sub(
+        rf"\)\s*:\s*{type_expr}\s*(?=\{{|=>)",
+        ") ",
+        code,
+    )
+    # Parameter type annotations inside (...) : `(a: string, b?: { value: string } = 1)`
+    # Balanced-delimiter scanner so inline object/tuple/fn types inside param lists work!
+    def strip_balanced_params(src: str) -> str:
+        out = []
+        i = 0
+        n = len(src)
+        sig_re = re.compile(
+            r"(\bfunction\s+[A-Za-z_$][\w$]*|\bfunction|\basync\s+[A-Za-z_$][\w$]*|\basync|\bconstructor|\b[A-Za-z_$][\w$]*|[=,:(\[?])\s*\("
+        )
+        while i < n:
+            m = sig_re.search(src, i)
+            if not m:
+                out.append(src[i:])
+                break
+            kw = m.group(1).strip()
+            if kw in ("if", "for", "while", "switch", "catch", "return", "typeof", "delete", "void", "new", "throw", "case"):
+                out.append(src[i:m.end()])
+                i = m.end()
+                continue
+            # Find matching ')'
+            p_start = m.end() - 1
+            depth = 1
+            j = m.end()
+            in_str = None
+            while j < n and depth > 0:
+                ch = src[j]
+                if in_str:
+                    if ch == "\\" and j + 1 < n:
+                        j += 2
+                        continue
+                    if ch == in_str:
+                        in_str = None
+                else:
+                    if ch in ("'", '"', "`"):
+                        in_str = ch
+                    elif ch == "(":
+                        depth += 1
+                    elif ch == ")":
+                        depth -= 1
+                j += 1
+            if depth != 0:
+                out.append(src[i:m.end()])
+                i = m.end()
+                continue
+            # Check what follows ')' (optional `: ReturnType` then `{` or `=>`)
+            k = j
+            while k < n and src[k] in " \t\r\n":
+                k += 1
+            is_fn = False
+            ret_end = k
+            if k < n and src[k] == "{":
+                is_fn = True
+            elif k + 1 < n and src[k:k + 2] == "=>":
+                is_fn = True
+            elif k < n and src[k] == ":":
+                # Scan return type up to `{` or `=>` at top level
+                r_j = k + 1
+                b_d = p_d = a_d = 0
+                while r_j < n:
+                    rc = src[r_j]
+                    if rc == "{":
+                        if b_d == 0 and p_d == 0 and a_d == 0:
+                            is_fn = True
+                            ret_end = r_j
+                            break
+                        b_d += 1
+                    elif rc == "}":
+                        b_d = max(0, b_d - 1)
+                    elif rc == "(":
+                        p_d += 1
+                    elif rc == ")":
+                        p_d = max(0, p_d - 1)
+                    elif rc == "<":
+                        a_d += 1
+                    elif rc == ">":
+                        if r_j > 0 and src[r_j - 1] == "=" and b_d == 0 and p_d == 0 and a_d == 0:
+                            is_fn = True
+                            ret_end = r_j - 1
+                            break
+                        a_d = max(0, a_d - 1)
+                    elif rc in ";\n" and b_d == 0 and p_d == 0 and a_d == 0:
+                        break
+                    r_j += 1
+
+            if not is_fn:
+                out.append(src[i:m.end()])
+                i = m.end()
+                continue
+
+            # Clean parameter list: split by top-level ',' and strip `: Type` before `=` or end
+            raw_params = src[p_start + 1:j - 1]
+            cleaned_params = []
+            buf = []
+            bd = pd = sd = ad = 0
+            ps = None
+            for ch in raw_params + ",":
+                if ps:
+                    buf.append(ch)
+                    if ch == ps and (len(buf) < 2 or buf[-2] != "\\"):
+                        ps = None
+                    continue
+                if ch in ("'", '"', "`"):
+                    ps = ch
+                    buf.append(ch)
+                elif ch == "," and bd == 0 and pd == 0 and sd == 0 and ad == 0:
+                    item = "".join(buf).strip()
+                    buf = []
+                    if item:
+                        # Strip leading `public`/`private`/`protected`/`readonly` in constructor params
+                        item = re.sub(r"^(?:public|private|protected|readonly)\s+", "", item)
+                        # Find top-level ':' and '='
+                        c_pos = e_pos = -1
+                        ib = ip = isq = ia = 0
+                        for idx, c2 in enumerate(item):
+                            if c2 == "{": ib += 1
+                            elif c2 == "}": ib -= 1
+                            elif c2 == "(": ip += 1
+                            elif c2 == ")": ip -= 1
+                            elif c2 == "[": isq += 1
+                            elif c2 == "]": isq -= 1
+                            elif c2 == "<": ia += 1
+                            elif c2 == ">": ia = max(0, ia - 1)
+                            elif ib == 0 and ip == 0 and isq == 0 and ia == 0:
+                                if c2 == ":" and c_pos == -1 and e_pos == -1:
+                                    c_pos = idx
+                                elif c2 == "=" and e_pos == -1:
+                                    e_pos = idx
+                        if c_pos != -1:
+                            lhs = item[:c_pos].rstrip().rstrip("?")
+                            rhs = (" " + item[e_pos:]) if e_pos != -1 else ""
+                            item = lhs + rhs
+                        else:
+                            item = re.sub(r"\?(?=\s*$|\s*=)", "", item)
+                        if item == "this":
+                            continue
+                        cleaned_params.append(item)
+                else:
+                    if ch == "{": bd += 1
+                    elif ch == "}": bd = max(0, bd - 1)
+                    elif ch == "(": pd += 1
+                    elif ch == ")": pd = max(0, pd - 1)
+                    elif ch == "[": sd += 1
+                    elif ch == "]": sd = max(0, sd - 1)
+                    elif ch == "<": ad += 1
+                    elif ch == ">": ad = max(0, ad - 1)
+                    buf.append(ch)
+
+            out.append(src[i:p_start])
+            out.append("(" + ", ".join(cleaned_params) + ") ")
+            i = ret_end
+        return "".join(out)
+
+    code = strip_balanced_params(code)
+
+    # Also handle arrow functions `(a: Type, b: Type) =>`
+    def strip_arrow_params(m: re.Match) -> str:
+        prefix, params = m.group(1), m.group(2)
+        if "=>" in params:
+            return m.group(0)
+        cleaned = re.sub(
+            rf"(\.\.\.)?([A-Za-z_$][\w$]*)\??\s*:\s*{type_expr}(?=\s*[,=)])",
+            r"\1\2",
+            params + ")",
+        )
+        return prefix + "(" + cleaned
+
+    code = re.sub(
+        r"(^|[=,:(\s])\(([^(){};]*)\)(?=\s*=>)",
+        strip_arrow_params,
+        code,
+        flags=re.M,
+    )
+
+    # Variable declarations: `let x: Type = ...` / `const x: Type = ...`
+    code = re.sub(
+        rf"\b(let|const|var)\s+([A-Za-z_$][\w$]*)\s*:\s*{type_expr}(\s*[=;])",
+        r"\1 \2\3",
+        code,
+    )
+
+    # Class field declarations with type: `foo: string = "bar";` or `foo?: string;`
+    # Never match object literal properties like `success: () => ...` or `key: val,`
+    code = re.sub(
+        rf"^([ \t]*(?:static\s+)?[A-Za-z_$][\w$]*)\??\s*:\s*(?!\([^)]*\)\s*=>){type_expr}(\s*(?:=|;))",
+        r"\1\2",
+        code,
+        flags=re.M,
+    )
+
+    # Generic type parameters on functions/classes/calls: `function foo<T>(...)` / `new Promise<void>(...)`
+    code = re.sub(
+        r"\b(function\s+[A-Za-z_$][\w$]*|class\s+[A-Za-z_$][\w$]*|new\s+[A-Za-z_$][\w$.]*)\s*<[^<>()\n;]+>",
+        r"\1",
+        code,
+    )
+
+    # Type assertions: `expr as SomeType` (avoid matching `import { a as b }`)
+    def strip_as(m: re.Match) -> str:
+        line_prefix = m.group(1)
+        if re.search(r"\b(?:import|export)\b", line_prefix):
+            return m.group(0)
+        return line_prefix
+
+    code = re.sub(
+        rf"([^\n;{{}}]*?)\s+as\s+{type_expr}(?=\s*[;,)\]\}}.\n:])",
+        strip_as,
+        code,
+    )
+
+    # Non-null assertions `foo!.bar`, `foo!(`, `foo!)`, `foo!,`, `foo!;` (never `!=`)
+    code = re.sub(r"([A-Za-z0-9_$\)\]])!(?=[.\[\(\),\];}\s])(?!=)", r"\1", code)
+
+    return code
+
