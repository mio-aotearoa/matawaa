+# ---------------------------------------------------------------------------
+# Light-weight Less -> CSS compiler + component style scoping
+# ---------------------------------------------------------------------------
+
+def resolve_alias(spec: str, aliases: dict[str, Path], current_dir: Path, src_root: Path) -> Path | None:
+    if spec.startswith("/"):
+        cand = src_root / spec.lstrip("/")
+        if cand.exists():
+            return cand
+    for prefix, target in sorted(aliases.items(), key=lambda kv: -len(kv[0])):
+        if spec == prefix:
+            return target
+        if spec.startswith(prefix + "/"):
+            return target / spec[len(prefix) + 1:]
+    cand = (current_dir / spec).resolve()
+    if cand.exists():
+        return cand
+    for ext in (".less", ".css", ".ux", ".ts", ".js", ".json"):
+        if (current_dir / (spec + ext)).exists():
+            return (current_dir / (spec + ext)).resolve()
+    return None
+
+
+def compile_less(css_text: str, current_dir: Path, src_root: Path, aliases: dict[str, Path], visited: set[Path] | None = None) -> str:
+    """
+    Compile Less (and plain CSS) to standard CSS:
+    - Inline `@import` statements
+    - Strip `//` line comments (preserving `http://` and `vela://`)
+    - Collect and substitute `@var: value;` variables
+    - Flatten nested selectors (including `&` parent references)
+    - Translate Vela-specific properties (`lines: N` -> line-clamp)
+    """
+    if visited is None:
+        visited = set()
+
+    # Inline @import
+    def inline_import(m: re.Match) -> str:
+        spec = m.group(1).strip().strip("'\"")
+        target = resolve_alias(spec, aliases, current_dir, src_root)
+        if target and target.is_file() and target not in visited:
+            visited.add(target)
+            raw = target.read_text(encoding="utf-8", errors="replace")
+            return compile_less(raw, target.parent, src_root, aliases, visited)
+        return ""
+
+    css_text = re.sub(r"@import\s+(?:url\()?['\"]([^'\"]+)['\"]\)?\s*;", inline_import, css_text)
+
+    # Strip /* ... */ comments and // line comments (not inside urls)
+    css_text = re.sub(r"/\*.*?\*/", "", css_text, flags=re.S)
+    css_text = re.sub(r"(?<!:)//[^\n]*", "", css_text)
+
+    # Extract @variables
+    variables: dict[str, str] = {}
+    lines_kept = []
+    for line in css_text.splitlines():
+        vm = re.match(r"^\s*(@[A-Za-z0-9_-]+)\s*:\s*([^;]+);\s*$", line)
+        if vm and not vm.group(1).startswith(("@media", "@keyframes", "@font-face", "@import")):
+            variables[vm.group(1)] = vm.group(2).strip()
+        else:
+            lines_kept.append(line)
+    css_text = "\n".join(lines_kept)
+
+    # Substitute variables (longest name first, multiple passes for nested vars)
+    for _ in range(3):
+        for k in sorted(variables.keys(), key=len, reverse=True):
+            css_text = re.sub(re.escape(k) + r"(?![A-Za-z0-9_-])", lambda _: variables[k], css_text)
+            css_text = css_text.replace("@{" + k[1:] + "}", variables[k])
+
+    # Parse nested blocks into flat rules
+    rules: list[tuple[str, list[str]]] = []
+    at_blocks: list[str] = []
+
+    def parse_block(text: str, parent_selectors: list[str]) -> None:
+        i = 0
+        n = len(text)
+        decls: list[str] = []
+        buf = []
+        while i < n:
+            ch = text[i]
+            if ch == "{":
+                header = "".join(buf).strip()
+                buf = []
+                # find matching }
+                depth = 1
+                j = i + 1
+                while j < n and depth > 0:
+                    if text[j] == "{":
+                        depth += 1
+                    elif text[j] == "}":
+                        depth -= 1
+                    j += 1
+                inner = text[i + 1:j - 1]
+                i = j
+
+                if header.startswith(("@keyframes", "@-webkit-keyframes", "@font-face")):
+                    at_blocks.append(f"{header} {{ {inner} }}")
+                elif header.startswith("@media"):
+                    sub_rules: list[tuple[str, list[str]]] = []
+                    # recursively flatten inside @media
+                    saved_len = len(rules)
+                    parse_block(inner, parent_selectors)
+                    sub_rules = rules[saved_len:]
+                    del rules[saved_len:]
+                    inner_css = "\n".join(
+                        f"  {sel} {{ {'; '.join(d)}; }}" for sel, d in sub_rules if d
+                    )
+                    at_blocks.append(f"{header} {{\n{inner_css}\n}}")
+                else:
+                    child_sels = [s.strip() for s in header.split(",") if s.strip()]
+                    combined: list[str] = []
+                    if not parent_selectors:
+                        combined = child_sels
+                    else:
+                        for ps in parent_selectors:
+                            for cs in child_sels:
+                                if "&" in cs:
+                                    combined.append(cs.replace("&", ps))
+                                else:
+                                    combined.append(f"{ps} {cs}")
+                    parse_block(inner, combined)
+            elif ch == ";":
+                decl = "".join(buf).strip()
+                buf = []
+                if decl and ":" in decl:
+                    decls.append(decl)
+                i += 1
+            else:
+                buf.append(ch)
+                i += 1
+        tail = "".join(buf).strip()
+        if tail and ":" in tail:
+            decls.append(tail)
+        if decls and parent_selectors:
+            rules.append((", ".join(parent_selectors), decls))
+
+    parse_block(css_text, [])
+
+    # Emit standard CSS with Vela property translations
+    out_parts: list[str] = []
+    for sel, decls in rules:
+        translated: list[str] = []
+        for d in decls:
+            prop, _, val = d.partition(":")
+            prop = prop.strip()
+            val = val.strip()
+            if prop == "lines":
+                # Vela `lines: N` -> multi-line ellipsis
+                translated.append(f"-webkit-line-clamp: {val}")
+                translated.append("display: -webkit-box")
+                translated.append("-webkit-box-orient: vertical")
+                translated.append("overflow: hidden")
+            elif prop == "background-image" and val.startswith("url(") and not ("http" in val or "data:" in val or "vela://" in val):
+                val = re.sub(r"url\((['\"]?)/?", r"url(\1vela://app/", val)
+                translated.append(f"{prop}: {val}")
+            else:
+                translated.append(f"{prop}: {val}")
+        out_parts.append(f"{sel} {{ {'; '.join(translated)}; }}")
+
+    out_parts.extend(at_blocks)
+    return "\n".join(out_parts)
+
+
+def scope_css(css_text: str, scope_attr: str) -> str:
+    """Scope each selector in compiled CSS to `[data-v-<scope>]`."""
+    def scope_selector_list(sel_list: str) -> str:
+        scoped = []
+        for s in sel_list.split(","):
+            s = s.strip()
+            if not s or s.startswith("@") or s in ("from", "to") or re.match(r"^\d+%$", s):
+                scoped.append(s)
+                continue
+            # Append [scope_attr] before pseudo-classes/pseudo-elements on the last simple selector
+            m = re.match(r"^(.*?)(::?[A-Za-z-]+(?:\([^)]*\))?)$", s)
+            if m:
+                scoped.append(f"{m.group(1)}[{scope_attr}]{m.group(2)}")
+            else:
+                scoped.append(f"{s}[{scope_attr}]")
+        return ", ".join(scoped)
+
+    # Walk top-level rules and @media blocks
+    out = []
+    i = 0
+    n = len(css_text)
+    while i < n:
+        brace = css_text.find("{", i)
+        if brace == -1:
+            out.append(css_text[i:])
+            break
+        header = css_text[i:brace].strip()
+        # find matching }
+        depth = 1
+        j = brace + 1
+        while j < n and depth > 0:
+            if css_text[j] == "{":
+                depth += 1
+            elif css_text[j] == "}":
+                depth -= 1
+            j += 1
+        body = css_text[brace + 1:j - 1]
+        if header.startswith("@media"):
+            out.append(f"{header} {{\n{scope_css(body, scope_attr)}\n}}")
+        elif header.startswith(("@keyframes", "@-webkit-keyframes", "@font-face")):
+            out.append(f"{header} {{{body}}}")
+        else:
+            out.append(f"{scope_selector_list(header)} {{{body}}}")
+        i = j
+    return "\n".join(out)
+
+
+# ---------------------------------------------------------------------------
+# .ux <template> HTML/XML parser -> JSON AST
+# ---------------------------------------------------------------------------
+
+VOID_TAGS = {"img", "image", "input", "br", "hr", "source", "meta", "link"}
+
+
+class TemplateParser(html.parser.HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.root: dict[str, Any] = {"type": "root", "children": []}
+        self.stack: list[dict[str, Any]] = [self.root]
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        node = self._make_element(tag, attrs)
+        self.stack[-1]["children"].append(node)
+        if tag.lower() not in VOID_TAGS:
+            self.stack.append(node)
+
+    def handle_startendtag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        node = self._make_element(tag, attrs)
+        self.stack[-1]["children"].append(node)
+
+    def handle_endtag(self, tag: str) -> None:
+        tag_l = tag.lower()
+        for idx in range(len(self.stack) - 1, 0, -1):
+            if self.stack[idx].get("tag") == tag_l:
+                del self.stack[idx:]
+                break
+
+    def handle_data(self, data: str) -> None:
+        if not data:
+            return
+        if data.strip() == "" and self.stack[-1].get("tag") not in ("text", "span", "a", "marquee"):
+            return
+        self.stack[-1]["children"].append({"type": "text", "value": data})
+
+    def _make_element(self, tag: str, attrs: list[tuple[str, str | None]]) -> dict[str, Any]:
+        attr_map: dict[str, Any] = {}
+        events: dict[str, str] = {}
+        directives: dict[str, Any] = {}
+
+        for raw_k, raw_v in attrs:
+            k = raw_k
+            v = "" if raw_v is None else raw_v
+            if k in ("if", "elif", "show", "for", "tid"):
+                directives[k] = v
+            elif k == "else":
+                directives["else"] = True
+            elif k.startswith("@"):
+                events[k[1:]] = v
+            elif k.startswith("on") and len(k) > 2:
+                events[k[2:]] = v
+            else:
+                attr_map[k] = v
+
+        return {
+            "type": "el",
+            "tag": tag.lower(),
+            "attrs": attr_map,
+            "events": events,
+            "directives": directives,
+            "children": [],
+        }
+
+
+def parse_template(tmpl_html: str) -> list[dict[str, Any]]:
+    parser = TemplateParser()
+    parser.feed(tmpl_html)
+    parser.close()
+    return parser.root["children"]
+
+
+# ---------------------------------------------------------------------------
+# ES Module (import / export) -> CommonJS transformer
+# ---------------------------------------------------------------------------
+
+def transform_esm_to_cjs(code: str, is_ts: bool = False) -> str:
+    if is_ts:
+        code = strip_typescript(code)
+
+    # Split multiple `; import ...` statements on a single line so line-anchored rules catch all of them
+    code = re.sub(r";[ \t]*(?=(?:import|export)\b)", ";\n", code)
+
+    # Replace `import * as foo from 'bar'`
+    code = re.sub(
+        r"(?m)^([ \t]*)import\s+\*\s+as\s+([A-Za-z_$][\w$]*)\s+from\s+['\"]([^'\"]+)['\"][ \t]*;?",
+        r"\1const \2 = require('\3');",
+        code,
+    )
+    # Replace `import def, { a, b as c } from 'bar'`
+    def repl_default_and_named(m: re.Match) -> str:
+        indent, def_name, named, spec = m.groups()
+        spec_list = []
+        for item in named.split(","):
+            item = item.strip()
+            if not item:
+                continue
+            if " as " in item:
+                orig, alias = [x.strip() for x in item.split(" as ", 1)]
+                spec_list.append(f"{orig}: {alias}")
+            else:
+                spec_list.append(item)
+        tmp = f"__m_{sha1_short(spec + def_name)}"
+        return (
+            f"{indent}const {tmp} = require('{spec}');\n"
+            f"{indent}const {def_name} = ({tmp} && {tmp}.__esModule) ? {tmp}.default : {tmp};\n"
+            f"{indent}const {{ {', '.join(spec_list)} }} = {tmp};"
+        )
+
+    code = re.sub(
+        r"(?m)^([ \t]*)import\s+([A-Za-z_$][\w$]*)\s*,\s*\{([^}]+)\}\s*from\s+['\"]([^'\"]+)['\"][ \t]*;?",
+        repl_default_and_named,
+        code,
+    )
+    # Replace `import { a, b as c } from 'bar'`
+    def repl_named(m: re.Match) -> str:
+        indent, named, spec = m.groups()
+        spec_list = []
+        for item in named.split(","):
+            item = item.strip()
+            if not item:
+                continue
+            if " as " in item:
+                orig, alias = [x.strip() for x in item.split(" as ", 1)]
+                spec_list.append(f"{orig}: {alias}")
+            else:
+                spec_list.append(item)
+        return f"{indent}const {{ {', '.join(spec_list)} }} = require('{spec}');"
+
+    code = re.sub(
+        r"(?m)^([ \t]*)import\s*\{([^}]+)\}\s*from\s+['\"]([^'\"]+)['\"][ \t]*;?",
+        repl_named,
+        code,
+    )
+    # Replace `import foo from 'bar'`
+    def repl_default(m: re.Match) -> str:
+        indent, name, spec = m.groups()
+        tmp = f"__m_{sha1_short(spec + name)}"
+        return (
+            f"{indent}const {tmp} = require('{spec}'); "
+            f"const {name} = ({tmp} && {tmp}.__esModule) ? {tmp}.default : {tmp};"
+        )
+
+    code = re.sub(
+        r"(?m)^([ \t]*)import\s+([A-Za-z_$][\w$]*)\s+from\s+['\"]([^'\"]+)['\"][ \t]*;?",
+        repl_default,
+        code,
+    )
+    # Side-effect import: `import 'bar'`
+    code = re.sub(
+        r"(?m)^([ \t]*)import\s+['\"]([^'\"]+)['\"][ \t]*;?",
+        r"\1require('\2');",
+        code,
+    )
+
+    # Exports
+    has_esm_export = False
+
+    def mark_export(repl: str):
+        def _inner(m: re.Match) -> str:
+            nonlocal has_esm_export
+            has_esm_export = True
+            return m.expand(repl)
+        return _inner
+
+    # `export default ...`
+    code, n1 = re.subn(r"(?m)^([ \t]*)export\s+default\b", r"\1exports.default =", code)
+    if n1:
+        has_esm_export = True
+
+    # `export async function foo` / `export function foo`
+    code, n2 = re.subn(
+        r"(?m)^([ \t]*)export\s+(async\s+)?function\s+([A-Za-z_$][\w$]*)",
+        r"\1exports.\3 = \2function \3",
+        code,
+    )
+    if n2:
+        has_esm_export = True
+
+    # `export class Foo`
+    code, n3 = re.subn(
+        r"(?m)^([ \t]*)export\s+class\s+([A-Za-z_$][\w$]*)",
+        r"\1const \2 = exports.\2 = class \2",
+        code,
+    )
+    if n3:
+        has_esm_export = True
+
+    # `export const/let/var foo = ...`
+    def repl_export_var(m: re.Match) -> str:
+        nonlocal has_esm_export
+        has_esm_export = True
+        indent, kw, name = m.groups()
+        return f"{indent}{kw} {name} = exports.{name}"
+
+    code = re.sub(
+        r"(?m)^([ \t]*)export\s+(const|let|var)\s+([A-Za-z_$][\w$]*)(?=\s*=)",
+        repl_export_var,
+        code,
+    )
+
+    # `export { a, b as c } from 'mod'`
+    def repl_reexport(m: re.Match) -> str:
+        nonlocal has_esm_export
+        has_esm_export = True
+        indent, names, spec = m.groups()
+        tmp = f"__re_{sha1_short(spec + names)}"
+        stmts = [f"{indent}const {tmp} = require('{spec}');"]
+        for item in names.split(","):
+            item = item.strip()
+            if not item:
+                continue
+            if " as " in item:
+                orig, alias = [x.strip() for x in item.split(" as ", 1)]
+                stmts.append(f"{indent}exports.{alias} = {tmp}.{orig};")
+            else:
+                stmts.append(f"{indent}exports.{item} = {tmp}.{item};")
+        return "\n".join(stmts)
+
+    code = re.sub(
+        r"(?m)^([ \t]*)export\s*\{([^}]+)\}\s*from\s*['\"]([^'\"]+)['\"]\s*;?",
+        repl_reexport,
+        code,
+    )
+
+    # `export { a, b as c }`
+    def repl_export_list(m: re.Match) -> str:
+        nonlocal has_esm_export
+        has_esm_export = True
+        indent, names = m.groups()
+        stmts = []
+        for item in names.split(","):
+            item = item.strip()
+            if not item:
+                continue
+            if " as " in item:
+                orig, alias = [x.strip() for x in item.split(" as ", 1)]
+                stmts.append(f"{indent}exports.{alias} = {orig};")
+            else:
+                stmts.append(f"{indent}exports.{item} = {item};")
+        return "\n".join(stmts)
+
+    code = re.sub(r"(?m)^([ \t]*)export\s*\{([^}]+)\}\s*;?", repl_export_list, code)
+
+    if has_esm_export:
+        code = "Object.defineProperty(exports, '__esModule', { value: true });\n" + code
+
+    return code
+
+
+# ---------------------------------------------------------------------------
+# Parse quickapp.config.js aliases (best-effort static extraction)
+# ---------------------------------------------------------------------------
+
+def parse_quickapp_aliases(project_root: Path, src_root: Path) -> dict[str, Path]:
+    aliases: dict[str, Path] = {}
+    cfg = project_root / "quickapp.config.js"
+    if not cfg.is_file():
+        return aliases
+    text = cfg.read_text(encoding="utf-8", errors="replace")
+    # Match `'@foo': path.resolve(__dirname, 'src/foo')`
+    for m in re.finditer(
+        r"['\"]([@$][^'\"]+)['\"]\s*:\s*path\.resolve\(\s*__dirname\s*,\s*['\"]([^'\"]+)['\"]\s*\)",
+        text,
+    ):
+        aliases[m.group(1)] = (project_root / m.group(2)).resolve()
+    # Match `'$buildinfo': buildInfoPath`
+    if "$buildinfo" in text and "$buildinfo" not in aliases:
+        aliases["$buildinfo"] = (src_root / "buildinfo.ts").resolve()
+    return aliases
+
+
+# ---------------------------------------------------------------------------
+# .ux Single-File Component Compiler
+# ---------------------------------------------------------------------------
+
+def compile_ux_file(
+    ux_path: Path,
+    src_root: Path,
+    aliases: dict[str, Path],
+    module_id: str,
+) -> dict[str, Any]:
+    raw = ux_path.read_text(encoding="utf-8", errors="replace")
+    scope_id = f"data-v-{sha1_short(module_id)}"
+
+    # Extract <import name="..." src="..."></import> or self-closing <import ... />
+    imports: dict[str, str] = {}
+    for m in re.finditer(r"<import\b([^>]*)/?>(?:\s*</import>)?", raw, re.I):
+        attrs = m.group(1)
+        nm = re.search(r'name\s*=\s*["\']([^"\']+)["\']', attrs)
+        sm = re.search(r'src\s*=\s*["\']([^"\']+)["\']', attrs)
+        if nm and sm:
+            target = resolve_alias(sm.group(1), aliases, ux_path.parent, src_root)
+            if target and target.is_file():
+                try:
+                    rel = target.relative_to(src_root).as_posix()
+                except ValueError:
+                    rel = target.as_posix()
+                imports[nm.group(1).lower()] = rel
+
+    # Extract <template>...</template>
+    tmpl_m = re.search(r"<template\b[^>]*>(.*)</template>", raw, re.S | re.I)
+    template_ast = parse_template(tmpl_m.group(1)) if tmpl_m else []
+
+    # Extract <script ...>...</script>
+    script_m = re.search(r"<script\b([^>]*)>(.*)</script>", raw, re.S | re.I)
+    script_code = "exports.default = {};"
+    if script_m:
+        script_attrs = script_m.group(1) or ""
+        is_ts = bool(re.search(r'lang\s*=\s*["\']ts["\']', script_attrs, re.I))
+        script_code = transform_esm_to_cjs(script_m.group(2), is_ts=is_ts)
+
+    # Extract all <style ...>...</style> blocks
+    css_chunks: list[str] = []
+    for sm in re.finditer(r"<style\b([^>]*)>(.*?)</style>", raw, re.S | re.I):
+        compiled = compile_less(sm.group(2), ux_path.parent, src_root, aliases)
+        scoped = scope_css(compiled, scope_id)
+        css_chunks.append(scoped)
+
+    return {
+        "id": module_id,
+        "scope": scope_id,
+        "imports": imports,
+        "template": template_ast,
+        "script": script_code,
+        "style": "\n".join(css_chunks),
+    }
+
+
+# ---------------------------------------------------------------------------
+# Full project / .rpk bundler
+# ---------------------------------------------------------------------------
+
+def detect_source_root(input_path: Path, work_dir: Path) -> tuple[Path, Path, str]:
+    """
+    Returns (project_root, src_root, mode) where mode is 'ux-source', 'rpk-js', or 'rpk-jsc'.
+    """
+    if input_path.is_file() and input_path.suffix.lower() in (".rpk", ".zip"):
+        extract_dir = work_dir / "_unpacked"
+        if extract_dir.exists():
+            shutil.rmtree(extract_dir)
+        extract_dir.mkdir(parents=True, exist_ok=True)
+        with zipfile.ZipFile(input_path, "r") as zf:
+            zf.extractall(extract_dir)
+        # Check if it's a signed/nested rpk or direct files
+        manifest = extract_dir / "manifest.json"
+        if not manifest.is_file():
+            # Search one level deep
+            cands = list(extract_dir.glob("*/manifest.json"))
+            if cands:
+                extract_dir = cands[0].parent
+        if any(extract_dir.rglob("*.ux")):
+            return extract_dir, extract_dir, "ux-source"
+        if any(extract_dir.rglob("*.jsc")):
+            return extract_dir, extract_dir, "rpk-jsc"
+        return extract_dir, extract_dir, "rpk-js"
+
+    if (input_path / "src" / "manifest.json").is_file():
+        return input_path, input_path / "src", "ux-source"
+    if (input_path / "manifest.json").is_file():
+        if any(input_path.rglob("*.ux")):
+            return input_path, input_path, "ux-source"
+        if any(input_path.rglob("*.jsc")):
+            return input_path, input_path, "rpk-jsc"
+        return input_path, input_path, "rpk-js"
+
+    raise FileNotFoundError(f"No manifest.json found in {input_path}")
+
+
+def bundle_project(input_path: Path, output_dir: Path) -> dict[str, Any]:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    project_root, src_root, mode = detect_source_root(input_path, output_dir)
+
+    manifest_path = src_root / "manifest.json"
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+
+    # Copy static assets (images, fonts, json, txt, etc.) into output_dir/assets/
+    assets_dir = output_dir / "assets"
+    if assets_dir.exists():
+        shutil.rmtree(assets_dir)
+    assets_dir.mkdir(parents=True, exist_ok=True)
+
+    asset_exts = {
+        ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".ico",
+        ".ttf", ".otf", ".woff", ".woff2", ".mp3", ".wav", ".ogg", ".m4a",
+        ".txt", ".json", ".bin", ".pb",
+    }
+    for root, dirs, files in os.walk(src_root):
+        dirs[:] = [d for d in dirs if d not in (".git", "node_modules", "__pycache__")]
+        for fn in files:
+            p = Path(root) / fn
+            if p.suffix.lower() in asset_exts:
+                rel = p.relative_to(src_root)
+                dest = assets_dir / rel
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copy2(p, dest)
+
+    # Also copy icon if it lives at project_root instead of src_root
+    icon_rel = (manifest.get("icon") or "").lstrip("/")
+    if icon_rel and not (assets_dir / icon_rel).exists():
+        if (project_root / icon_rel).is_file():
+            dest = assets_dir / icon_rel
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(project_root / icon_rel, dest)
+
+    # Load i18n JSONs if present
+    i18n_data: dict[str, Any] = {}
+    i18n_dir = src_root / "i18n"
+    if i18n_dir.is_dir():
+        for jf in sorted(i18n_dir.glob("*.json")):
+            try:
+                i18n_data[jf.stem] = json.loads(jf.read_text(encoding="utf-8"))
+            except Exception:
+                pass
+
+    if mode == "rpk-jsc":
+        meta = {
+            "mode": "rpk-jsc",
+            "manifest": manifest,
+            "error": (
+                "This .rpk package contains Xiaomi QuickJS bytecode (.jsc) compiled with "
+                "--enable-jsc. Install the app's source directory (.ux) or a non-JSC .rpk build."
+            ),
+        }
+        (output_dir / "bundle.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
+        return meta
+
+    if mode == "rpk-js":
+        # Pre-built plain-JS .rpk (app.js + pages/.../*.js)
+        rpk_scripts: dict[str, str] = {}
+        for jf in sorted(src_root.rglob("*.js")):
+            rel = jf.relative_to(src_root).as_posix()
+            rpk_scripts[rel] = jf.read_text(encoding="utf-8", errors="replace")
+        bundle = {
+            "mode": "rpk-js",
+            "manifest": manifest,
+            "i18n": i18n_data,
+            "scripts": rpk_scripts,
+        }
+        (output_dir / "bundle.json").write_text(json.dumps(bundle, ensure_ascii=False), encoding="utf-8")
+        return bundle
+
+    # mode == "ux-source"
+    aliases = parse_quickapp_aliases(project_root, src_root)
+    alias_rel_map: dict[str, str] = {}
+    for k, target in aliases.items():
+        try:
+            alias_rel_map[k] = target.relative_to(src_root).as_posix()
+        except ValueError:
+            pass
+
+    # Compile all .ux files
+    components: dict[str, Any] = {}
+    for ux_path in sorted(src_root.rglob("*.ux")):
+        rel = ux_path.relative_to(src_root).as_posix()
+        components[rel] = compile_ux_file(ux_path, src_root, aliases, rel)
+
+    # Compile all .js, .ts, .json modules under src_root
+    modules: dict[str, str] = {}
+    for ext in ("*.js", "*.ts"):
+        for mp in sorted(src_root.rglob(ext)):
+            rel = mp.relative_to(src_root).as_posix()
+            raw = mp.read_text(encoding="utf-8", errors="replace")
+            modules[rel] = transform_esm_to_cjs(raw, is_ts=(mp.suffix == ".ts"))
+
+    for jp in sorted(src_root.rglob("*.json")):
+        rel = jp.relative_to(src_root).as_posix()
+        if rel == "manifest.json":
+            continue
+        raw = jp.read_text(encoding="utf-8", errors="replace")
+        modules[rel] = f"module.exports = {raw};"
+
+    # Synthesize buildinfo.ts if referenced via $buildinfo alias and missing
+    if "$buildinfo" in aliases and "buildinfo.ts" not in modules:
+        dw = manifest.get("config", {}).get("designWidth", 416)
+        dw_js = json.dumps(dw)
+        modules["buildinfo.ts"] = (
+            "Object.defineProperty(exports, '__esModule', { value: true });\n"
+            "exports.GIT_COMMIT_HASH = 'matawaa-compat';\n"
+            "exports.BUILD_TIME = '2026-01-01T00:00:00Z';\n"
+            "exports.BUILD_USER = 'matawaa';\n"
+            f"exports.DESIGN_WIDTH = {dw_js};\n"
+        )
+
+    # Assemble JS bundle file (easier for WebKit to parse & debug than giant JSON strings)
+    js_lines: list[str] = [
+        "window.__VELA_BUNDLE__ = window.__VELA_BUNDLE__ || { modules: {}, components: {}, aliases: {} };",
+        f"window.__VELA_BUNDLE__.aliases = {json.dumps(alias_rel_map, ensure_ascii=False)};",
+    ]
+    for mod_id, code in modules.items():
+        js_lines.append(
+            f"window.__VELA_BUNDLE__.modules[{json.dumps(mod_id)}] = "
+            f"function(require, exports, module) {{\n{code}\n}};"
+        )
+    for comp_id, comp in components.items():
+        code = comp["script"]
+        js_lines.append(
+            f"window.__VELA_BUNDLE__.components[{json.dumps(comp_id)}] = "
+            f"function(require, exports, module) {{\n{code}\n}};"
+        )
+
+    (output_dir / "bundle.js").write_text("\n\n".join(js_lines), encoding="utf-8")
+
+    # Write combined component CSS
+    css_all = "\n\n".join(
+        f"/* {cid} */\n{comp['style']}" for cid, comp in components.items() if comp["style"]
+    )
+    (output_dir / "bundle.css").write_text(css_all, encoding="utf-8")
+
+    # Write metadata + templates JSON (without script/style strings to keep JSON compact)
+    meta_components = {
+        cid: {
+            "id": comp["id"],
+            "scope": comp["scope"],
+            "imports": comp["imports"],
+            "template": comp["template"],
+        }
+        for cid, comp in components.items()
+    }
+    meta = {
+        "mode": "ux-source",
+        "manifest": manifest,
+        "i18n": i18n_data,
+        "aliases": alias_rel_map,
+        "components": meta_components,
+    }
+    (output_dir / "bundle.json").write_text(json.dumps(meta, ensure_ascii=False), encoding="utf-8")
+    return meta
+
+
+def install_app(input_path: Path, apps_root: Path) -> Path:
+    """Compile and install a Vela app into `<apps_root>/<package>/`."""
+    tmp_out = apps_root / f".tmp-{sha1_short(str(input_path))}"
+    if tmp_out.exists():
+        shutil.rmtree(tmp_out)
+    meta = bundle_project(input_path, tmp_out)
+    pkg = meta["manifest"].get("package") or input_path.stem
+    safe_pkg = re.sub(r"[^A-Za-z0-9._-]", "_", pkg)
+    dest = apps_root / safe_pkg
+    if dest.exists():
+        shutil.rmtree(dest)
+    tmp_out.rename(dest)
+    return dest
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Compile or install a Xiaomi Vela QuickApp (.ux / .rpk)")
+    parser.add_argument("input", type=Path, help="Path to Vela app directory or .rpk archive")
+    parser.add_argument("-o", "--output", type=Path, help="Output bundle directory")
+    parser.add_argument("--install", action="store_true", help="Install into apps directory (~/.local/share/asteroid-vela/apps or --output)")
+    args = parser.parse_args()
+
+    inp = args.input.resolve()
+    if not inp.exists():
+        print(f"[vela-compile] Input not found: {inp}", file=sys.stderr)
+        return 1
+
+    if args.install:
+        apps_root = args.output or (Path.home() / ".local" / "share" / "asteroid-vela" / "apps")
+        dest = install_app(inp, apps_root)
+        print(f"[vela-compile] Installed {inp} -> {dest}")
+        return 0
+
+    if not args.output:
+        print("[vela-compile] Either --output DIR or --install is required", file=sys.stderr)
+        return 1
+
+    meta = bundle_project(inp, args.output.resolve())
+    pkg = meta["manifest"].get("package", "unknown")
+    name = meta["manifest"].get("name", pkg)
+    print(f"[vela-compile] Bundled {name} ({pkg}) [{meta['mode']}] -> {args.output}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
