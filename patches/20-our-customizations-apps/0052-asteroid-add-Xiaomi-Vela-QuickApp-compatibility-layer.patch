+/* ------------------------------------------------------------------------- */
+/* Bridge Handlers: Interconnect WebSocket                                   */
+/* ------------------------------------------------------------------------- */
+
+static void on_ws_message(SoupWebsocketConnection *conn, gint type, GBytes *message, gpointer user_data) {
+    (void)conn;
+    VelaHost *host = (VelaHost *)user_data;
+    if (type != SOUP_WEBSOCKET_DATA_TEXT && type != SOUP_WEBSOCKET_DATA_BINARY) return;
+    gsize len = 0;
+    const gchar *raw = g_bytes_get_data(message, &len);
+    gchar *text = g_strndup(raw ? raw : "", len);
+    JsonBuilder *b = json_builder_new();
+    json_builder_begin_object(b);
+    json_builder_set_member_name(b, "data");
+    json_builder_add_string_value(b, text);
+    json_builder_end_object(b);
+    JsonNode *n = json_builder_get_root(b);
+    bridge_emit_event(host, "interconnect.message", n);
+    json_node_free(n);
+    g_object_unref(b);
+    g_free(text);
+}
+
+static void on_ws_closed(SoupWebsocketConnection *conn, gpointer user_data) {
+    (void)conn;
+    VelaHost *host = (VelaHost *)user_data;
+    host->ws_connected = FALSE;
+    g_clear_object(&host->ws_conn);
+    bridge_emit_event(host, "interconnect.close", NULL);
+}
+
+static void on_ws_connected(GObject *source, GAsyncResult *res, gpointer user_data) {
+    VelaHost *host = (VelaHost *)user_data;
+    GError *err = NULL;
+    SoupWebsocketConnection *conn = soup_session_websocket_connect_finish(SOUP_SESSION(source), res, &err);
+    if (err || !conn) {
+        host->ws_connected = FALSE;
+        if (err) g_error_free(err);
+        bridge_emit_event(host, "interconnect.error", NULL);
+        return;
+    }
+    g_clear_object(&host->ws_conn);
+    host->ws_conn = conn;
+    host->ws_connected = TRUE;
+    g_signal_connect(conn, "message", G_CALLBACK(on_ws_message), host);
+    g_signal_connect(conn, "closed", G_CALLBACK(on_ws_closed), host);
+    bridge_emit_event(host, "interconnect.open", NULL);
+}
+
+static void handle_interconnect(VelaHost *host, gint64 id, const gchar *method, JsonObject *params) {
+    if (g_strcmp0(method, "interconnect.connect") == 0) {
+        if (!host->ws_connected) {
+            const gchar *ws_url = g_getenv("VELA_INTERCONNECT_URL");
+            if (!ws_url || !*ws_url) ws_url = "ws://127.0.0.1:18765";
+            SoupMessage *msg = soup_message_new("GET", ws_url);
+            if (msg) {
+                soup_session_websocket_connect_async(host->soup, msg, NULL, NULL, G_PRIORITY_DEFAULT, NULL, on_ws_connected, host);
+                g_object_unref(msg);
+            }
+        }
+        bridge_resolve(host, id, TRUE, NULL);
+    } else if (g_strcmp0(method, "interconnect.getReadyState") == 0) {
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "status");
+        json_builder_add_int_value(b, host->ws_connected ? 1 : 2);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "interconnect.diagnosis") == 0) {
+        JsonBuilder *b = json_builder_new();
+        json_builder_begin_object(b);
+        json_builder_set_member_name(b, "status");
+        json_builder_add_int_value(b, host->ws_connected ? 0 : 1001);
+        json_builder_end_object(b);
+        JsonNode *n = json_builder_get_root(b);
+        bridge_resolve(host, id, TRUE, n);
+        json_node_free(n);
+        g_object_unref(b);
+    } else if (g_strcmp0(method, "interconnect.send") == 0) {
+        if (!host->ws_connected || !host->ws_conn) {
+            bridge_resolve_err(host, id, "Interconnect peer not connected");
+            return;
+        }
+        const gchar *data = json_object_get_string_member(params, "data");
+        soup_websocket_connection_send_text(host->ws_conn, data ? data : "");
+        bridge_resolve(host, id, TRUE, NULL);
+    }
+}
