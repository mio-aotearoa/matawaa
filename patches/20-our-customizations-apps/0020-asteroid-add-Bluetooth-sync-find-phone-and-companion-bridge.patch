+namespace {
+
+const QString kCameraId = QStringLiteral("org.asteroidos.camera");
+const QString kSpo2Id = QStringLiteral("org.asteroidos.spo2");
+const QString kKeyboardId = QStringLiteral("org.asteroidos.keyboard");
+const QString kVelaId = QStringLiteral("org.asteroidos.vela");
+const QString kSystemId = QStringLiteral("org.asteroidos.system");
+
+QString normalizeAppId(const QString &id)
+{
+    if (id == QStringLiteral("cam") || id == kCameraId) return kCameraId;
+    if (id == QStringLiteral("spo2") || id == kSpo2Id) return kSpo2Id;
+    if (id == QStringLiteral("kbd") || id == kKeyboardId) return kKeyboardId;
+    if (id == QStringLiteral("vela") || id == kVelaId) return kVelaId;
+    if (id == QStringLiteral("sys") || id == kSystemId) return kSystemId;
+    // Extensible reverse-DNS namespace for future watch/companion apps
+    if (id.startsWith(QStringLiteral("org.asteroidos.")) && id.size() <= APP_BRIDGE_MAX_APP_LEN) {
+        return id;
+    }
+    return QString();
+}
+
+QByteArray compactAppId(const QString &canonical)
+{
+    if (canonical == kCameraId) return QByteArrayLiteral("cam");
+    if (canonical == kKeyboardId) return QByteArrayLiteral("kbd");
+    if (canonical == kVelaId) return QByteArrayLiteral("vela");
+    if (canonical == kSpo2Id) return QByteArrayLiteral("spo2");
+    if (canonical == kSystemId) return QByteArrayLiteral("sys");
+    return canonical.toUtf8();
+}
+
+bool isCameraRxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("ready"),
+        QStringLiteral("paused"),
+        QStringLiteral("photo_captured"),
+        QStringLiteral("video_started"),
+        QStringLiteral("video_stopped"),
+        QStringLiteral("state_changed"),
+    };
+    return allowed.contains(action);
+}
+
+bool isCameraTxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("capture"),
+        QStringLiteral("flip"),
+        QStringLiteral("zoom_in"),
+        QStringLiteral("zoom_out"),
+        QStringLiteral("torch"),
+        QStringLiteral("mode_photo"),
+        QStringLiteral("mode_video"),
+        QStringLiteral("timer_cycle"),
+        QStringLiteral("status_query"),
+    };
+    return allowed.contains(action);
+}
+
+bool isKeyboardRxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("commit"),
+        QStringLiteral("text"),
+        QStringLiteral("backspace"),
+        QStringLiteral("enter"),
+        QStringLiteral("close"),
+    };
+    return allowed.contains(action);
+}
+
+bool isKeyboardTxAction(const QString &action)
+{
+    static const QSet<QString> allowed = {
+        QStringLiteral("request_input"),
+        QStringLiteral("open"),
+        QStringLiteral("close"),
+    };
+    return allowed.contains(action);
+}
+
+bool isValidToken(const QByteArray &token, int maxLen, bool allowSlash)
+{
+    if (token.isEmpty() || token.size() > maxLen) {
+        return false;
+    }
+    for (char ch : token) {
+        const bool ok = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
+                        || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.'
+                        || ch == '-' || (allowSlash && ch == '/');
+        if (!ok) {
+            return false;
+        }
+    }
+    return true;
+}
+
+QStringList localWatchCapabilities()
+{
+    return {
+        QStringLiteral("protocol_v2"),
+        QStringLiteral("camera_remote_v2"),
+        QStringLiteral("keyboard_input"),
+        QStringLiteral("datalayer_v2"),
+        QStringLiteral("channel_stream"),
+        QStringLiteral("vela_interconnect"),
+    };
+}
+
+QString dataStoreFilePath()
+{
+    QString base = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (base.isEmpty()) {
+        base = QStringLiteral("/var/lib/asteroid-btsyncd");
+    }
+    QDir().mkpath(base);
+    return base + QStringLiteral("/datalayer.json");
+}
+
+} // namespace
+
+QString AppBridgeService::dataStoreKey(const QString &appId, const QString &path)
+{
+    return appId + QLatin1Char('|') + path;
+}
+
+void AppBridgeService::loadDataStore()
+{
+    QFile f(dataStoreFilePath());
+    if (!f.open(QIODevice::ReadOnly)) {
+        return;
+    }
+    const QJsonDocument doc = QJsonDocument::fromJson(f.readAll());
+    if (!doc.isObject()) {
+        return;
+    }
+    const QJsonObject root = doc.object();
+    for (auto it = root.begin(); it != root.end(); ++it) {
+        if (it.value().isString()) {
+            m_dataStore.insert(it.key(), it.value().toString());
+        }
+    }
+}
+
+void AppBridgeService::saveDataStore() const
+{
+    QJsonObject root;
+    for (auto it = m_dataStore.constBegin(); it != m_dataStore.constEnd(); ++it) {
+        root.insert(it.key(), it.value());
+    }
+    QFile f(dataStoreFilePath());
+    if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        f.write(QJsonDocument(root).toJson(QJsonDocument::Compact));
+    }
+}
+
+void AppBridgeService::sendMessage(const QString &appId, const QString &path, const QString &payload)
+{
+    sendFrames(AB_MSG_MESSAGE, appId, path, payload.toUtf8(), AB_FLAG_NONE);
+}
+
+void AppBridgeService::sendBytes(const QString &appId, const QString &path, const QByteArray &payload)
+{
+    sendFrames(AB_MSG_MESSAGE, appId, path, payload, AB_FLAG_NONE);
+}
+
+quint16 AppBridgeService::sendReliableMessage(const QString &appId, const QString &path, const QString &payload)
+{
+    return sendFrames(AB_MSG_MESSAGE, appId, path, payload.toUtf8(), AB_FLAG_ACK_REQ);
+}
+
+quint16 AppBridgeService::sendChannelData(const QString &appId, const QString &path, const QByteArray &payload)
+{
+    return sendFrames(AB_MSG_CHAN_DATA, appId, path, payload, AB_FLAG_ACK_REQ | AB_FLAG_FIN);
+}
+
+void AppBridgeService::queryCapabilities()
+{
+    QJsonObject obj;
+    obj.insert(QStringLiteral("version"), APP_BRIDGE_VERSION);
+    obj.insert(QStringLiteral("capabilities"), QJsonArray::fromStringList(localWatchCapabilities()));
+    sendFrames(AB_MSG_CAP_QUERY, kSystemId, QStringLiteral("/capabilities"),
+               QJsonDocument(obj).toJson(QJsonDocument::Compact), AB_FLAG_NONE);
+}
+
+void AppBridgeService::putDataItem(const QString &appId, const QString &path, const QString &payload)
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty() || !isValidToken(path.toUtf8(), APP_BRIDGE_MAX_PATH_LEN, true)) {
+        return;
+    }
+    m_dataStore.insert(dataStoreKey(canonical, path), payload);
+    saveDataStore();
+    emit dataItemChanged(canonical, path, payload);
+    sendFrames(AB_MSG_DATA_PUT, canonical, path, payload.toUtf8(), AB_FLAG_ACK_REQ);
+}
+
+QString AppBridgeService::getDataItem(const QString &appId, const QString &path) const
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty()) {
+        return QString();
+    }
+    return m_dataStore.value(dataStoreKey(canonical, path));
+}
+
+void AppBridgeService::requestDataItem(const QString &appId, const QString &path)
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty() || !isValidToken(path.toUtf8(), APP_BRIDGE_MAX_PATH_LEN, true)) {
+        return;
+    }
+    sendFrames(AB_MSG_DATA_GET, canonical, path, QByteArray(), AB_FLAG_NONE);
+}
+
+void AppBridgeService::deleteDataItem(const QString &appId, const QString &path)
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty() || !isValidToken(path.toUtf8(), APP_BRIDGE_MAX_PATH_LEN, true)) {
+        return;
+    }
+    m_dataStore.remove(dataStoreKey(canonical, path));
+    saveDataStore();
+    emit dataItemDeleted(canonical, path);
+    sendFrames(AB_MSG_DATA_DEL, canonical, path, QByteArray(), AB_FLAG_ACK_REQ);
+}
+
+QStringList AppBridgeService::listDataItems(const QString &appId) const
+{
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty()) {
+        return {};
+    }
+    const QString prefix = canonical + QLatin1Char('|');
+    QStringList out;
+    for (auto it = m_dataStore.constBegin(); it != m_dataStore.constEnd(); ++it) {
+        if (it.key().startsWith(prefix)) {
+            out.append(it.key().mid(prefix.size()));
+        }
+    }
+    return out;
+}
+
+quint16 AppBridgeService::sendFrames(quint8 msgType, const QString &appId, const QString &path,
+                                     const QByteArray &payload, quint8 flags)
+{
+    if (!m_txChrc) {
+        return 0;
+    }
+
+    const QString canonical = normalizeAppId(appId);
+    if (canonical.isEmpty()) {
+        qWarning() << "AppBridge: rejecting send, app id not allowed:" << appId;
+        return 0;
+    }
+
+    const QByteArray pathBytes = path.toUtf8();
+    if (!isValidToken(pathBytes, APP_BRIDGE_MAX_PATH_LEN, true)) {
+        qWarning() << "AppBridge: rejecting send, malformed path:" << path;
+        return 0;
+    }
+    if (msgType == AB_MSG_MESSAGE) {
+        if (canonical == kCameraId && !isCameraTxAction(path)) {
+            qWarning() << "AppBridge: rejecting send, camera action not allowed:" << path;
+            return 0;
+        }
+        if (canonical == kKeyboardId && !isKeyboardTxAction(path)) {
+            qWarning() << "AppBridge: rejecting send, keyboard action not allowed:" << path;
+            return 0;
+        }
+    }
+    if (payload.size() > APP_BRIDGE_MAX_PAYLOAD) {
+        qWarning() << "AppBridge: rejecting send, payload too large:" << payload.size();
+        return 0;
+    }
+
+    const QByteArray appBytes = compactAppId(canonical);
+    const int headerOverhead = APP_BRIDGE_HEADER_FIXED + appBytes.size() + pathBytes.size();
+    const int maxChunk = qMin(APP_BRIDGE_CHUNK_SIZE, APP_BRIDGE_MAX_PACKET - headerOverhead);
+    if (maxChunk <= 0) {
+        return 0;
+    }
+
+    const int total = qMax(1, (payload.size() + maxChunk - 1) / maxChunk);
+    if (total > APP_BRIDGE_MAX_CHUNKS) {
+        return 0;
+    }
+
+    const quint16 msgId = m_nextMsgId++;
+    if (m_nextMsgId == 0) {
+        m_nextMsgId = 1;
+    }
+
+    for (int seq = 0; seq < total; ++seq) {
+        const QByteArray slice = payload.mid(seq * maxChunk, maxChunk);
+        const quint8 chunkFlags = (seq == total - 1) ? flags : static_cast<quint8>(flags & ~AB_FLAG_FIN);
+        QByteArray packet;
+        packet.reserve(headerOverhead + slice.size());
+        packet.append(static_cast<char>(APP_BRIDGE_MAGIC));
+        packet.append(static_cast<char>(APP_BRIDGE_VERSION));
+        packet.append(static_cast<char>(msgType));
+        packet.append(static_cast<char>(chunkFlags));
+        packet.append(static_cast<char>((msgId >> 8) & 0xFF));
+        packet.append(static_cast<char>(msgId & 0xFF));
+        packet.append(static_cast<char>(seq));
+        packet.append(static_cast<char>(total));
+        packet.append(static_cast<char>(appBytes.size()));
+        packet.append(appBytes);
+        packet.append(static_cast<char>(pathBytes.size()));
+        packet.append(pathBytes);
+        packet.append(slice);
+        m_txChrc->sendPacket(packet);
+    }
+    return msgId;
+}
+
+void AppBridgeService::sendControlFrame(quint8 msgType, quint16 msgId, const QByteArray &payload)
+{
+    if (!m_txChrc) {
+        return;
+    }
+    QByteArray packet;
+    packet.reserve(APP_BRIDGE_HEADER_FIXED + payload.size());
+    packet.append(static_cast<char>(APP_BRIDGE_MAGIC));
+    packet.append(static_cast<char>(APP_BRIDGE_VERSION));
+    packet.append(static_cast<char>(msgType));
+    packet.append(static_cast<char>(AB_FLAG_NONE));
+    packet.append(static_cast<char>((msgId >> 8) & 0xFF));
+    packet.append(static_cast<char>(msgId & 0xFF));
+    packet.append(static_cast<char>(0));
+    packet.append(static_cast<char>(1));
+    packet.append(static_cast<char>(0));
+    packet.append(static_cast<char>(0));
+    packet.append(payload);
+    m_txChrc->sendPacket(packet);
+}
+
+void AppBridgeService::pruneStaleReassemblies()
+{
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    for (auto it = m_reassembly.begin(); it != m_reassembly.end(); ) {
+        if (now - it.value().createdMs > 10000) {
+            it = m_reassembly.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void AppBridgeService::handleRxPacket(const QByteArray &packet)
+{
+    const int size = packet.size();
+    if (size < APP_BRIDGE_HEADER_FIXED || size > APP_BRIDGE_MAX_PACKET) {
+        qWarning() << "AppBridge: dropping packet with invalid size" << size;
+        return;
+    }
+    if (static_cast<quint8>(packet.at(0)) != APP_BRIDGE_MAGIC
+        || static_cast<quint8>(packet.at(1)) != APP_BRIDGE_VERSION) {
+        qWarning() << "AppBridge: dropping packet with unsupported header";
+        return;
+    }
+
+    const quint8 msgType = static_cast<quint8>(packet.at(2));
+    const quint8 flags = static_cast<quint8>(packet.at(3));
+    const quint16 msgId = (static_cast<quint16>(static_cast<quint8>(packet.at(4))) << 8)
+                          | static_cast<quint16>(static_cast<quint8>(packet.at(5)));
+    const quint8 seq = static_cast<quint8>(packet.at(6));
+    const quint8 total = static_cast<quint8>(packet.at(7));
+
+    if (msgType == AB_MSG_ACK) {
+        emit messageAcked(msgId);
+        return;
+    }
+    if (msgType == AB_MSG_PING) {
+        sendControlFrame(AB_MSG_PONG, msgId, packet.mid(APP_BRIDGE_HEADER_FIXED));
+        return;
+    }
+    if (msgType == AB_MSG_PONG) {
+        return;
+    }
+
+    if (total == 0 || total > APP_BRIDGE_MAX_CHUNKS || seq >= total) {
+        return;
+    }
+
+    int offset = 8;
+    const int appLen = static_cast<quint8>(packet.at(offset++));
+    if (appLen == 0 || appLen > APP_BRIDGE_MAX_APP_LEN || offset + appLen + 1 > size) {
+        return;
+    }
+    const QByteArray rawApp = packet.mid(offset, appLen);
+    offset += appLen;
+
+    const int pathLen = static_cast<quint8>(packet.at(offset++));
+    if (pathLen == 0 || pathLen > APP_BRIDGE_MAX_PATH_LEN || offset + pathLen > size) {
+        return;
+    }
+    const QByteArray rawPath = packet.mid(offset, pathLen);
+    offset += pathLen;
+
+    if (!isValidToken(rawApp, APP_BRIDGE_MAX_APP_LEN, false)
+        || !isValidToken(rawPath, APP_BRIDGE_MAX_PATH_LEN, true)) {
+        return;
+    }
+
+    const QString appId = normalizeAppId(QString::fromLatin1(rawApp));
+    if (appId.isEmpty()) {
+        return;
+    }
+    const QString path = QString::fromLatin1(rawPath);
+    const QByteArray chunkData = packet.mid(offset);
+
+    if (total == 1) {
+        if (flags & AB_FLAG_ACK_REQ) {
+            sendControlFrame(AB_MSG_ACK, msgId);
+        }
+        dispatchMessage(msgType, appId, path, chunkData);
+        return;
+    }
+
+    pruneStaleReassemblies();
+    if (!m_reassembly.contains(msgId)) {
+        if (m_reassembly.size() >= 8) {
+            return;
+        }
+        ReassemblyState st;
+        st.msgType = msgType;
+        st.appId = appId;
+        st.path = path;
+        st.total = total;
+        st.ackRequested = (flags & AB_FLAG_ACK_REQ) != 0;
+        st.chunks.resize(total);
+        st.seen.fill(false, total);
+        st.createdMs = QDateTime::currentMSecsSinceEpoch();
+        m_reassembly.insert(msgId, st);
+    }
+
+    ReassemblyState &st = m_reassembly[msgId];
+    if (st.total != total || st.msgType != msgType || st.appId != appId || st.path != path) {
+        return;
+    }
+    if (!st.seen[seq]) {
+        st.seen[seq] = true;
+        st.chunks[seq] = chunkData;
+        st.received++;
+    }
+
+    if (st.received == st.total) {
+        QByteArray assembled;
+        for (const QByteArray &c : st.chunks) {
+            assembled.append(c);
+        }
+        const bool needAck = st.ackRequested;
+        m_reassembly.remove(msgId);
+        if (needAck) {
+            sendControlFrame(AB_MSG_ACK, msgId);
+        }
+        dispatchMessage(msgType, appId, path, assembled);
+    }
+}
+
+void AppBridgeService::dispatchMessage(quint8 msgType, const QString &appId,
+                                       const QString &path, const QByteArray &payloadBytes)
+{
+    if (payloadBytes.size() > APP_BRIDGE_MAX_PAYLOAD) {
+        return;
+    }
+
+    switch (msgType) {
+    case AB_MSG_MESSAGE: {
+        if (appId == kCameraId && !isCameraRxAction(path)) {
+            qWarning() << "AppBridge: dropping unexpected camera action from phone:" << path;
+            return;
+        }
+        if (appId == kKeyboardId && !isKeyboardRxAction(path)) {
+            qWarning() << "AppBridge: dropping unexpected keyboard action from phone:" << path;
+            return;
+        }
+        emit messageReceived(appId, path, QString::fromUtf8(payloadBytes));
+        break;
+    }
+    case AB_MSG_CHAN_DATA: {
+        emit channelDataReceived(appId, path, payloadBytes);
+        break;
+    }
+    case AB_MSG_DATA_PUT: {
+        const QString val = QString::fromUtf8(payloadBytes);
+        m_dataStore.insert(dataStoreKey(appId, path), val);
+        saveDataStore();
+        emit dataItemChanged(appId, path, val);
+        break;
+    }
+    case AB_MSG_DATA_DEL: {
+        m_dataStore.remove(dataStoreKey(appId, path));
+        saveDataStore();
+        emit dataItemDeleted(appId, path);
+        break;
+    }
+    case AB_MSG_DATA_GET: {
+        const QString key = dataStoreKey(appId, path);
+        if (m_dataStore.contains(key)) {
+            sendFrames(AB_MSG_DATA_PUT, appId, path, m_dataStore.value(key).toUtf8(), AB_FLAG_NONE);
+        }
+        break;
+    }
+    case AB_MSG_CAP_QUERY: {
+        QJsonObject resp;
+        resp.insert(QStringLiteral("version"), APP_BRIDGE_VERSION);
+        resp.insert(QStringLiteral("capabilities"), QJsonArray::fromStringList(localWatchCapabilities()));
+        sendFrames(AB_MSG_CAP_RESP, kSystemId, QStringLiteral("/capabilities"),
+                   QJsonDocument(resp).toJson(QJsonDocument::Compact), AB_FLAG_NONE);
+        break;
+    }
+    case AB_MSG_CAP_RESP: {
+        const QJsonDocument doc = QJsonDocument::fromJson(payloadBytes);
+        if (doc.isObject()) {
+            QStringList caps;
+            const QJsonArray arr = doc.object().value(QStringLiteral("capabilities")).toArray();
+            for (const QJsonValue &v : arr) {
+                if (v.isString()) {
+                    caps.append(v.toString());
+                }
+            }
+            m_peerCapabilities = caps;
+            emit peerCapabilitiesChanged(m_peerCapabilities);
+        }
+        break;
+    }
+    default:
+        qDebug() << "AppBridge: ignoring unknown/future msgType" << msgType;
+        break;
+    }
+}
diff --git a/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h
new file mode 100644
index 00000000..a6d63fe1
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/appbridgeservice.h
@@ -0,0 +1,178 @@
+/*
+ * Copyright (C) 2026 AsteroidOS
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef APPBRIDGESERVICE_H
+#define APPBRIDGESERVICE_H
+
+#include <QObject>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QHash>
+#include <QMap>
+#include <QStringList>
+#include <QVector>
+#include "service.h"
+#include "characteristic.h"
+#include "common.h"
+
+/*
+ * AppBridge v2 Wire Protocol (inspired by Wear OS MessageClient, DataClient,
+ * CapabilityClient, and ChannelClient):
+ *
+ *   [0]     magic    = 0xA1
+ *   [1]     version  = 0x02  (explicit protocol version for future expansion)
+ *   [2]     msgType  = 0x01 MESSAGE | 0x02 DATA_PUT | 0x03 DATA_DEL | 0x04 DATA_GET
+ *                    | 0x05 CAP_QUERY | 0x06 CAP_RESP | 0x07 CHAN_DATA
+ *                    | 0x08 ACK | 0x09 PING | 0x0A PONG | 0x0B..0xFF reserved
+ *   [3]     flags    = bit0: ACK_REQ (0x01), bit1: FIN (0x02), bits2..7: reserved
+ *   [4..5]  msgId    = uint16 big-endian
+ *   [6]     seq      = chunk index (0 .. total-1)
+ *   [7]     total    = total chunks (1 .. 32)
+ *   [8]     appLen   = 0..64 (0 for control frames like ACK/PING/PONG)
+ *   [...]   appId    (UTF-8 channel ID)
+ *   [...]   pathLen  = 0..128
+ *   [...]   path     (UTF-8 action or URI path, e.g. "capture", "/settings", "/sync_bundle")
+ *   [...]   payload  (chunk bytes; reassembled up to APP_BRIDGE_MAX_PAYLOAD)
+ */
+#define APP_BRIDGE_MAGIC          0xA1
+#define APP_BRIDGE_VERSION        0x02
+#define APP_BRIDGE_HEADER_FIXED   10
+#define APP_BRIDGE_MAX_PACKET     512
+#define APP_BRIDGE_MAX_APP_LEN    64
+#define APP_BRIDGE_MAX_PATH_LEN   128
+#define APP_BRIDGE_MAX_CHUNKS     32
+#define APP_BRIDGE_CHUNK_SIZE     384
+#define APP_BRIDGE_MAX_PAYLOAD    (APP_BRIDGE_MAX_CHUNKS * APP_BRIDGE_CHUNK_SIZE)
+
+enum AppBridgeMsgType : quint8 {
+    AB_MSG_MESSAGE   = 0x01,
+    AB_MSG_DATA_PUT  = 0x02,
+    AB_MSG_DATA_DEL  = 0x03,
+    AB_MSG_DATA_GET  = 0x04,
+    AB_MSG_CAP_QUERY = 0x05,
+    AB_MSG_CAP_RESP  = 0x06,
+    AB_MSG_CHAN_DATA = 0x07,
+    AB_MSG_ACK       = 0x08,
+    AB_MSG_PING      = 0x09,
+    AB_MSG_PONG      = 0x0A,
+};
+
+enum AppBridgeFlags : quint8 {
+    AB_FLAG_NONE    = 0x00,
+    AB_FLAG_ACK_REQ = 0x01,
+    AB_FLAG_FIN     = 0x02,
+};
+
+class AppBridgeService;
+
+// TX characteristic: Watch -> Phone notifications
+class AppBridgeTxChrc : public Characteristic
+{
+    Q_OBJECT
+    Q_PROPERTY(QByteArray Value READ getValue NOTIFY valueChanged)
+public:
+    AppBridgeTxChrc(QDBusConnection bus, int index, Service *service);
+
+public slots:
+    QByteArray ReadValue(QVariantMap) { return m_value; }
+    void StartNotify() {}
+    void StopNotify() {}
+    void sendPacket(const QByteArray &packet);
+
+signals:
+    void valueChanged();
+
+private:
+    QByteArray m_value;
+    QByteArray getValue() { return m_value; }
+    void emitPropertiesChanged();
+};
+
+// RX characteristic: Phone -> Watch writes
+class AppBridgeRxChrc : public Characteristic
+{
+    Q_OBJECT
+public:
+    AppBridgeRxChrc(QDBusConnection bus, int index, AppBridgeService *service);
+
+public slots:
+    void WriteValue(QByteArray value, QVariantMap);
+
+private:
+    AppBridgeService *m_service;
+};
+
+class AppBridgeService : public Service
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.asteroidos.btsyncd.AppBridge")
+public:
+    explicit AppBridgeService(int index, QDBusConnection bus, QObject *parent = nullptr);
+
+    void handleRxPacket(const QByteArray &packet);
+
+public slots:
+    // MessageClient-style RPC
+    void sendMessage(const QString &appId, const QString &path, const QString &payload);
+    void sendBytes(const QString &appId, const QString &path, const QByteArray &payload);
+    quint16 sendReliableMessage(const QString &appId, const QString &path, const QString &payload);
+
+    // ChannelClient-style bulk stream (like Stratum's WearQueryService sync bundle)
+    quint16 sendChannelData(const QString &appId, const QString &path, const QByteArray &payload);
+
+    // CapabilityClient-style discovery
+    void queryCapabilities();
+    QStringList peerCapabilities() const { return m_peerCapabilities; }
+
+    // DataClient / Horologist DataStore-style offline-first persisted key-value sync
+    void putDataItem(const QString &appId, const QString &path, const QString &payload);
+    QString getDataItem(const QString &appId, const QString &path) const;
+    void requestDataItem(const QString &appId, const QString &path);
+    void deleteDataItem(const QString &appId, const QString &path);
+    QStringList listDataItems(const QString &appId) const;
+
+signals:
+    void messageReceived(const QString &appId, const QString &path, const QString &payload);
+    void channelDataReceived(const QString &appId, const QString &path, const QByteArray &payload);
+    void messageAcked(quint16 msgId);
+    void dataItemChanged(const QString &appId, const QString &path, const QString &payload);
+    void dataItemDeleted(const QString &appId, const QString &path);
+    void peerCapabilitiesChanged(const QStringList &capabilities);
+
+private:
+    struct ReassemblyState {
+        quint8 msgType = 0;
+        QString appId;
+        QString path;
+        quint8 total = 0;
+        quint8 received = 0;
+        bool ackRequested = false;
+        QVector<QByteArray> chunks;
+        QVector<bool> seen;
+        qint64 createdMs = 0;
+    };
+
+    quint16 sendFrames(quint8 msgType, const QString &appId, const QString &path,
+                       const QByteArray &payload, quint8 flags);
+    void sendControlFrame(quint8 msgType, quint16 msgId, const QByteArray &payload = QByteArray());
+    void dispatchMessage(quint8 msgType, const QString &appId, const QString &path, const QByteArray &payloadBytes);
+    void pruneStaleReassemblies();
+    void loadDataStore();
+    void saveDataStore() const;
+    static QString dataStoreKey(const QString &appId, const QString &path);
+
+    AppBridgeTxChrc *m_txChrc;
+    AppBridgeRxChrc *m_rxChrc;
+    quint16 m_nextMsgId = 1;
+    QHash<quint16, ReassemblyState> m_reassembly;
+    QMap<QString, QString> m_dataStore; /* "<appId>|<path>" -> payload */
+    QStringList m_peerCapabilities;
+};
+
+#endif // APPBRIDGESERVICE_H
diff --git a/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh b/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh
new file mode 100644
index 00000000..843b7162
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/camera-shutter.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# Ask the paired phone camera to perform one of the allowlisted remote actions.
+set -eu
+
+DEST="org.asteroidos.btsyncd"
+OBJECT="/org/asteroidos/btsyncd/appbridge"
+INTERFACE="org.asteroidos.btsyncd.AppBridge"
+ACTION="${1:-capture}"
+
+case "$ACTION" in
+    capture | flip | zoom_in | zoom_out | torch | mode_photo | mode_video | status_query) ;;
+    *)
+        echo "camera-shutter: unsupported action '$ACTION'" >&2
+        echo "usage: camera-shutter [capture|flip|zoom_in|zoom_out|torch|mode_photo|mode_video|status_query]" >&2
+        exit 2
+        ;;
+esac
+
+exec busctl --system call "$DEST" "$OBJECT" "$INTERFACE" sendMessage sss "org.asteroidos.camera" "$ACTION" ""
diff --git a/overlay/asteroidos/asteroid-btsyncd/default.nix b/overlay/asteroidos/asteroid-btsyncd/default.nix
new file mode 100644
index 0000000..1f92795
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/default.nix
@@ -0,0 +1,82 @@
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  cmake,
+  pkg-config,
+  systemd,
+  qt6,
+  qml-asteroid,
+  amber-mpris,
+  mlite,
+  kdePackages,
+  buildPackages,
+}:
+
+let
+  isCross = !stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+in
+stdenv.mkDerivation {
+  pname = "asteroid-btsyncd";
+  version = "nightly";
+
+  src = fetchFromGitHub {
+    owner = "AsteroidOS";
+    repo = "asteroid-btsyncd";
+    rev = "e14fbcd9a157f0988204e874b03f6f800f89d645";
+    hash = "sha256-TEZ0hc7HmoTW+YVhqfM75AwfXpmmuNOCRP+dgPxod5c=";
+  };
+
+  strictDeps = true;
+
+  # AsteroidOS Bluetooth synchronization daemon
+  # Upstream repository: https://github.com/AsteroidOS/asteroid-btsyncd
+  # Companion phone app protocol (Gadgetbridge): https://codeberg.org/Freeyourgadget/Gadgetbridge
+  patches = [
+    # Generic App Bridge GATT service and D-Bus interface for remote camera and sensor sync
+    ./app-bridge.patch
+  ];
+
+  postPatch = ''
+    cp ${./appbridgeservice.h} src/appbridgeservice.h
+    cp ${./appbridgeservice.cpp} src/appbridgeservice.cpp
+  '';
+
+  nativeBuildInputs = [
+    cmake
+    kdePackages.extra-cmake-modules
+    pkg-config
+    qt6.wrapQtAppsHook
+  ];
+
+  cmakeFlags = [
+    "-DECM_DIR=${kdePackages.extra-cmake-modules}/share/ECM/cmake"
+  ]
+  ++ lib.optionals isCross [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+    "-DQt6ShaderToolsTools_DIR=${buildPackages.qt6.qtshadertools}/lib/cmake/Qt6ShaderToolsTools"
+    "-DQt6LinguistTools_DIR=${buildPackages.qt6.qttools}/lib/cmake/Qt6LinguistTools"
+  ];
+
+  buildInputs = [
+    systemd
+    qt6.qtbase
+    qt6.qtdeclarative
+    qml-asteroid
+    amber-mpris
+    mlite
+  ];
+
+  postInstall = ''
+    install -Dm755 ${./camera-shutter.sh} $out/bin/camera-shutter
+    install -Dm644 ${./org.asteroidos.btsyncd.conf} $out/share/dbus-1/system.d/org.asteroidos.btsyncd.conf
+  '';
+
+  meta = with lib; {
+    description = "Bluetooth Low Energy synchronization daemon for AsteroidOS";
+    homepage = "https://asteroidos.org/";
+    license = licenses.gpl3Plus;
+    platforms = platforms.linux;
+  };
+}
diff --git a/overlay/asteroidos/asteroid-btsyncd/org.asteroidos.btsyncd.conf b/overlay/asteroidos/asteroid-btsyncd/org.asteroidos.btsyncd.conf
new file mode 100644
index 00000000..6a5592d0
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/org.asteroidos.btsyncd.conf
@@ -0,0 +1,16 @@
+<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
+ "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
+<busconfig>
+  <!-- Deny by default: only root and the unprivileged watch session user
+       (ceres, which runs asteroid-btsyncd and the apps) may talk to btsyncd. -->
+  <policy user="root">
+    <allow own="org.asteroidos.btsyncd"/>
+    <allow send_destination="org.asteroidos.btsyncd"/>
+    <allow receive_sender="org.asteroidos.btsyncd"/>
+  </policy>
+  <policy user="ceres">
+    <allow own="org.asteroidos.btsyncd"/>
+    <allow send_destination="org.asteroidos.btsyncd"/>
+    <allow receive_sender="org.asteroidos.btsyncd"/>
+  </policy>
+</busconfig>
