+void RemoteCameraBridge::applyStatePayload(const QString &payload)
+{
+    if (payload.isEmpty()) {
+        return;
+    }
+    const QJsonDocument doc = QJsonDocument::fromJson(payload.toUtf8());
+    if (!doc.isObject()) {
+        return;
+    }
+    const QJsonObject obj = doc.object();
+    bool changed = false;
+
+    if (obj.contains(QStringLiteral("mode"))) {
+        const QString mode = obj.value(QStringLiteral("mode")).toString();
+        if (!mode.isEmpty() && mode != m_cameraMode) {
+            m_cameraMode = mode;
+            changed = true;
+        }
+    }
+    if (obj.contains(QStringLiteral("facing"))) {
+        const QString facing = obj.value(QStringLiteral("facing")).toString();
+        if (!facing.isEmpty() && facing != m_cameraFacing) {
+            m_cameraFacing = facing;
+            changed = true;
+        }
+    }
+    if (obj.contains(QStringLiteral("zoom"))) {
+        const double zoom = obj.value(QStringLiteral("zoom")).toDouble(m_zoomRatio);
+        if (zoom > 0.0 && !qFuzzyCompare(zoom, m_zoomRatio)) {
+            m_zoomRatio = zoom;
+            changed = true;
+        }
+    }
+    if (obj.contains(QStringLiteral("torch"))) {
+        const bool torch = obj.value(QStringLiteral("torch")).toBool(m_torchOn);
+        if (torch != m_torchOn) {
+            m_torchOn = torch;
+            changed = true;
+        }
+    }
+    if (obj.contains(QStringLiteral("recording"))) {
+        const bool rec = obj.value(QStringLiteral("recording")).toBool(m_isRecording);
+        if (rec != m_isRecording) {
+            m_isRecording = rec;
+            changed = true;
+        }
+    }
+
+    if (changed) {
+        emit cameraStateChanged();
+    }
+}
