+        wifi_ps_tr="Wi-Fi power save"
+        wifi_to_tr="Wi-Fi idle timeout"
+        remcha_tr="Disconnect charger alert"
+        wifi_forget_title_tr="Forget network?"
+        wifi_forget_body_tr="You will need to re-enter the password to reconnect."
         case "$f" in
-          *zh_Hant*) conn_tr="已連線"; disc_tr="未連線"; getting_ip_tr="正在取得 IP 位址..." ;;
-          *zh_Hans*) conn_tr="已连接"; disc_tr="未连接"; getting_ip_tr="正在获取 IP 地址..." ;;
+          *zh_Hant*) conn_tr="已連線"; disc_tr="未連線"; getting_ip_tr="正在取得 IP 位址..."; wifi_ps_tr="Wi-Fi 省電模式"; wifi_to_tr="Wi-Fi 閒置關閉時間"; remcha_tr="拔除充電器提醒"; wifi_forget_title_tr="忘記此網路？"; wifi_forget_body_tr="重新連線時需要再次輸入密碼。" ;;
