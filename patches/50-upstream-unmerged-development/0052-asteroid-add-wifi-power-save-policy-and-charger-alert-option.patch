++void WifiPowerManager::refreshDesktopIndex()
++{
++    m_execNeedsWifi.clear();
++    QStringList dirs = QStandardPaths::standardLocations(QStandardPaths::ApplicationsLocation);
++    const QString nixApps = QStringLiteral("/run/current-system/sw/share/applications");
++    if (!dirs.contains(nixApps)) dirs.prepend(nixApps);
++
++    for (const QString &dirPath : dirs) {
++        const QDir dir(dirPath);
++        if (!dir.exists()) continue;
++        for (const QString &fileName : dir.entryList({QStringLiteral("*.desktop")}, QDir::Files)) {
++            QSettings desktop(dir.filePath(fileName), QSettings::IniFormat);
++            desktop.beginGroup(QStringLiteral("Desktop Entry"));
++            const QString needsStr = desktop.value(QStringLiteral("X-Asteroid-NeedsWifi")).toString().trimmed();
++            const bool needs = (needsStr.compare(QStringLiteral("true"), Qt::CaseInsensitive) == 0
++                                || needsStr == QStringLiteral("1"));
++            const QString execLine = desktop.value(QStringLiteral("Exec")).toString();
++            desktop.endGroup();
++
++            const QString stem = fileName.endsWith(QStringLiteral(".desktop"))
++                ? fileName.left(fileName.size() - 8)
++                : fileName;
++            if (!stem.isEmpty()) {
++                m_execNeedsWifi.insert(stem, needs);
++            }
++            const QStringList tokens = QProcess::splitCommand(execLine);
++            for (const QString &tok : tokens) {
++                if (tok.isEmpty() || tok.startsWith(QLatin1Char('-')) || tok.startsWith(QLatin1Char('%'))) {
++                    continue;
++                }
++                const QString norm = normalizeExecName(tok);
++                if (norm == QStringLiteral("invoker") || norm == QStringLiteral("env")) {
++                    continue;
++                }
++                if (!norm.isEmpty()) {
++                    m_execNeedsWifi.insert(norm, needs);
++                }
++            }
++        }
++    }
++}
++
++bool WifiPowerManager::processNeedsWifi(qint64 pid)
++{
++    if (m_execNeedsWifi.isEmpty()) {
++        refreshDesktopIndex();
++    }
++    QFile cmdlineFile(QStringLiteral("/proc/%1/cmdline").arg(pid));
++    if (cmdlineFile.open(QIODevice::ReadOnly)) {
++        const QList<QByteArray> parts = cmdlineFile.readAll().split('\0');
++        for (const QByteArray &part : parts) {
++            if (part.isEmpty() || part.startsWith('-')) continue;
++            const QString norm = normalizeExecName(QString::fromUtf8(part));
++            if (m_execNeedsWifi.contains(norm)) {
++                return m_execNeedsWifi.value(norm);
++            }
++        }
++    }
++    QFile commFile(QStringLiteral("/proc/%1/comm").arg(pid));
++    if (commFile.open(QIODevice::ReadOnly)) {
++        const QString comm = normalizeExecName(QString::fromUtf8(commFile.readAll()).trimmed());
++        if (m_execNeedsWifi.contains(comm)) {
++            return m_execNeedsWifi.value(comm);
++        }
++    }
++    return false;
++}
