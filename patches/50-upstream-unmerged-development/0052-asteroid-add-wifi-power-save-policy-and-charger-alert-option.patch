++QString WifiPowerManager::normalizeExecName(const QString &raw)
++{
++    QString base = QFileInfo(raw.trimmed()).fileName();
++    // Strip Nix wrapQtAppsHook wrapper prefix/suffix (".foo-wrapped" -> "foo")
++    if (base.startsWith(QLatin1Char('.')) && base.endsWith(QStringLiteral("-wrapped"))) {
++        base = base.mid(1, base.size() - 9);
++    }
++    return base;
++}
