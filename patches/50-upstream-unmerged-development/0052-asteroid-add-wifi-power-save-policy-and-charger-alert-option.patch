+diff --git a/src/wifipowerpolicy.h b/src/wifipowerpolicy.h
+new file mode 100644
+index 0000000..e9a5aad
+--- /dev/null
++++ b/src/wifipowerpolicy.h
+@@ -0,0 +1,122 @@
++// SPDX-License-Identifier: GPL-3.0-or-later
++/*
++ * Copyright (C) 2026 AsteroidOS / Matawaa
++ *
++ * Pure state machine for the Wi-Fi power-save policy:
++ *  - Enabled by default.
++ *  - Enables Wi-Fi while charging.
++ *  - Enables Wi-Fi while an app declaring X-Asteroid-NeedsWifi=true is active.
++ *  - On battery, shuts down Wi-Fi after an idle timeout once no Wi-Fi-needing
++ *    app is active (including after unplugging or manual Wi-Fi enable).
++ */
++#pragma once
++
++struct WifiPolicyDecision {
++    enum class WifiAction { None, EnableWifi, DisableWifi };
++    WifiAction wifiAction = WifiAction::None;
++    bool startIdleTimer = false;
++    bool stopIdleTimer = false;
++};
++
++class WifiPowerPolicy {
++public:
++    bool policyEnabled() const { return m_policyEnabled; }
++    int idleTimeoutSec() const { return m_idleTimeoutSec; }
++    bool isCharging() const { return m_charging; }
++    bool isWifiPowered() const { return m_wifiPowered; }
++    bool isWifiAppActive() const { return m_wifiAppActive; }
++    bool isIdleTimerRunning() const { return m_idleTimerRunning; }
++
++    void setIdleTimeoutSec(int sec)
++    {
++        m_idleTimeoutSec = (sec < 10) ? 10 : sec;
++    }
++
++    WifiPolicyDecision onPolicyEnabledChanged(bool enabled)
++    {
++        WifiPolicyDecision d;
++        m_policyEnabled = enabled;
++        if (!m_policyEnabled) {
++            if (m_idleTimerRunning) {
++                m_idleTimerRunning = false;
++                d.stopIdleTimer = true;
++            }
++            return d;
++        }
++        return evaluateState();
++    }
++
++    WifiPolicyDecision onChargingChanged(bool charging)
++    {
++        m_charging = charging;
++        if (!m_policyEnabled) return {};
++        return evaluateState();
++    }
++
++    WifiPolicyDecision onWifiAppActiveChanged(bool active)
++    {
++        m_wifiAppActive = active;
++        if (!m_policyEnabled) return {};
++        return evaluateState();
++    }
++
++    WifiPolicyDecision onWifiPoweredChanged(bool powered)
++    {
++        WifiPolicyDecision d;
++        m_wifiPowered = powered;
++        if (!m_policyEnabled) return d;
++        if (!m_wifiPowered) {
++            if (m_idleTimerRunning) {
++                m_idleTimerRunning = false;
++                d.stopIdleTimer = true;
++            }
++            return d;
++        }
++        // Wi-Fi is now on: if on battery with no Wi-Fi app active, start idle countdown.
++        if (!m_charging && !m_wifiAppActive && !m_idleTimerRunning) {
++            m_idleTimerRunning = true;
++            d.startIdleTimer = true;
++        }
++        return d;
++    }
++
++    WifiPolicyDecision onIdleTimerExpired()
++    {
++        WifiPolicyDecision d;
++        m_idleTimerRunning = false;
++        if (!m_policyEnabled || m_charging || m_wifiAppActive || !m_wifiPowered) {
++            return d;
++        }
++        d.wifiAction = WifiPolicyDecision::WifiAction::DisableWifi;
++        return d;
++    }
++
++private:
++    WifiPolicyDecision evaluateState()
++    {
++        WifiPolicyDecision d;
++        if (m_charging || m_wifiAppActive) {
++            if (m_idleTimerRunning) {
++                m_idleTimerRunning = false;
++                d.stopIdleTimer = true;
++            }
++            if (!m_wifiPowered) {
++                d.wifiAction = WifiPolicyDecision::WifiAction::EnableWifi;
++            }
++            return d;
++        }
++        // On battery and no Wi-Fi-needing app is active.
++        if (m_wifiPowered && !m_idleTimerRunning) {
++            m_idleTimerRunning = true;
++            d.startIdleTimer = true;
++        }
++        return d;
++    }
++
++    bool m_policyEnabled = true;
++    int m_idleTimeoutSec = 300;
++    bool m_charging = false;
++    bool m_wifiPowered = false;
++    bool m_wifiAppActive = false;
++    bool m_idleTimerRunning = false;
++};
