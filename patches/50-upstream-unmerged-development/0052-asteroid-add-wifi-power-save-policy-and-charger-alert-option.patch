         esac
         for entry in \
           "id-connected|Connected|$conn_tr" \
           "id-disconnected|Not connected|$disc_tr" \
           "id-wifi-ip-address|IP: %1|$ip_tr" \
-          "id-wifi-getting-ip|Getting IP address...|$getting_ip_tr"; do
+          "id-wifi-getting-ip|Getting IP address...|$getting_ip_tr" \
+          "id-wifi-power-save|Wi-Fi power save|$wifi_ps_tr" \
+          "id-wifi-idle-timeout|Wi-Fi idle timeout|$wifi_to_tr" \
+          "id-show-remove-charger-alert|Disconnect charger alert|$remcha_tr" \
+          "id-wifi-forget-confirm-title|Forget network?|$wifi_forget_title_tr" \
+          "id-wifi-forget-confirm-body|You will need to re-enter the password to reconnect.|$wifi_forget_body_tr"; do
           IFS='|' read -r msg_id msg_src msg_tr <<< "$entry"
           if ! grep -q "id=\"$msg_id\"" "$f"; then
             sed -i "s|</context>|    <message id=\"$msg_id\"><source>$msg_src</source><translation>$msg_tr</translation></message>\n</context>|" "$f"
