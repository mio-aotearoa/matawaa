++        ep.stage = parts[1].toInt();
++        if (parts.size() >= 3) ep.motionMilli = parts[2].toInt();
++        if (parts.size() >= 4) ep.bpm = parts[3].toInt();
++        out.append(ep);
++    }
++    return out;
++}
