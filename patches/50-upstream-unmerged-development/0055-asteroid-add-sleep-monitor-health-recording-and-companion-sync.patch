++    res.insert(QStringLiteral("wakeTime"), lastSleepTs > 0
++               ? QDateTime::fromSecsSinceEpoch(lastSleepTs).toString(QStringLiteral("HH:mm"))
++               : QStringLiteral("--:--"));
++    res.insert(QStringLiteral("timeline"), timeline);
++    return res;
++}
