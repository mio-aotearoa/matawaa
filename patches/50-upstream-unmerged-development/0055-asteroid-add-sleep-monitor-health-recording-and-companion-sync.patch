++        const double qualityScore = qMin(1.0, deepRatio / 0.35) * 35.0;
++        score = qBound(1, qRound(durScore + qualityScore), 100);
++    }
++
++    QVariantMap res;
++    res.insert(QStringLiteral("hasData"), !overnight.isEmpty());
