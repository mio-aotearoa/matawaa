++void SleepMonitorPlugin::timeUpdate()
++{
++    const qint64 elapsed = QDateTime::currentMSecsSinceEpoch() - lastRecordTime.toMSecsSinceEpoch();
++    if (elapsed >= interval) {
++        triggerRecording();
++    } else {
++        recordIntervalTimer->start(static_cast<int>(interval - elapsed));
++    }
++}
++
++void SleepMonitorPlugin::triggerRecording()
++{
++    recordIntervalTimer->start(interval);
++    if (samplingActive) {
++        return;
++    }
++
++    samplingActive = true;
++    magSamples.clear();
++    latestBpm = 0;
++
++    if (stepSensor->start()) {
++        if (auto *sr = stepSensor->reading()) {
++            epochStartSteps = sr->steps();
++        }
++    }
++    accelSensor->start();
++    hrmSensor->start();
++
++    accelSampleTimer->start();
++    // 4-second actigraphy + HR sampling window
++    sampleWindowTimer->start(4000);
++}
++
++void SleepMonitorPlugin::sampleAccel()
++{
++    if (!accelSensor->isActive()) {
++        return;
++    }
++    if (auto *r = accelSensor->reading()) {
++        const double mag = qSqrt(r->x() * r->x() + r->y() * r->y() + r->z() * r->z());
++        magSamples.append(mag);
++    }
++}
++
++void SleepMonitorPlugin::onHrmChanged()
++{
++    if (auto *r = hrmSensor->reading()) {
++        if (r->bpm() > 25 && hrmSensor->status() >= 3) {
++            latestBpm = r->bpm();
++        }
++    }
++}
++
++void SleepMonitorPlugin::finalizeEpoch()
++{
++    accelSampleTimer->stop();
++    accelSensor->stop();
++    hrmSensor->stop();
++
++    int stepsDelta = 0;
++    if (stepSensor->isActive()) {
++        if (auto *sr = stepSensor->reading()) {
++            const int curSteps = sr->steps();
++            if (lastStepCount >= 0 && curSteps >= lastStepCount) {
++                stepsDelta = curSteps - lastStepCount;
++            }
++            lastStepCount = curSteps;
++        }
++        stepSensor->stop();
++    }
++
++    // Compute mean absolute deviation of acceleration magnitude (m/s^2)
++    double motionVar = 0.0;
++    if (magSamples.size() >= 2) {
++        double mean = 0.0;
++        for (double v : magSamples) {
++            mean += v;
++        }
++        mean /= magSamples.size();
++        double mad = 0.0;
++        for (double v : magSamples) {
++            mad += qAbs(v - mean);
++        }
++        motionVar = mad / magSamples.size();
++    }
++
++    // Update resting HR baseline during low-motion epochs
++    if (latestBpm > 25 && motionVar < 0.25 && stepsDelta == 0) {
++        restingBpmEma = restingBpmEma * 0.9 + static_cast<double>(latestBpm) * 0.1;
++    }
++
++    SleepStage stage = Awake;
++    if (stepsDelta > 0 || motionVar >= 0.45) {
++        stage = Awake;
++    } else if (motionVar >= 0.08) {
++        stage = LightSleep;
++    } else if (latestBpm > 0 && static_cast<double>(latestBpm) > restingBpmEma + 6.0) {
++        stage = RemSleep;
++    } else {
++        stage = DeepSleep;
++    }
++
++    const int motionMilli = qRound(motionVar * 1000.0);
++    const QString record = QStringLiteral("%1:%2:%3")
++                               .arg(static_cast<int>(stage))
++                               .arg(motionMilli)
++                               .arg(latestBpm);
++    fileAddRecord(sensorPathPrefix, record);
++    lastRecordTime = QDateTime::currentDateTime();
++    samplingActive = false;
++    emit recordWritten();
++}
