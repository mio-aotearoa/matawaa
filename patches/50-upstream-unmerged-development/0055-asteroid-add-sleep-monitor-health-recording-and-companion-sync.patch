++QVariant SleepDataLoader::getSleepSummary(QDate date)
++{
++    QSettings settings(QStringLiteral("asteroid"), QStringLiteral("sensorlogd"));
++    const int epochMinutes = qMax(1, settings.value(QStringLiteral("sleepMonitor/interval"), 300000).toInt() / 60000);
++    const int goalMinutes = qMax(60, settings.value(QStringLiteral("sleepMonitor/goalMinutes"), 480).toInt());
++
++    // Overnight window: yesterday 20:00 -> date 12:00
++    const qint64 winStart = QDateTime(date.addDays(-1), QTime(20, 0)).toSecsSinceEpoch();
++    const qint64 winEnd = QDateTime(date, QTime(12, 0)).toSecsSinceEpoch();
++
++    QVector<SleepEpoch> overnight;
++    for (const auto &ep : readEpochsForDate(date.addDays(-1))) {
++        if (ep.timestamp >= winStart && ep.timestamp <= winEnd) {
++            overnight.append(ep);
++        }
++    }
++    for (const auto &ep : readEpochsForDate(date)) {
++        if (ep.timestamp >= winStart && ep.timestamp <= winEnd) {
++            overnight.append(ep);
++        }
++    }
++
++    int awakeMin = 0, lightMin = 0, deepMin = 0, remMin = 0;
++    qint64 firstSleepTs = 0, lastSleepTs = 0;
++    QVariantList timeline;
++
++    for (const auto &ep : overnight) {
++        QVariantMap item;
++        item.insert(QStringLiteral("timestamp"), ep.timestamp);
++        item.insert(QStringLiteral("stage"), ep.stage);
++        item.insert(QStringLiteral("bpm"), ep.bpm);
++        timeline.append(item);
++
++        if (ep.stage == 0) {
++            awakeMin += epochMinutes;
++        } else {
++            if (firstSleepTs == 0) firstSleepTs = ep.timestamp;
++            lastSleepTs = ep.timestamp;
++            if (ep.stage == 1) lightMin += epochMinutes;
++            else if (ep.stage == 2) deepMin += epochMinutes;
++            else if (ep.stage == 3) remMin += epochMinutes;
++        }
++    }
++
++    const int totalSleepMin = lightMin + deepMin + remMin;
