++void Logger::syncHealthSummary() {
++    auto lastVal = [](const QString &prefix) -> QString {
++        QFile f(fileNameForDate(QDate::currentDate(), prefix));
++        if (!f.open(QIODevice::ReadOnly | QIODevice::Text)) return {};
++        QString last;
++        QTextStream in(&f);
++        while (!in.atEnd()) {
++            const QString line = in.readLine().trimmed();
++            if (!line.isEmpty()) last = line;
++        }
++        return last;
++    };
++
++    QJsonObject obj;
++    obj.insert(QStringLiteral("date"), QDate::currentDate().toString(Qt::ISODate));
++    obj.insert(QStringLiteral("updated"), QDateTime::currentSecsSinceEpoch());
++    const QString hr = lastVal(QStringLiteral("heartrateMonitor"));
