diff --git a/overlay/asteroidos/extreme-battery-saver/controller-test.cpp b/overlay/asteroidos/extreme-battery-saver/controller-test.cpp
new file mode 100644
index 00000000..1a740542
--- /dev/null
+++ b/overlay/asteroidos/extreme-battery-saver/controller-test.cpp
@@ -0,0 +1,69 @@
+#include <QtTest>
+#include "controller.h"
+
+class MockDisplay : public QObject {
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.asteroid.SecondDisplay.Display")
+    Q_PROPERTY(uint Capabilities READ capabilities)
+public:
+    uint caps = 0;
+    int calls = 0;
+    bool powerOff = false;
+    bool result = false;
+    uint capabilities() const { return caps; }
+public slots:
+    bool EnterTimepieceMode(bool requestedPowerOff) {
+        ++calls;
+        powerOff = requestedPowerOff;
+        return result;
+    }
+};
+
+class ControllerTest : public QObject {
+    Q_OBJECT
+private slots:
+    void explicitActivationOnly() {
+        auto bus = QDBusConnection::sessionBus();
+        QVERIFY(bus.isConnected());
+        MockDisplay display;
+        QVERIFY(bus.registerService("org.asteroid.SecondDisplay"));
+        QVERIFY(bus.registerObject("/Display", &display,
+            QDBusConnection::ExportAllProperties | QDBusConnection::ExportAllSlots));
+        SaverController saver;
+        saver.activate();
+        QCOMPARE(display.calls, 0);
+        saver.check();
+        QTRY_VERIFY(!saver.busy());
+        QVERIFY(!saver.ready());
+        saver.activate();
+        QCOMPARE(display.calls, 0);
+        display.caps = 3;
+        saver.check();
+        QTRY_VERIFY(!saver.busy());
+        QVERIFY(saver.ready());
+        QCOMPARE(display.calls, 0);
+        saver.activate();
+        saver.activate(); // A double tap must not issue a second handoff.
+        QTRY_VERIFY(!saver.busy());
+        QCOMPARE(display.calls, 1);
+        QVERIFY(display.powerOff);
+        QVERIFY(saver.status().contains("Could not enter"));
+        QVERIFY(!saver.ready());
+        display.result = true;
+        saver.check();
+        QTRY_VERIFY(!saver.busy());
+        QVERIFY(saver.ready());
+        saver.activate();
+        QTRY_VERIFY(!saver.busy());
+        QCOMPARE(display.calls, 2);
+        QVERIFY(saver.status().contains("Shutting down"));
+        bus.unregisterObject("/Display");
+        bus.unregisterService("org.asteroid.SecondDisplay");
+        saver.check();
+        QTRY_VERIFY(!saver.busy());
+        QVERIFY(!saver.ready());
+        QVERIFY(saver.status().contains("unavailable"));
+    }
+};
+QTEST_GUILESS_MAIN(ControllerTest)
+#include "controller-test.moc"
diff --git a/overlay/asteroidos/extreme-battery-saver/controller.h b/overlay/asteroidos/extreme-battery-saver/controller.h
new file mode 100644
index 00000000..c54fea2a
--- /dev/null
+++ b/overlay/asteroidos/extreme-battery-saver/controller.h
@@ -0,0 +1,70 @@
+#pragma once
+#include <QObject>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusVariant>
+#include <QDebug>
+
+class SaverController : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(bool ready READ ready NOTIFY changed)
+    Q_PROPERTY(bool busy READ busy NOTIFY changed)
+    Q_PROPERTY(QString status READ status NOTIFY changed)
+public:
+    using QObject::QObject;
+    bool ready() const { return m_ready; }
+    bool busy() const { return m_busy; }
+    QString status() const { return m_status; }
+
+    Q_INVOKABLE void check() {
+        if (m_busy) return;
+        m_ready = false;
+        m_busy = true;
+        m_status = tr("Checking timepiece support…");
+        emit changed();
+        auto message = QDBusMessage::createMethodCall("org.asteroid.SecondDisplay", "/Display",
+            "org.freedesktop.DBus.Properties", "Get");
+        message.setArguments({"org.asteroid.SecondDisplay.Display", "Capabilities"});
+        auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message, 10000), this);
+        connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, watcher] {
+            QDBusPendingReply<QDBusVariant> reply = *watcher;
+            // TimepieceMode is bit 1 in the upstream SecondDisplay protocol.
+            m_ready = !reply.isError() && (reply.value().variant().toUInt() & 2u);
+            m_busy = false;
+            m_status = m_ready ? tr("Timepiece ready") : tr("Timepiece unavailable. Try again after the watch has started.");
+            if (reply.isError()) qWarning() << "Timepiece capability check:" << reply.error();
+            watcher->deleteLater();
+            emit changed();
+        });
+    }
+
+    Q_INVOKABLE void activate() {
+        if (!m_ready || m_busy) return;
+        m_busy = true;
+        m_ready = false;
+        m_status = tr("Starting timepiece mode…");
+        emit changed();
+        auto message = QDBusMessage::createMethodCall("org.asteroid.SecondDisplay", "/Display",
+            "org.asteroid.SecondDisplay.Display", "EnterTimepieceMode");
+        message.setArguments({true});
+        auto watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message, 120000), this);
+        connect(watcher, &QDBusPendingCallWatcher::finished, this, [this, watcher] {
+            QDBusPendingReply<bool> reply = *watcher;
+            m_busy = false;
+            m_status = !reply.isError() && reply.value()
+                ? tr("Shutting down into timepiece mode…")
+                : tr("Could not enter timepiece mode. If the display changed, restart the watch with its power button before retrying.");
+            if (reply.isError()) qWarning() << "Timepiece handoff:" << reply.error();
+            watcher->deleteLater();
+            emit changed();
+        });
+    }
+signals:
+    void changed();
+private:
+    bool m_ready = false;
+    bool m_busy = false;
+    QString m_status;
+};
diff --git a/overlay/asteroidos/extreme-battery-saver/default.nix b/overlay/asteroidos/extreme-battery-saver/default.nix
new file mode 100644
index 00000000..f3f25dc7
--- /dev/null
+++ b/overlay/asteroidos/extreme-battery-saver/default.nix
@@ -0,0 +1,56 @@
+{
+  lib,
+  stdenv,
+  cmake,
+  qt6,
+  buildPackages,
+  dbus,
+}:
+
+stdenv.mkDerivation {
+  pname = "asteroid-extreme-battery-saver";
+  version = "1.0";
+  src = ./.;
+  strictDeps = true;
+  nativeBuildInputs = [
+    cmake
+    qt6.wrapQtAppsHook
+  ];
+  buildInputs = [
+    qt6.qtbase
+    qt6.qtdeclarative
+  ];
+  cmakeFlags = [
+    "-DBUILD_TESTING=${if stdenv.buildPlatform.canExecute stdenv.hostPlatform then "ON" else "OFF"}"
+  ]
+  ++ lib.optionals (!stdenv.buildPlatform.canExecute stdenv.hostPlatform) [
+    "-DQt6QmlTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QmlTools"
+    "-DQt6QuickTools_DIR=${buildPackages.qt6.qtdeclarative}/lib/cmake/Qt6QuickTools"
+  ];
+  doCheck = stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+  nativeCheckInputs = [ dbus ];
+  checkPhase = ''
+    runHook preCheck
+    dbus-run-session --config-file=${dbus}/share/dbus-1/session.conf -- ctest --output-on-failure
+    runHook postCheck
+  '';
+  doInstallCheck = stdenv.buildPlatform.canExecute stdenv.hostPlatform;
+  installCheckPhase = ''
+    runHook preInstallCheck
+    set +e
+    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
+      QT_FORCE_STDERR_LOGGING=1 QT_ASSUME_STDERR_HAS_CONSOLE=1 \
+      timeout 3 "$out/bin/asteroid-extreme-battery-saver" > ui-smoke.log 2>&1
+    ui_status=$?
+    set -e
+    cat ui-smoke.log
+    test "$ui_status" = 124
+    runHook postInstallCheck
+  '';
+  meta = {
+    description = "Explicit Hoki MCU timepiece handoff with confirmation";
+    license = lib.licenses.gpl3Only;
+    platforms = lib.platforms.linux;
+    mainProgram = "asteroid-extreme-battery-saver";
+  };
+}
diff --git a/overlay/asteroidos/extreme-battery-saver/main.cpp b/overlay/asteroidos/extreme-battery-saver/main.cpp
new file mode 100644
index 00000000..b2c8b3aa
--- /dev/null
+++ b/overlay/asteroidos/extreme-battery-saver/main.cpp
@@ -0,0 +1,18 @@
+#include <QGuiApplication>
+#include <QQmlApplicationEngine>
+#include <QQmlContext>
+#include "controller.h"
+
+int main(int argc, char **argv) {
+    QGuiApplication app(argc, argv);
+    app.setApplicationName("asteroid-extreme-battery-saver");
+    app.setApplicationDisplayName("Extreme battery saver");
+    app.setDesktopFileName("asteroid-extreme-battery-saver");
+    SaverController saver;
+    QQmlApplicationEngine engine;
+    engine.rootContext()->setContextProperty("saver", &saver);
+    engine.load(QUrl("qrc:/Main.qml"));
+    if (engine.rootObjects().isEmpty()) return 1;
+    saver.check();
+    return app.exec();
+}
