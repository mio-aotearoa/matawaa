diff --git a/overlay/asteroidos/extreme-battery-saver/Main.qml b/overlay/asteroidos/extreme-battery-saver/Main.qml
new file mode 100644
index 00000000..37993892
--- /dev/null
+++ b/overlay/asteroidos/extreme-battery-saver/Main.qml
@@ -0,0 +1,82 @@
+import QtQuick
+import QtQuick.Controls.Basic
+import QtQuick.Window
+
+Window {
+    id: window
+    visible: true
+    width: 416
+    height: 416
+    color: "#101813"
+    title: qsTr("Extreme battery saver")
+    property bool confirming: false
+
+    Flickable {
+        anchors.fill: parent
+        anchors.topMargin: window.height * 0.12
+        anchors.bottomMargin: window.height * 0.12
+        contentHeight: content.height
+        clip: true
+        Column {
+            id: content
+            width: window.width * 0.72
+            x: (window.width - width) / 2
+            spacing: 14
+            Text {
+                width: parent.width
+                text: qsTr("Extreme battery saver")
+                color: "#b9f4ca"
+                font.pixelSize: 25
+                font.bold: true
+                wrapMode: Text.WordWrap
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Text {
+                width: parent.width
+                text: window.confirming
+                    ? qsTr("Start now? Apps, notifications, alarms, Bluetooth and Wi-Fi will stop. Hold the power button to boot back into the normal watch.")
+                    : qsTr("Keep a simple clock running on the low-power chip while the main watch shuts down. Hold the power button to return.")
+                color: "white"
+                font.pixelSize: 19
+                wrapMode: Text.WordWrap
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Text {
+                width: parent.width
+                text: saver.status
+                color: saver.ready ? "#b9f4ca" : "#ffcf99"
+                font.pixelSize: 16
+                wrapMode: Text.WrapAnywhere
+                horizontalAlignment: Text.AlignHCenter
+            }
+            Button {
+                width: parent.width
+                height: 56
+                font.pixelSize: 19
+                text: window.confirming ? qsTr("Start timepiece mode") : qsTr("Continue")
+                enabled: saver.ready && !saver.busy
+                onClicked: {
+                    if (window.confirming) saver.activate()
+                    else window.confirming = true
+                }
+            }
+            Button {
+                width: parent.width
+                height: 56
+                font.pixelSize: 19
+                visible: !saver.ready && !saver.busy
+                text: qsTr("Check again")
+                onClicked: { window.confirming = false; saver.check() }
+            }
+            Button {
+                width: parent.width
+                height: 56
+                font.pixelSize: 19
+                text: qsTr("Cancel")
+                enabled: !saver.busy
+                onClicked: Qt.quit()
+            }
+        }
+        ScrollIndicator.vertical: ScrollIndicator { }
+    }
+}
