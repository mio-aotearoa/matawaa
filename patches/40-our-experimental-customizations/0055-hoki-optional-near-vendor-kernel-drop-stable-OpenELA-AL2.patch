From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matawaa <noreply@localhost>
Date: Tue, 17 Nov 2026 10:55:24 +1100
Subject: [PATCH 1/1] hoki: optional near-vendor kernel (drop
 stable/OpenELA/AL2)

Gate kernel.org, OpenELA, and Amazon AL2 backport trains behind flags and
disable them on hoki for PS_HOLD A/B testing against vendor+AsteroidOS only.
---
 devices/fossil-hoki/default.nix        |   4 +
 devices/fossil-hoki/kernel/default.nix | 211 ++++++++++++++-----------
 2 files changed, 125 insertions(+), 90 deletions(-)

diff --git a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
index 6f0ef23e..d00b9e31 100644
--- a/devices/fossil-hoki/default.nix
+++ b/devices/fossil-hoki/default.nix
@@ -102,6 +102,10 @@ in
   mobile.boot.stage-1 = {
     kernel.package = pkgs.callPackage ./kernel {
       enableDroidspacesBackports = config.mobile.hardware.watch.kernel == "legacy-backports";
+      # A/B: near-vendor kernel (AsteroidOS device patches only) while comparing
+      # unexplained PS_HOLD hard resets against the full stable/OpenELA/AL2 stack.
+      enableStableBackports = false;
+      enableAmzn2Backports = false;
     };
   };
 
diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
index 3dd58d03..013a0b9e 100644
--- a/devices/fossil-hoki/kernel/default.nix
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -12,6 +12,14 @@
   runCommand,
   xz,
   enableDroidspacesBackports ? false,
+  # kernel.org 4.14.206→336 increments + OpenELA 336→357 (+ vendor hunk
+  # adaptations). Disable with enableAmzn2Backports for an A/B build that
+  # stays near the Fossil vendor tree (plus AsteroidOS device patches only).
+  enableStableBackports ? true,
+  # Amazon Linux 2's 767-patch security/maintenance train on top of OpenELA
+  # 4.14.355. Requires enableStableBackports; disable both to compare against
+  # unexplained PS_HOLD hard resets on a near-vendor kernel.
+  enableAmzn2Backports ? true,
   ...
 }:
 
@@ -844,17 +852,38 @@ let
 in
 
 kernel-builder-gcc8 {
-  version = "4.14.355-287.768.amzn2";
-  modDirVersion = "4.14.355-287.768.amzn2";
+  version =
+    if enableAmzn2Backports then
+      "4.14.355-287.768.amzn2"
+    else if enableStableBackports then
+      "4.14.357"
+    else
+      "4.14.206";
+  modDirVersion =
+    if enableAmzn2Backports then
+      "4.14.355-287.768.amzn2"
+    else if enableStableBackports then
+      "4.14.357"
+    else
+      "4.14.206";
   inherit configfile;
 
   # The vendor tree claims 4.14.206 and every incremental patch's Makefile hunk
-  # is dropped above, so the version is set here instead of 24 times over. The
-  # release suffix follows Amazon Linux 2's rpm: AL2 builds its kernels as
-  # 4.14.355-%{release}.%{_target_cpu}, so this is the armv7l equivalent.
+  # is dropped above, so the version is set here instead of once per increment.
+  # AL2 uses Amazon's rpm release suffix; stable-only stops at OpenELA 4.14.357;
+  # with both trains off we keep the vendor SUBLEVEL.
   postPatch = ''
-    sed -i -E 's/^SUBLEVEL = [0-9]+$/SUBLEVEL = 355/' Makefile
-    sed -i -E 's/^EXTRAVERSION.*$/EXTRAVERSION = -287.768.amzn2/' Makefile
+    sed -i -E 's/^SUBLEVEL = [0-9]+$/SUBLEVEL = ${
+      if enableAmzn2Backports then
+        "355"
+      else if enableStableBackports then
+        "357"
+      else
+        "206"
+    }/' Makefile
+    sed -i -E 's/^EXTRAVERSION.*$/EXTRAVERSION = ${
+      if enableAmzn2Backports then "-287.768.amzn2" else ""
+    }/' Makefile
   '';
 
   src = fetchFromGitHub {
