From: matawaa
Subject: [PATCH] hoki: stop ambient 1Hz flashes (minute WallClock + sticky DOZE clear)

Ambient lipstick wakes once per minute, but MainScreen kept WallClock at
Second. Combined with QPA_HWC2_FORCE_DOZE_UPDATE (temporary full-ON presents),
that produced ~1 Hz display flashes. Bind WallClock to Minute in ambient,
and strip sticky QPA_HWC2_DOZE_UPDATE from all compositor env drop-ins.

diff -Naur a/devices/fossil-hoki/default.nix b/devices/fossil-hoki/default.nix
--- a/devices/fossil-hoki/default.nix	2026-11-16 22:09:51.720307355 +1100
+++ b/devices/fossil-hoki/default.nix	2026-11-16 22:09:51.732307312 +1100
@@ -407,10 +407,18 @@
       Type = "oneshot";
       RemainAfterExit = true;
       ExecStart = pkgs.writeShellScript "hoki-clear-sticky-doze-update" ''
-        conf=/var/lib/environment/compositor/20-device.conf
-        if [ -f "$conf" ] && grep -q '^QPA_HWC2_DOZE_UPDATE=' "$conf"; then
-          sed -i '/^QPA_HWC2_DOZE_UPDATE=/d' "$conf"
+        confdir=/var/lib/environment/compositor
+        # Strip experimental DOZE_UPDATE from any compositor env drop-in; that
+        # flag wins over FORCE_DOZE_UPDATE in the HWC plugin and caused ~1 Hz flashes.
+        if [ -d "$confdir" ]; then
+          for conf in "$confdir"/*.conf; do
+            [ -f "$conf" ] || continue
+            if grep -q '^QPA_HWC2_DOZE_UPDATE=' "$conf"; then
+              sed -i '/^QPA_HWC2_DOZE_UPDATE=/d' "$conf"
+            fi
+          done
         fi
+        conf=$confdir/20-device.conf
         if [ -f "$conf" ] && ! grep -q '^QPA_HWC2_FORCE_DOZE_UPDATE=' "$conf"; then
           printf '%s\n' 'QPA_HWC2_FORCE_DOZE_UPDATE=1' >> "$conf"
         fi
diff -Naur a/overlay/asteroidos/asteroid-launcher/ambient-wallclock-minute.patch b/overlay/asteroidos/asteroid-launcher/ambient-wallclock-minute.patch
--- a/overlay/asteroidos/asteroid-launcher/ambient-wallclock-minute.patch	1970-01-01 10:00:00.000000000 +1000
+++ b/overlay/asteroidos/asteroid-launcher/ambient-wallclock-minute.patch	2026-11-16 22:09:51.728307326 +1100
@@ -0,0 +1,13 @@
+--- a/src/qml/MainScreen.qml
++++ b/src/qml/MainScreen.qml
+@@ -198,7 +198,9 @@ Item {
+     WallClock {
+         id: wallClock
+         enabled: desktop.visible
+-        updateFrequency: WallClock.Second
++        // Ambient is woken once per minute by lipstick. Keeping Second here
++        // with QPA_HWC2_FORCE_DOZE_UPDATE caused ~1 Hz full-ON present flashes.
++        updateFrequency: displayAmbient ? WallClock.Minute : WallClock.Second
+     }
+ 
+     MceChargerType {
diff -Naur a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
--- a/overlay/asteroidos/asteroid-launcher/default.nix	2026-11-16 22:09:51.717307366 +1100
+++ b/overlay/asteroidos/asteroid-launcher/default.nix	2026-11-16 22:09:51.726307333 +1100
@@ -90,6 +90,8 @@
     # screen with a live render loop) names the failing Loader instead of
     # leaving only "update from item" chatter in the log.
     ./qml-boot-diagnostics.patch
+    # Ambient: WallClock.Minute so FORCE_DOZE_UPDATE presents stay once/minute.
+    ./ambient-wallclock-minute.patch
   ];
 
   nativeBuildInputs = [
