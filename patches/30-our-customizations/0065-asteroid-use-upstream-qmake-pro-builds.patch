diff --git a/overlay/asteroidos/lib/qmake-cross-hook.nix b/overlay/asteroidos/lib/qmake-cross-hook.nix
new file mode 100644
index 00000000..deb07965
--- /dev/null
+++ b/overlay/asteroidos/lib/qmake-cross-hook.nix
@@ -0,0 +1,19 @@
+{
+  makeSetupHook,
+  buildPackages,
+  qt6,
+}:
+
+makeSetupHook {
+  name = "qmake-cross-hook";
+  substitutions = {
+    hostQmake = "${buildPackages.qt6.qtbase}/bin/qmake";
+    hostQtBin = "${buildPackages.qt6.qtbase}/bin";
+    hostQtLibexec = "${buildPackages.qt6.qtbase}/libexec";
+    hostQtBase = "${buildPackages.qt6.qtbase}";
+    hostQtDev = "${buildPackages.qt6.qtbase.dev}";
+    targetQtBase = "${qt6.qtbase}";
+    targetQtDev = "${qt6.qtbase.dev}";
+    targetQtDeclarativeDev = "${qt6.qtdeclarative.dev}";
+  };
+} ./qmake-cross-hook.sh
diff --git a/overlay/asteroidos/lib/qmake-cross-hook.sh b/overlay/asteroidos/lib/qmake-cross-hook.sh
new file mode 100644
index 00000000..e95e5b56
--- /dev/null
+++ b/overlay/asteroidos/lib/qmake-cross-hook.sh
@@ -0,0 +1,68 @@
+qmakeCrossConfigurePhase() {
+    runHook preConfigure
+
+    export PATH="@hostQtBin@:$PATH"
+    local filteredQmakePath=""
+    local oldIfs="$IFS"
+    IFS=:
+    for p in @targetQtDev@ @targetQtDeclarativeDev@ ${QMAKEPATH:-}; do
+        if [ -n "$p" ] && [ "$p" != "@targetQtBase@" ] && [[ ":$filteredQmakePath:" != *":$p:"* ]]; then
+            filteredQmakePath="${filteredQmakePath}${filteredQmakePath:+:}$p"
+        fi
+    done
+    IFS="$oldIfs"
+    for flag in ${NIX_CFLAGS_COMPILE:-}; do
+        case "$flag" in
+            */include)
+                local pkg="${flag%/include}"
+                if [ -d "$pkg/mkspecs" ] && [ ! -d "$pkg/mkspecs/features" ] && [[ ":$filteredQmakePath:" != *":$pkg:"* ]]; then
+                    filteredQmakePath="$filteredQmakePath:$pkg"
+                fi
+                ;;
+        esac
+    done
+    export QMAKEPATH="$filteredQmakePath"
+
+    local flagsArray=()
+    concatTo flagsArray qmakeFlags
+
+    echo "QMAKEPATH=$QMAKEPATH"
+    echo "@hostQmake@ -early" "${flagsArray[@]}"
+    @hostQmake@ -early \
+      "QMAKE_CC=$CC" \
+      "QMAKE_CXX=$CXX" \
+      "QMAKE_LINK=$CXX" \
+      "QMAKE_AR=$AR cqs" \
+      "QMAKE_STRIP=$STRIP" \
+      "QMAKE_PKG_CONFIG=$PKG_CONFIG" \
+      "QMAKE_LIBDIR_QT=@targetQtBase@/lib" \
+      "QMAKE_LFLAGS_RPATH=" \
+      "${flagsArray[@]}"
+
+    if ! [[ -v enableParallelBuilding ]]; then
+        enableParallelBuilding=1
+    fi
+
+    if ! [[ -v enableParallelInstalling ]]; then
+        enableParallelInstalling=1
+    fi
+
+    runHook postConfigure
+}
+
+if [ -z "${dontUseQmakeCrossConfigure-}" -a -z "${configurePhase-}" ]; then
+    configurePhase=qmakeCrossConfigurePhase
+fi
+
+qmakeCrossFixupPc() {
+    local pc
+    for pc in "$out"/lib/pkgconfig/*.pc; do
+        [ -f "$pc" ] || continue
+        sed -i \
+            -e "s|^prefix=.*|prefix=$out|" \
+            -e "s|^libdir=/lib$|libdir=\${prefix}/lib|" \
+            -e "s|^includedir=/include|includedir=\${prefix}/include|" \
+            "$pc"
+    done
+}
+appendToVar preFixupHooks qmakeCrossFixupPc
