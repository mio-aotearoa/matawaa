From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 15 Nov 2026 14:59:05 +1100
Subject: [PATCH 1/1] oppo-beluga: wire missing 4.9.112-113 and 160-161 stable
 increments

stablePatch113 was defined but never applied; 121-122 and 160-161 were
skipped gaps. Drop the three 160-161 files already present in the vendor tree.
---
 devices/oppo-beluga/kernel/default.nix | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/devices/oppo-beluga/kernel/default.nix b/devices/oppo-beluga/kernel/default.nix
index bfb97c60..fe4db0fc 100644
--- a/devices/oppo-beluga/kernel/default.nix
+++ b/devices/oppo-beluga/kernel/default.nix
@@ -176,6 +176,8 @@ kernel-builder-gcc8 {
   # -- that increment's files are dropped instead and stay vendor code. This
   # carries the tree all the way to 4.9.337, the last 4.9 stable release.
   ++ [
+    # Vendor src is 4.9.112; apply 112-113 before the rest of the ladder.
+    stablePatch113
     (stableIncr "113" "114" "sha256-qnljwfgrKu0gOyiAJ/aqfHAotBQo+nKG9ccRSjAZgeg=" [
       "include/linux/compiler-gcc.h"
     ])
@@ -212,6 +214,8 @@ kernel-builder-gcc8 {
     (stableIncr "120" "121" "sha256-H7F9jD3e5dqJG9xO/6kCFxdpC8UznO8nASHnQX4/BUU=" [
       "net/bluetooth/hidp/core.c"
     ])
+    # No arm-relevant hunks after auto-drop; keep the ladder gapless.
+    (stableIncr "121" "122" "sha256-XgQbw4QaPg4yQhlYPs5oFMTCE4D/C6TL6NMyJoIRSzQ=" [ ])
     (stableIncr "122" "123" "sha256-scE9pNA5+GsXm/c6gRyO/GMv91C3dIBv3wWq/6P7gec=" [ ])
     (stableIncr "123" "124" "sha256-AYQsEJ2y8QNqJ/Qu+nIyB/DD4H7dUY/7DMiW3IVzUvM=" [ ])
     (stableIncr "124" "125" "sha256-P8sswp2iNVWYCVxTLwrg/WG7FSMSpMVtTpv/sdgqKOA=" [
@@ -364,6 +368,12 @@ kernel-builder-gcc8 {
       "mm/memory.c"
     ])
     (stableIncr "159" "160" "sha256-bsX5lotgkgJGVIGW+HWUpwuf8ZeY6P7h/uDfGuBfntc=" [ ])
+    # Vendor tree already carries these three fixes.
+    (stableIncr "160" "161" "sha256-2eaOpwI4EvSQuWXqtEOwBE4tFd0QpAY26EbowDNiMXY=" [
+      "include/linux/clocksource.h"
+      "kernel/trace/trace.c"
+      "net/core/netpoll.c"
+    ])
     (stableIncr "161" "162" "sha256-0WrVaVGrEt0N63/CJSADkKAoB99RkW/5TtF9Gj9djB8=" [
       "drivers/gpu/drm/msm/msm_rd.c"
       "sound/core/compress_offload.c"
