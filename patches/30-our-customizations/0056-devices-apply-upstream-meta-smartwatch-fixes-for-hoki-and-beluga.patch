From bb52edf0a82d3b23116e0832297445ffde3aabbc Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 20 Nov 2026 12:38:50 +1100
Subject: [PATCH 53/54] devices: apply upstream meta-smartwatch fixes for hoki
 and beluga

---
 devices/fossil-hoki/kernel/default.nix | 2 +-
 devices/oppo-beluga/android-init.nix   | 3 +++
 devices/oppo-beluga/default.nix        | 2 +-
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
index e3b6d819..4905e0ee 100644
--- a/devices/fossil-hoki/kernel/default.nix
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -850,7 +850,7 @@ let
       }
       ''
         patch -p1 -i "$patch" -o "$out" "$upstream"
-        printf '\nCONFIG_SECTION_MISMATCH_WARN_ONLY=y\n' >> "$out"
+        printf '\nCONFIG_SECTION_MISMATCH_WARN_ONLY=y\nCONFIG_PM_AUTOSLEEP=y\n' >> "$out"
       '';
 in
 
diff --git a/devices/oppo-beluga/android-init.nix b/devices/oppo-beluga/android-init.nix
index 9a0019aa..3b4e1b57 100644
--- a/devices/oppo-beluga/android-init.nix
+++ b/devices/oppo-beluga/android-init.nix
@@ -35,6 +35,8 @@ let
   # Matches AsteroidOS meta-skipjack, meta-koi, meta-narwhal, meta-pike, meta-ray.
   patchedInitRc = pkgs.runCommand "init.rc" { } ''
         ${pkgs.gnused}/bin/sed \
+          -e '/chown system root \/sys\/class\/timed_output\/vibrator\/enable/a \    chown system root /sys/devices/virtual/graphics/fb0/mdss_fb_disp_en_gpio\n    chown system root /sys/devices/platform/soc/soc:oppo,sensor-hub/reset' \
+          -e "s|^service pm-service /vendor/bin/pm-service\$|service pm-service /usr/bin/sh -c \"/vendor/bin/pm-service \\& trap 'kill -INT \$\$!' TERM; wait; wait\"|" \
           -e '/start vndservicemanager/a \    start vendor.gralloc-2-0\n    start vendor.configstore-hal' \
           -e '/setprop sys.hwc.gpu_perf_mode 1/a \    setprop vendor.gralloc.enable_fb_ubwc 0\n    setprop vendor.gralloc.disable_ubwc 1' \
           ${initRc} > $out
@@ -91,6 +93,7 @@ in
       "bluetooth.service"
       "ofono.service"
       "sensord.service"
+      "sensorfwd.service"
     ];
     unitConfig.DefaultDependencies = false;
     unitConfig.Conflicts = [ "shutdown.target" ];
diff --git a/devices/oppo-beluga/default.nix b/devices/oppo-beluga/default.nix
index 9d194e2e..8c7325b4 100644
--- a/devices/oppo-beluga/default.nix
+++ b/devices/oppo-beluga/default.nix
@@ -189,7 +189,7 @@ in
         if [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
           echo schedutil > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
         fi
-        for c in 1 2 3; do
+        for c in 2 3; do
           if [ -f /sys/devices/system/cpu/cpu$c/online ]; then
             echo 0 > /sys/devices/system/cpu/cpu$c/online 2>/dev/null || true
           fi
-- 
2.56.0

