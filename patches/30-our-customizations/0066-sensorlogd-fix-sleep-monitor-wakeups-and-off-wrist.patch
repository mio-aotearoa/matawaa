From a6d7f675a924f8528301c15135c3eec7d94277b2 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 21 Nov 2026 00:10:46 +1100
Subject: [PATCH] sensorlogd: fix sleep monitor overnight wakeups, HRM timeout,
 and off-wrist detection

---
 overlay/asteroidos/community-apps/default.nix |   3 +
 .../sensorlogd-sleep-monitor-fixes.patch      | 331 ++++++++++++++++++
 overlay/asteroidos/default.nix                |   2 +-
 3 files changed, 335 insertions(+), 1 deletion(-)
 create mode 100644 overlay/asteroidos/community-apps/sensorlogd-sleep-monitor-fixes.patch

diff --git a/overlay/asteroidos/community-apps/default.nix b/overlay/asteroidos/community-apps/default.nix
index f16f0d91..1b912ba2 100644
--- a/overlay/asteroidos/community-apps/default.nix
+++ b/overlay/asteroidos/community-apps/default.nix
@@ -16,6 +16,7 @@
   espeak-classic,
   noUsrShareHook,
   boost,
+  keepalive,
 }:
 
 rec {
@@ -79,6 +80,7 @@ rec {
     patches = [
       ./sensorlogd-sleep-monitor.patch
       ./sensorlogd-boost-period.patch
+      ./sensorlogd-sleep-monitor-fixes.patch
     ];
     # The wearable sensor types (QHrmSensor, QStepCounterSensor, …) come from
     # Qt Sensors itself: the upstream AsteroidOS patches are applied to
@@ -88,6 +90,7 @@ rec {
       qt6.qtsensors
       mlite
       boost
+      keepalive
     ];
   };
 
diff --git a/overlay/asteroidos/community-apps/sensorlogd-sleep-monitor-fixes.patch b/overlay/asteroidos/community-apps/sensorlogd-sleep-monitor-fixes.patch
new file mode 100644
index 00000000..833fea49
--- /dev/null
+++ b/overlay/asteroidos/community-apps/sensorlogd-sleep-monitor-fixes.patch
@@ -0,0 +1,331 @@
+diff --git a/daemon/CMakeLists.txt b/daemon/CMakeLists.txt
+index d585555..2e98af5 100644
+--- a/daemon/CMakeLists.txt
++++ b/daemon/CMakeLists.txt
+@@ -16,6 +16,8 @@ add_executable(
+ )
+ 
+ find_package(Boost REQUIRED)
++find_package(PkgConfig REQUIRED)
++pkg_check_modules(KEEPALIVE REQUIRED keepalive)
+ 
+ set_target_properties(sensorlogd PROPERTIES AUTOMOC ON)
+ target_link_libraries(
+@@ -27,8 +29,9 @@ target_link_libraries(
+         Qt::Sensors
+         Boost::headers
+         ${mlite6_LIBRARIES}
++        ${KEEPALIVE_LIBRARIES}
+ )
+-target_include_directories(sensorlogd PRIVATE ${mlite6_INCLUDE_DIRS})
++target_include_directories(sensorlogd PRIVATE ${mlite6_INCLUDE_DIRS} ${KEEPALIVE_INCLUDE_DIRS})
+ install(TARGETS sensorlogd DESTINATION bin)
+ install(
+     FILES systemd/asteroid-sensorlogd.service
+diff --git a/daemon/sensorPlugins/sleepMonitor.cpp b/daemon/sensorPlugins/sleepMonitor.cpp
+index 8b80f6a..e1a112a 100644
+--- a/daemon/sensorPlugins/sleepMonitor.cpp
++++ b/daemon/sensorPlugins/sleepMonitor.cpp
+@@ -16,6 +16,9 @@
+ #include "../../common.h"
+ 
+ #include <QDebug>
++#include <QDir>
++#include <QFile>
++#include <QTextStream>
+ #include <QtMath>
+ 
+ #include <boost/math/statistics/univariate_statistics.hpp>
+@@ -25,6 +28,36 @@ namespace {
+ constexpr double kGravityMs2 = 9.80665;
+ constexpr int kColeKripkeWindow = 7;
+ constexpr int kMaxRestingHrSamples = 64;
++constexpr int kActigraphyWindowMs = 4000;
++constexpr int kHrmTimeoutMs = 15000;
++
++bool isOvernightWindow(const QDateTime &dt)
++{
++    const int hour = dt.time().hour();
++    return hour >= 20 || hour < 12;
++}
++
++bool isDeviceCharging()
++{
++    const QDir psDir(QStringLiteral("/sys/class/power_supply"));
++    const QStringList entries = psDir.entryList(QDir::Dirs | QDir::NoDotAndDotDot);
++    for (const QString &entry : entries) {
++        QFile statusFile(psDir.filePath(entry + QStringLiteral("/status")));
++        if (!statusFile.open(QIODevice::ReadOnly | QIODevice::Text)) {
++            continue;
++        }
++        const QString status = QString::fromUtf8(statusFile.readAll()).trimmed();
++        if (status.compare(QStringLiteral("Charging"), Qt::CaseInsensitive) == 0
++            || status.compare(QStringLiteral("Full"), Qt::CaseInsensitive) == 0) {
++            QFile typeFile(psDir.filePath(entry + QStringLiteral("/type")));
++            if (typeFile.open(QIODevice::ReadOnly | QIODevice::Text)
++                && QString::fromUtf8(typeFile.readAll()).trimmed() == QLatin1String("Battery")) {
++                return true;
++            }
++        }
++    }
++    return false;
++}
+ 
+ /*
+  * Cole-Kripke (1992) sleep/wake weights adapted for 1-5 min ENMO epochs (in milli-g):
+@@ -66,10 +99,16 @@ SleepMonitorPlugin::SleepMonitorPlugin(QObject *parent, int initInterval)
+ 
+     setupFilePath(sensorPathPrefix);
+ 
++    bgActivity = new BackgroundActivity(this);
++    connect(bgActivity, &BackgroundActivity::running, this, &SleepMonitorPlugin::onBackgroundWakeup);
++
+     recordIntervalTimer = new QTimer(this);
+     recordIntervalTimer->setSingleShot(true);
+-    connect(recordIntervalTimer, &QTimer::timeout, this, &SleepMonitorPlugin::triggerRecording);
+-    recordIntervalTimer->start(interval);
++    connect(recordIntervalTimer, &QTimer::timeout, this, &SleepMonitorPlugin::onBackgroundWakeup);
++
++    actigraphyTimer = new QTimer(this);
++    actigraphyTimer->setSingleShot(true);
++    connect(actigraphyTimer, &QTimer::timeout, this, &SleepMonitorPlugin::finishActigraphy);
+ 
+     sampleWindowTimer = new QTimer(this);
+     sampleWindowTimer->setSingleShot(true);
+@@ -80,11 +119,34 @@ SleepMonitorPlugin::SleepMonitorPlugin(QObject *parent, int initInterval)
+     connect(accelSampleTimer, &QTimer::timeout, this, &SleepMonitorPlugin::sampleAccel);
+ 
+     lastRecordTime = QDateTime::currentDateTime();
++    scheduleNextWakeup();
+     qDebug() << "sleep monitor (Boost.Math Cole-Kripke/ENMO) enabled. interval (ms):" << interval;
+ }
+ 
++void SleepMonitorPlugin::scheduleNextWakeup()
++{
++    const QDateTime now = QDateTime::currentDateTime();
++    if (isOvernightWindow(now)) {
++        const int minSec = qMax(60, interval / 1000);
++        bgActivity->wait(minSec, minSec + 30);
++        recordIntervalTimer->start(interval);
++        return;
++    }
++
++    // Daytime (12:00 -> 20:00): stop periodic sampling and wake at 20:00
++    const QDateTime nextEvening(now.date(), QTime(20, 0));
++    const qint64 secsUntil = qMax<qint64>(60, now.secsTo(nextEvening));
++    bgActivity->wait(static_cast<int>(secsUntil), static_cast<int>(secsUntil + 60));
++    recordIntervalTimer->stop();
++}
++
+ void SleepMonitorPlugin::timeUpdate()
+ {
++    const QDateTime now = QDateTime::currentDateTime();
++    if (!isOvernightWindow(now)) {
++        scheduleNextWakeup();
++        return;
++    }
+     const qint64 elapsed = QDateTime::currentMSecsSinceEpoch() - lastRecordTime.toMSecsSinceEpoch();
+     if (elapsed >= interval) {
+         triggerRecording();
+@@ -93,27 +155,33 @@ void SleepMonitorPlugin::timeUpdate()
+     }
+ }
+ 
++void SleepMonitorPlugin::onBackgroundWakeup()
++{
++    if (!isOvernightWindow(QDateTime::currentDateTime())) {
++        scheduleNextWakeup();
++        return;
++    }
++    triggerRecording();
++}
++
+ void SleepMonitorPlugin::triggerRecording()
+ {
+-    recordIntervalTimer->start(interval);
+     if (samplingActive) {
+         return;
+     }
+ 
+     samplingActive = true;
++    actigraphyDone = false;
+     enmoSamples.clear();
+     latestBpm = 0;
+ 
+-    if (stepSensor->start()) {
+-        if (auto *sr = stepSensor->reading()) {
+-            epochStartSteps = sr->steps();
+-        }
+-    }
++    stepSensor->start();
+     accelSensor->start();
+     hrmSensor->start();
+ 
+     accelSampleTimer->start();
+-    sampleWindowTimer->start(4000);
++    actigraphyTimer->start(kActigraphyWindowMs);
++    sampleWindowTimer->start(kHrmTimeoutMs);
+ }
+ 
+ void SleepMonitorPlugin::sampleAccel()
+@@ -128,17 +196,34 @@ void SleepMonitorPlugin::sampleAccel()
+     }
+ }
+ 
++void SleepMonitorPlugin::finishActigraphy()
++{
++    accelSampleTimer->stop();
++    accelSensor->stop();
++    actigraphyDone = true;
++    if (latestBpm > 25) {
++        sampleWindowTimer->stop();
++        finalizeEpoch();
++    }
++}
++
+ void SleepMonitorPlugin::onHrmChanged()
+ {
+     if (auto *r = hrmSensor->reading()) {
+         if (r->bpm() > 25 && hrmSensor->status() >= 3) {
+             latestBpm = r->bpm();
++            if (samplingActive && actigraphyDone) {
++                sampleWindowTimer->stop();
++                finalizeEpoch();
++            }
+         }
+     }
+ }
+ 
+ void SleepMonitorPlugin::finalizeEpoch()
+ {
++    actigraphyTimer->stop();
++    sampleWindowTimer->stop();
+     accelSampleTimer->stop();
+     accelSensor->stop();
+     hrmSensor->stop();
+@@ -205,6 +290,8 @@ void SleepMonitorPlugin::finalizeEpoch()
+     SleepStage stage = Awake;
+     if (stepsDelta > 0 || ckIndex >= 1.0) {
+         stage = Awake;
++    } else if (isDeviceCharging() || latestBpm <= 25) {
++        stage = OffWrist;
+     } else if (smoothedActivity >= 12.0 || ckIndex >= 0.45) {
+         stage = LightSleep;
+     } else if (latestBpm > 25 && (static_cast<double>(latestBpm) - hrMedian) > 1.25 * hrMadScaled) {
+@@ -221,5 +308,6 @@ void SleepMonitorPlugin::finalizeEpoch()
+     fileAddRecord(sensorPathPrefix, record);
+     lastRecordTime = QDateTime::currentDateTime();
+     samplingActive = false;
++    scheduleNextWakeup();
+     emit recordWritten();
+ }
+diff --git a/daemon/sensorPlugins/sleepMonitor.h b/daemon/sensorPlugins/sleepMonitor.h
+index f6fd302..4e9953f 100644
+--- a/daemon/sensorPlugins/sleepMonitor.h
++++ b/daemon/sensorPlugins/sleepMonitor.h
+@@ -18,11 +18,14 @@
+ #include <QtSensors/QHrmSensor>
+ #include <QtSensors/QStepCounterSensor>
+ 
++#include <keepalive/backgroundactivity.h>
++
+ class SleepMonitorPlugin : public QObject
+ {
+     Q_OBJECT
+ public:
+     enum SleepStage {
++        OffWrist = -1,
+         Awake = 0,
+         LightSleep = 1,
+         DeepSleep = 2,
+@@ -42,23 +45,29 @@ signals:
+ 
+ private slots:
+     void sampleAccel();
++    void finishActigraphy();
+     void onHrmChanged();
+     void finalizeEpoch();
++    void onBackgroundWakeup();
+ 
+ private:
++    void scheduleNextWakeup();
++
+     int interval = 300000;
+     QDateTime lastRecordTime;
+     QTimer *recordIntervalTimer = nullptr;
++    QTimer *actigraphyTimer = nullptr;
+     QTimer *sampleWindowTimer = nullptr;
+     QTimer *accelSampleTimer = nullptr;
++    BackgroundActivity *bgActivity = nullptr;
+ 
+     QAccelerometer *accelSensor = nullptr;
+     QStepCounterSensor *stepSensor = nullptr;
+     QHrmSensor *hrmSensor = nullptr;
+ 
+     bool samplingActive = false;
++    bool actigraphyDone = false;
+     int lastStepCount = -1;
+-    int epochStartSteps = -1;
+     int latestBpm = 0;
+ 
+     QVector<double> enmoSamples;
+diff --git a/qmlplugin/sleepDataLoader.cpp b/qmlplugin/sleepDataLoader.cpp
+index 0170d88..83fe1e7 100644
+--- a/qmlplugin/sleepDataLoader.cpp
++++ b/qmlplugin/sleepDataLoader.cpp
+@@ -102,12 +102,12 @@ QVariant SleepDataLoader::getSleepSummary(QDate date)
+ 
+     QVector<SleepEpoch> overnight;
+     for (const auto &ep : readEpochsForDate(date.addDays(-1))) {
+-        if (ep.timestamp >= winStart && ep.timestamp <= winEnd) {
++        if (ep.timestamp >= winStart && ep.timestamp <= winEnd && ep.stage >= 0) {
+             overnight.append(ep);
+         }
+     }
+     for (const auto &ep : readEpochsForDate(date)) {
+-        if (ep.timestamp >= winStart && ep.timestamp <= winEnd) {
++        if (ep.timestamp >= winStart && ep.timestamp <= winEnd && ep.stage >= 0) {
+             overnight.append(ep);
+         }
+     }
+@@ -117,6 +117,20 @@ QVariant SleepDataLoader::getSleepSummary(QDate date)
+     QVariantList timeline;
+ 
+     for (const auto &ep : overnight) {
++        if (ep.stage >= 1) {
++            if (firstSleepTs == 0) firstSleepTs = ep.timestamp;
++            lastSleepTs = ep.timestamp;
++        }
++    }
++
++    for (int i = 0; i < overnight.size(); ++i) {
++        const auto &ep = overnight.at(i);
++        int durMin = epochMinutes;
++        if (i + 1 < overnight.size()) {
++            const qint64 deltaMin = qRound64((overnight.at(i + 1).timestamp - ep.timestamp) / 60.0);
++            durMin = qBound(1, static_cast<int>(deltaMin), epochMinutes * 2);
++        }
++
+         QVariantMap item;
+         item.insert(QStringLiteral("timestamp"), ep.timestamp);
+         item.insert(QStringLiteral("stage"), ep.stage);
+@@ -124,13 +138,13 @@ QVariant SleepDataLoader::getSleepSummary(QDate date)
+         timeline.append(item);
+ 
+         if (ep.stage == 0) {
+-            awakeMin += epochMinutes;
++            if (firstSleepTs > 0 && ep.timestamp > firstSleepTs && ep.timestamp < lastSleepTs) {
++                awakeMin += durMin;
++            }
+         } else {
+-            if (firstSleepTs == 0) firstSleepTs = ep.timestamp;
+-            lastSleepTs = ep.timestamp;
+-            if (ep.stage == 1) lightMin += epochMinutes;
+-            else if (ep.stage == 2) deepMin += epochMinutes;
+-            else if (ep.stage == 3) remMin += epochMinutes;
++            if (ep.stage == 1) lightMin += durMin;
++            else if (ep.stage == 2) deepMin += durMin;
++            else if (ep.stage == 3) remMin += durMin;
+         }
+     }
+ 
diff --git a/overlay/asteroidos/default.nix b/overlay/asteroidos/default.nix
index 0f4ba901..ecf26ad0 100644
--- a/overlay/asteroidos/default.nix
+++ b/overlay/asteroidos/default.nix
@@ -208,7 +208,7 @@ rec {
   virtualkeyboard = callPackage ./virtualkeyboard { inherit noUsrShareHook; };
 
   community-apps = callPackage ./community-apps {
-    inherit mkAsteroidApp mlite noUsrShareHook;
+    inherit mkAsteroidApp mlite noUsrShareHook keepalive;
     inherit (pkgs) espeak-classic;
   };
 
-- 
