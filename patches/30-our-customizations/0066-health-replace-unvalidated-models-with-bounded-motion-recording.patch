+-/*
+- * Cole-Kripke (1992) sleep/wake weights adapted for 1-5 min ENMO epochs (in milli-g):
+- * D = P * sum(w_i * A_i), where D < 1.0 indicates sleep.
+- */
+-double computeColeKripkeIndex(const QVector<double> &history)
+-{
+-    static const double weights[kColeKripkeWindow] = { 0.04, 0.06, 0.12, 0.40, 0.22, 0.10, 0.06 };
+-    const int n = history.size();
+-    if (n == 0) {
+-        return 0.0;
+-    }
+-
+-    double weightedSum = 0.0;
+-    double weightNorm = 0.0;
+-    for (int i = 0; i < kColeKripkeWindow; ++i) {
+-        const int idx = n - 1 - i;
+-        if (idx < 0) {
+-            break;
+-        }
+-        weightedSum += weights[i] * history.at(idx);
+-        weightNorm += weights[i];
+-    }
+-    if (weightNorm <= 0.0) {
+-        return 0.0;
+-    }
+-    return (weightedSum / weightNorm) / 35.0;
+-}
