From 9bb5be3db45a73b818a8a954073d042998129f08 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 20 Nov 2026 17:44:40 +1100
Subject: [PATCH] sensorfw: enable libgbinder HIDL backend for fossil-hoki

---
 examples/asteroid/asteroid-desktop.nix  | 17 ++++++++++-----
 overlay/asteroidos/sensorfw/default.nix | 28 ++++++++++++++++++-------
 2 files changed, 32 insertions(+), 13 deletions(-)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index d6963f1e..54507e20 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -38,6 +38,14 @@ let
     else
       pkgs.asteroid.mce;
 
+  # Upstream meta-hoki uses sensorfw-hybris-binder-plugins (libgbinder over
+  # Android 9 Treble ISensors@1.0 HIDL) rather than HAL1 hw_get_module().
+  sensorfwPackage =
+    if config.mobile.device.name == "fossil-hoki" then
+      pkgs.asteroid.sensorfw.override { enableBinder = true; }
+    else
+      pkgs.asteroid.sensorfw;
+
   # Upstream asteroid-launcher_git.bb installs a seeded notification database
   # into the ceres user's privileged data directory.
   # https://github.com/AsteroidOS/meta-asteroid/tree/master/recipes-asteroid/asteroid-launcher/asteroid-launcher/Notifications
@@ -524,7 +532,7 @@ in
           ExecStartPre = "${pkgs.coreutils}/bin/sleep 2";
           # Keep sensorfwd at warning even on debug builds; --log-level=debug
           # logs two lines per accelerometer sample (~50-100 lines/s).
-          ExecStart = "${pkgs.asteroid.sensorfw}/sbin/sensorfwd -c=/etc/sensorfw/primaryuse.conf --systemd --log-level=warning --no-magnetometer-bg-calibration";
+          ExecStart = "${sensorfwPackage}/sbin/sensorfwd -c=/etc/sensorfw/primaryuse.conf --systemd --log-level=warning --no-magnetometer-bg-calibration";
           ExecReload = "${pkgs.coreutils}/bin/kill -HUP $MAINPID";
           Restart = "always";
           RestartSec = 2;
@@ -540,9 +548,8 @@ in
       # Upstream sensorfw installs its configs into /etc/sensorfw and the Qt
       # Sensors type map into /etc/xdg/QtProject.
       environment.etc."sensorfw/primaryuse.conf".source =
-        "${pkgs.asteroid.sensorfw}/etc/sensorfw/primaryuse.conf";
-      environment.etc."sensorfw/sensord.conf.d".source =
-        "${pkgs.asteroid.sensorfw}/etc/sensorfw/sensord.conf.d";
+        "${sensorfwPackage}/etc/sensorfw/primaryuse.conf";
+      environment.etc."sensorfw/sensord.conf.d".source = "${sensorfwPackage}/etc/sensorfw/sensord.conf.d";
       environment.etc."xdg/QtProject/Sensors.conf".source =
         "${pkgs.qt6.qtsensors}/etc/xdg/QtProject/Sensors.conf";
 
@@ -679,7 +686,7 @@ in
         pkgs.dconf
         mcePackage
         pkgs.asteroid.dsme
-        pkgs.asteroid.sensorfw
+        sensorfwPackage
         pkgs.asteroid.timed-qt6
         connmanDbusPolicy
       ]
diff --git a/overlay/asteroidos/sensorfw/default.nix b/overlay/asteroidos/sensorfw/default.nix
index 37cfc405..1f5423e3 100644
--- a/overlay/asteroidos/sensorfw/default.nix
+++ b/overlay/asteroidos/sensorfw/default.nix
@@ -10,8 +10,12 @@
   systemd,
   libhybris,
   udev,
+  libgbinder,
+  libglibutil,
+  glib,
   metaAsteroidSrc,
   qmakeCrossHook,
+  enableBinder ? false,
 }:
 
 stdenv.mkDerivation {
@@ -49,6 +53,11 @@ stdenv.mkDerivation {
     libhybris
     libhybris.androidHeaders
     udev
+  ]
+  ++ lib.optionals enableBinder [
+    libgbinder
+    libglibutil
+    glib
   ];
 
   postPatch = ''
@@ -73,17 +82,20 @@ stdenv.mkDerivation {
     "INCLUDEPATH+=${libhybris}/include"
     "INCLUDEPATH+=${libhybris.androidHeadersInclude}"
     "LIBS+=-L${libhybris}/lib"
+  ]
+  ++ lib.optionals enableBinder [
+    "CONFIG+=binder"
   ];
 
   preConfigure = ''
-    mkdir -p "$NIX_BUILD_TOP/pkgconfig"
-    cat > "$NIX_BUILD_TOP/pkgconfig/android-headers.pc" <<EOF
-Name: android-headers
-Description: Android headers for libhybris
-Version: 1.0
-Cflags: -I${libhybris.androidHeadersInclude}
-EOF
-    export PKG_CONFIG_PATH="$NIX_BUILD_TOP/pkgconfig''${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
+        mkdir -p "$NIX_BUILD_TOP/pkgconfig"
+        cat > "$NIX_BUILD_TOP/pkgconfig/android-headers.pc" <<EOF
+    Name: android-headers
+    Description: Android headers for libhybris
+    Version: 1.0
+    Cflags: -I${libhybris.androidHeadersInclude}
+    EOF
+        export PKG_CONFIG_PATH="$NIX_BUILD_TOP/pkgconfig''${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
   '';
 
   installFlags = [ "INSTALL_ROOT=$(out)" ];
-- 
2.56.0

