From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio-aotearoa@mio19.uk>
Date: Fri, 27 Nov 2026 15:58:44 +1100
Subject: [PATCH 1/1] nixpkgs: vendor the FFmpeg openapv compatibility patch

The upstream cgit-generated patch is not byte-stable, so fetchpatch2 now fails its pinned hash. Vendor the same compatibility hunk locally to keep FFmpeg builds reproducible.
---
 .../0002-vendor-openapv-compat-patch.patch    | 62 +++++++++++++++++++
 pkgs.nix                                      |  1 +
 2 files changed, 63 insertions(+)
 create mode 100644 overlay/nixpkgs-patches/0002-vendor-openapv-compat-patch.patch

diff --git a/overlay/nixpkgs-patches/0002-vendor-openapv-compat-patch.patch b/overlay/nixpkgs-patches/0002-vendor-openapv-compat-patch.patch
new file mode 100644
index 00000000..bfa4f3a1
--- /dev/null
+++ b/overlay/nixpkgs-patches/0002-vendor-openapv-compat-patch.patch
@@ -0,0 +1,62 @@
+diff --git a/pkgs/development/libraries/ffmpeg/generic.nix b/pkgs/development/libraries/ffmpeg/generic.nix
+index e8c0669..4b1e76e 100644
+--- a/pkgs/development/libraries/ffmpeg/generic.nix
++++ b/pkgs/development/libraries/ffmpeg/generic.nix
+@@ -520,11 +520,8 @@ stdenv.mkDerivation (
+       ++ optionals (lib.versionAtLeast version "8") [
+         # compatibility with openapv 1.1. remove when >8.1.3 and >9.0.2
+         # https://code.ffmpeg.org/FFmpeg/FFmpeg/pulls/24663
+-        (fetchpatch2 {
+-          name = "openapv-1.1-compat.patch";
+-          url = "https://code.ffmpeg.org/FFmpeg/FFmpeg/commit/c54710db21c1827dbc3e47658a562525af0fe528.patch";
+-          hash = "sha256-ENpPDEHtl3kj/UF52hfV+LwvO7CUaK8UvTy+OAYlWFw=";
+-        })
++        # Vendored because the cgit-generated patch is not byte-stable.
++        ./openapv-1.1-compat.patch
+       ];
+ 
+     configurePlatforms = [ ];
+diff --git a/pkgs/development/libraries/ffmpeg/openapv-1.1-compat.patch b/pkgs/development/libraries/ffmpeg/openapv-1.1-compat.patch
+new file mode 100644
+index 0000000..aa617fb
+--- /dev/null
++++ b/pkgs/development/libraries/ffmpeg/openapv-1.1-compat.patch
+@@ -0,0 +1,38 @@
++From c54710db21c1827dbc3e47658a562525af0fe528 Mon Sep 17 00:00:00 2001
++From: Werner Robitza <werner.robitza@gmail.com>
++Date: Thu, 24 Sep 2026 15:02:42 +0200
++Subject: [PATCH] avcodec/liboapvenc: fix build with openapv >= 1.1
++
++openapv 1.1 changed oapvm_create() to take a descriptor argument.
++This was first raised here:
++https://github.com/homebrew-ffmpeg/homebrew-ffmpeg/issues/235
++---
++ libavcodec/liboapvenc.c | 7 +++++++
++ 1 file changed, 7 insertions(+)
++
++diff --git a/libavcodec/liboapvenc.c b/libavcodec/liboapvenc.c
++index 22a8ac4890a8e..32a8cd5f1c9ac 100644
++--- a/libavcodec/liboapvenc.c
+++++ b/libavcodec/liboapvenc.c
++@@ -477,6 +477,9 @@ static av_cold int liboapve_init(AVCodecContext *avctx)
++ {
++     ApvEncContext *apv = avctx->priv_data;
++     oapve_cdesc_t *cdsc = &apv->cdsc;
+++#if OAPV_VER_APISET >= 1
+++    oapvm_cdesc_t mcdsc = { 0 };
+++#endif
++     unsigned char *bs_buf;
++     int ret;
++ 
++@@ -509,7 +512,11 @@ static av_cold int liboapve_init(AVCodecContext *avctx)
++     }
++ 
++     /* create metadata handler */
+++#if OAPV_VER_APISET >= 1
+++    apv->mid = oapvm_create(&mcdsc, &ret);
+++#else
++     apv->mid = oapvm_create(&ret);
+++#endif
++     if (apv->mid == NULL || OAPV_FAILED(ret)) {
++         av_log(avctx, AV_LOG_ERROR, "cannot create OAPV metadata handler\n");
++         return AVERROR_EXTERNAL;
diff --git a/pkgs.nix b/pkgs.nix
index 49a7d93a..f89c05fe 100644
--- a/pkgs.nix
+++ b/pkgs.nix
@@ -21,6 +21,7 @@ let
     src = rawNixpkgs;
     patches = [
       ./overlay/nixpkgs-patches/0001-qt6-cross-host-leak.patch
+      ./overlay/nixpkgs-patches/0002-vendor-openapv-compat-patch.patch
     ];
   };
 in
