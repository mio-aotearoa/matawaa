From ce4a66be472095f6c633e81ad096df8c33c2403a Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 20 Nov 2026 21:51:50 +1100
Subject: [PATCH] asteroid: bump asteroid-launcher (PR #312) and enable beluga
 timepiece

---
 devices/oppo-beluga/default.nix                  |  1 +
 overlay/asteroidos/asteroid-launcher/default.nix | 10 ++++++++--
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/devices/oppo-beluga/default.nix b/devices/oppo-beluga/default.nix
index 8c7325b4..f57888e1 100644
--- a/devices/oppo-beluga/default.nix
+++ b/devices/oppo-beluga/default.nix
@@ -12,6 +12,7 @@ in
   imports = [
     ../families/asteroidos.nix
     ../fossil-hoki/hybris.nix
+    ../fossil-hoki/timepiece.nix
     ./android-init.nix
   ];
 
diff --git a/overlay/asteroidos/asteroid-launcher/default.nix b/overlay/asteroidos/asteroid-launcher/default.nix
index eea23a56..b4d456ca 100644
--- a/overlay/asteroidos/asteroid-launcher/default.nix
+++ b/overlay/asteroidos/asteroid-launcher/default.nix
@@ -33,8 +33,8 @@ stdenv.mkDerivation {
   src = fetchFromGitHub {
     owner = "AsteroidOS";
     repo = "asteroid-launcher";
-    rev = "29f4257ec9835ead090c8157e46948c769081ed2";
-    hash = "sha256-o+x4/2/ctZgrRN+TyebUfccxGsErpxobbC7rjrXl+rA=";
+    rev = "854e0e0bbd5bdeed2f1240887d86f2b2a274642d";
+    hash = "sha256-Ur/h4fw7DTaqHf8kIAXqJ5Lceqta095Urq4T8YQv+rg=";
   };
 
   strictDeps = true;
@@ -79,6 +79,12 @@ stdenv.mkDerivation {
       url = "https://github.com/AsteroidOS/asteroid-launcher/pull/308.diff";
       hash = "sha256-QzBzGPIk9khM8Q5b7ZHMhxd/TVI6UrDIthZMzn7el1I=";
     })
+    # Simplify and fix language spinner in FirstRunConfig
+    # Upstream PR: https://github.com/AsteroidOS/asteroid-launcher/pull/312
+    (fetchpatch {
+      url = "https://github.com/AsteroidOS/asteroid-launcher/pull/312.patch";
+      hash = "sha256-/Cpfn3QonXG/kea1hXEuSkSkXxKLb9yRmBJHr/n71kY=";
+    })
     # Remove OpacityMask dependency from the 400ms initial splash animation
     ./splash-no-opacitymask.patch
     # Proactively show and activate compositor window on startup (matching upstream AsteroidOS DisplayOn)
-- 
