diff --git a/overlay/asteroidos/usb-moded/default.nix b/overlay/asteroidos/usb-moded/default.nix
new file mode 100644
index 00000000..ad261ae7
--- /dev/null
+++ b/overlay/asteroidos/usb-moded/default.nix
@@ -0,0 +1,68 @@
+# AsteroidOS USB mode controller daemon (com.meego.usb_moded)
+# Drives Linux configfs USB gadgets for charging_only, developer_mode (SSH/usbnet), and adb_mode.
+{
+  lib,
+  stdenv,
+  cmake,
+  qt6,
+  coreutils,
+  util-linux,
+  iproute2,
+  procps,
+  systemd,
+  busybox,
+}:
+
+stdenv.mkDerivation {
+  pname = "usb-moded";
+  version = "1.0.0";
+
+  src = ./.;
+
+  strictDeps = true;
+
+  nativeBuildInputs = [
+    cmake
+    qt6.wrapQtAppsHook
+  ];
+
+  buildInputs = [
+    qt6.qtbase
+  ];
+
+  dontWrapQtApps = true;
+
+  installPhase = ''
+    runHook preInstall
+    cmake --install .
+    install -Dm755 ${./usb-moded-switch.sh} $out/libexec/usb-moded-switch
+    substituteInPlace $out/libexec/usb-moded-switch \
+      --replace-fail "@mountpoint@" "${util-linux}/bin/mountpoint" \
+      --replace-fail "@mount@" "${util-linux}/bin/mount" \
+      --replace-fail "@umount@" "${util-linux}/bin/umount" \
+      --replace-fail "@mkdir@" "${coreutils}/bin/mkdir" \
+      --replace-fail "@ls@" "${coreutils}/bin/ls" \
+      --replace-fail "@head@" "${coreutils}/bin/head" \
+      --replace-fail "@cat@" "${coreutils}/bin/cat" \
+      --replace-fail "@rm@" "${coreutils}/bin/rm" \
+      --replace-fail "@ln@" "${coreutils}/bin/ln" \
+      --replace-fail "@seq@" "${coreutils}/bin/seq" \
+      --replace-fail "@sleep@" "${coreutils}/bin/sleep" \
+      --replace-fail "@sed@" "${coreutils}/bin/sed" \
+      --replace-fail "@hostname@" "${coreutils}/bin/hostname" \
+      --replace-fail "@ip@" "${iproute2}/bin/ip" \
+      --replace-fail "@pkill@" "${procps}/bin/pkill" \
+      --replace-fail "@pgrep@" "${procps}/bin/pgrep" \
+      --replace-fail "@systemctl@" "${systemd}/bin/systemctl" \
+      --replace-fail "@udhcpd@" "${busybox}/bin/udhcpd"
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "ConfigFS USB mode controller daemon (com.meego.usb_moded) for AsteroidOS";
+    homepage = "https://asteroidos.org";
+    license = licenses.gpl3Plus;
+    platforms = platforms.linux;
+    mainProgram = "usb_moded";
+  };
+}
diff --git a/overlay/asteroidos/usb-moded/usb-moded-switch.sh b/overlay/asteroidos/usb-moded/usb-moded-switch.sh
new file mode 100644
index 00000000..6f7fb2f8
--- /dev/null
+++ b/overlay/asteroidos/usb-moded/usb-moded-switch.sh
@@ -0,0 +1,143 @@
+#!/bin/sh
+set -eu
+
+MODE="${1:-charging_only}"
+G="/sys/kernel/config/usb_gadget/g1"
+
+@mountpoint@ -q /sys/kernel/config || {
+  @mkdir@ -p /sys/kernel/config
+  @mount@ -t configfs none /sys/kernel/config
+}
+
+UDC="$(@ls@ /sys/class/udc 2>/dev/null | @head@ -n1 || true)"
+
+# Unbind active gadget and clean previous config links before switching
+if [ -d "$G" ]; then
+  if [ -n "$(@cat@ "$G/UDC" 2>/dev/null || true)" ]; then
+    echo "" > "$G/UDC" 2>/dev/null || true
+  fi
+  @rm@ -f "$G/configs/c.1/ncm.usb0" "$G/configs/c.1/rndis.usb0" "$G/configs/c.1/ffs.adb" 2>/dev/null || true
+fi
+
+# Tear down previous mode daemons / interfaces
+if [ "$MODE" != "adb_mode" ]; then
+  @pkill@ -x adbd 2>/dev/null || true
+  if @mountpoint@ -q /dev/usb-ffs/adb; then
+    @umount@ /dev/usb-ffs/adb 2>/dev/null || true
+  fi
+fi
+
+if [ "$MODE" != "developer_mode" ]; then
+  @pkill@ -x udhcpd 2>/dev/null || true
+  for iface in usb0 rndis0; do
+    if [ -e "/sys/class/net/$iface" ]; then
+      @ip@ link set "$iface" down 2>/dev/null || true
+    fi
+  done
+fi
+
+# Charging only: leave UDC unbound (hardware charging stays active)
+if [ "$MODE" = "charging_only" ]; then
+  exit 0
+fi
+
+[ -n "$UDC" ] || {
+  echo "No USB device controller found" >&2
+  exit 1
+}
+
+# Initialize base configfs gadget
+@mkdir@ -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"
+SERIAL="$(@sed@ -n 's/.*androidboot\.serialno=\([^ ]*\).*/\1/p' /proc/cmdline | @head@ -n1)"
+[ -n "$SERIAL" ] || SERIAL="$(@cat@ /etc/machine-id 2>/dev/null || echo 0123456789)"
+HOST="$(@hostname@ 2>/dev/null || echo AsteroidOS)"
+
+echo "0x18d1" > "$G/idVendor"
+echo "$SERIAL" > "$G/strings/0x409/serialnumber"
+echo "AsteroidOS" > "$G/strings/0x409/manufacturer"
+echo "$HOST" > "$G/strings/0x409/product"
+
+case "$MODE" in
+  developer_mode)
+    echo "0xd001" > "$G/idProduct"
+    echo "RNDIS" > "$G/configs/c.1/strings/0x409/configuration"
+
+    FUNC="rndis.usb0"
+    if ! @mkdir@ -p "$G/functions/$FUNC" 2>/dev/null; then
+      FUNC="ecm.usb0"
+      if ! @mkdir@ -p "$G/functions/$FUNC" 2>/dev/null; then
+        FUNC="ncm.usb0"
+        @mkdir@ -p "$G/functions/$FUNC"
+      fi
+    fi
+    @ln@ -sf "$G/functions/$FUNC" "$G/configs/c.1/$FUNC"
+    echo "$UDC" > "$G/UDC"
+
+    NET_IF=""
+    for _ in $(@seq@ 1 20); do
+      for cand in usb0 rndis0; do
+        if [ -e "/sys/class/net/$cand" ]; then
+          NET_IF="$cand"
+          break 2
+        fi
+      done
+      @sleep@ 0.25
+    done
+
+    if [ -n "$NET_IF" ]; then
+      @ip@ addr replace 192.168.2.15/24 dev "$NET_IF"
+      @ip@ addr replace 172.16.42.1/24 dev "$NET_IF"
+      @ip@ link set "$NET_IF" up
+
+      @pkill@ -x udhcpd 2>/dev/null || true
+      @cat@ > /run/usb-moded-udhcpd.conf <<EOF
+start 192.168.2.20
+end 192.168.2.30
+interface $NET_IF
+max_leases 10
+lease_file /run/usb-moded-udhcpd.leases
+pidfile /run/usb-moded-udhcpd.pid
+opt subnet 255.255.255.0
+opt lease 3600
+EOF
+      @udhcpd@ /run/usb-moded-udhcpd.conf 2>/dev/null || true
+    fi
+
+    @systemctl@ start --no-block sshd.service 2>/dev/null || true
+    ;;
+
+  adb_mode)
+    echo "0xd001" > "$G/idProduct"
+    echo "ADB" > "$G/configs/c.1/strings/0x409/configuration"
+
+    @mkdir@ -p "$G/functions/ffs.adb"
+    @ln@ -sf "$G/functions/ffs.adb" "$G/configs/c.1/ffs.adb"
+
+    @mkdir@ -p /dev/usb-ffs/adb
+    if ! @mountpoint@ -q /dev/usb-ffs/adb; then
+      @mount@ -t functionfs adb /dev/usb-ffs/adb
+    fi
+
+    ADBD_BIN="$(command -v adbd 2>/dev/null || echo /run/current-system/sw/bin/adbd)"
+    [ -x "$ADBD_BIN" ] || {
+      echo "adbd binary not found" >&2
+      exit 1
+    }
+
+    if ! @pgrep@ -x adbd >/dev/null 2>&1; then
+      "$ADBD_BIN" </dev/null >/dev/null 2>&1 &
+    fi
+
+    for _ in $(@seq@ 1 20); do
+      [ -e /dev/usb-ffs/adb/ep0 ] && break
+      @sleep@ 0.15
+    done
+
+    echo "$UDC" > "$G/UDC"
+    ;;
+
+  *)
+    echo "Unsupported USB mode: $MODE" >&2
+    exit 1
+    ;;
+esac
diff --git a/overlay/asteroidos/usb-moded/usbmodedservice.cpp b/overlay/asteroidos/usb-moded/usbmodedservice.cpp
new file mode 100644
index 00000000..9a5b60fc
--- /dev/null
+++ b/overlay/asteroidos/usb-moded/usbmodedservice.cpp
@@ -0,0 +1,218 @@
+#include "usbmodedservice.h"
+
+#include <QCoreApplication>
+#include <QDBusConnection>
+#include <QDBusError>
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QSettings>
+
+namespace {
+const QString kSupportedModes = QStringLiteral("charging_only,developer_mode,adb_mode");
+const QString kConfigDir = QStringLiteral("/var/lib/usb-moded");
+const QString kConfigPath = QStringLiteral("/var/lib/usb-moded/usb-moded.ini");
+} // namespace
+
+UsbModedService::UsbModedService(const QString &switchHelper, QObject *parent)
+    : QObject(parent)
+    , m_switchHelper(switchHelper)
+    , m_currentMode(QStringLiteral("charging_only"))
+    , m_targetMode(QStringLiteral("charging_only"))
+    , m_whitelistedModes(kSupportedModes)
+{
+}
+
+bool UsbModedService::isSupportedMode(const QString &mode)
+{
+    return mode == QLatin1String("charging_only")
+           || mode == QLatin1String("developer_mode")
+           || mode == QLatin1String("adb_mode");
+}
+
+QString UsbModedService::readPersistedMode() const
+{
+    if (!QFile::exists(kConfigPath)) {
+        return QStringLiteral("charging_only");
+    }
+    QSettings settings(kConfigPath, QSettings::IniFormat);
+    const QString mode = settings.value(QStringLiteral("usbmode/mode"), QStringLiteral("charging_only")).toString().trimmed();
+    return isSupportedMode(mode) ? mode : QStringLiteral("charging_only");
+}
+
+bool UsbModedService::writePersistedMode(const QString &mode) const
+{
+    QDir().mkpath(kConfigDir);
+    QSettings settings(kConfigPath, QSettings::IniFormat);
+    settings.setValue(QStringLiteral("usbmode/mode"), mode);
+    settings.sync();
+    return settings.status() == QSettings::NoError;
+}
+
+bool UsbModedService::applyMode(const QString &mode)
+{
+    if (!isSupportedMode(mode)) {
+        emit sig_usb_state_error_ind(QStringLiteral("unsupported_mode"));
+        return false;
+    }
+
+    m_targetMode = mode;
+    emit sig_usb_target_state_ind(mode);
+    emit sig_usb_state_ind(QStringLiteral("busy"));
+
+    QProcess proc;
+    proc.start(m_switchHelper, {mode});
+    if (!proc.waitForFinished(15000) || proc.exitCode() != 0) {
+        const QString err = QString::fromUtf8(proc.readAllStandardError()).trimmed();
+        qWarning() << "usb-moded: switch helper failed for" << mode << ":" << err;
+        emit sig_usb_state_error_ind(err.isEmpty() ? QStringLiteral("switch_failed") : err);
+        return false;
+    }
+
+    m_currentMode = mode;
+    emit sig_usb_current_state_ind(mode);
+    emit sig_usb_state_ind(mode);
+    emit sig_usb_taget_mode_config_ind(get_target_mode_config());
+    return true;
+}
+
+void UsbModedService::applyInitialMode()
+{
+    const QString mode = readPersistedMode();
+    applyMode(mode);
+}
+
+QString UsbModedService::mode_request()
+{
+    return m_currentMode;
+}
+
+QString UsbModedService::get_target_state()
+{
+    return m_targetMode;
+}
+
+QVariantMap UsbModedService::get_target_mode_config()
+{
+    QVariantMap map;
+    map.insert(QStringLiteral("mode"), m_targetMode);
+    return map;
+}
+
+QString UsbModedService::set_mode(const QString &mode)
+{
+    if (!isSupportedMode(mode)) {
+        emit sig_usb_state_error_ind(QStringLiteral("unsupported_mode"));
+        return m_currentMode;
+    }
+    applyMode(mode);
+    return m_currentMode;
+}
+
+QString UsbModedService::set_config(const QString &config)
+{
+    if (!isSupportedMode(config)) {
+        return readPersistedMode();
+    }
+    writePersistedMode(config);
+    emit sig_usb_config_ind(QStringLiteral("usbmode"), QStringLiteral("mode"), config);
+    return config;
+}
+
+QString UsbModedService::get_config()
+{
+    return readPersistedMode();
+}
+
+QString UsbModedService::get_modes()
+{
+    return kSupportedModes;
+}
+
+QString UsbModedService::get_available_modes()
+{
+    return kSupportedModes;
+}
+
+QString UsbModedService::get_available_modes_for_user()
+{
+    return kSupportedModes;
+}
+
+QString UsbModedService::hide_mode(const QString &)
+{
+    return m_hiddenModes;
+}
+
+QString UsbModedService::unhide_mode(const QString &)
+{
+    return m_hiddenModes;
+}
+
+QString UsbModedService::get_hidden()
+{
+    return m_hiddenModes;
+}
+
+QString UsbModedService::get_whitelisted_modes()
+{
+    return m_whitelistedModes;
+}
+
+void UsbModedService::set_whitelisted_modes(const QString &modes)
+{
+    m_whitelistedModes = modes;
+    emit sig_usb_whitelisted_modes_ind(m_whitelistedModes);
+}
+
+void UsbModedService::set_whitelisted(const QString &, bool)
+{
+}
+
+QString UsbModedService::net_config(const QString &, const QString &value)
+{
+    return value;
+}
+
+QString UsbModedService::get_net_config(const QString &)
+{
+    return QString();
+}
+
+void UsbModedService::rescue_off()
+{
+}
+
+void UsbModedService::clear_config(uint)
+{
+    QFile::remove(kConfigPath);
+    emit sig_usb_config_ind(QStringLiteral("usbmode"), QStringLiteral("mode"), QStringLiteral("charging_only"));
+}
+
+int main(int argc, char *argv[])
+{
+    QCoreApplication app(argc, argv);
+
+    const QString helper = qEnvironmentVariable("USB_MODED_SWITCH_BIN", QStringLiteral(USB_MODED_SWITCH_BIN));
+    UsbModedService service(helper);
+
+    QDBusConnection bus = QDBusConnection::systemBus();
+    if (!bus.isConnected()) {
+        qCritical() << "usb-moded: cannot connect to system D-Bus";
+        return 1;
+    }
+
+    if (!bus.registerObject(QStringLiteral("/com/meego/usb_moded"), &service,
+                            QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllSignals)) {
+        qCritical() << "usb-moded: failed to register object:" << bus.lastError().message();
+        return 1;
+    }
+
+    if (!bus.registerService(QStringLiteral("com.meego.usb_moded"))) {
+        qCritical() << "usb-moded: failed to register service:" << bus.lastError().message();
+        return 1;
+    }
+
+    service.applyInitialMode();
+    return app.exec();
+}
