From b727d2b06608ce2146e554b0b5bd8d990a95d050 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 20 Nov 2026 14:09:41 +1100
Subject: [PATCH] usb-moded: run udhcpd DHCP server on usb0 in developer_mode

---
 overlay/asteroidos/usb-moded/default.nix         |  4 +++-
 overlay/asteroidos/usb-moded/usb-moded-switch.sh | 14 ++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/overlay/asteroidos/usb-moded/default.nix b/overlay/asteroidos/usb-moded/default.nix
index 57a279e4..ad261ae7 100644
--- a/overlay/asteroidos/usb-moded/default.nix
+++ b/overlay/asteroidos/usb-moded/default.nix
@@ -10,6 +10,7 @@
   iproute2,
   procps,
   systemd,
+  busybox,
 }:
 
 stdenv.mkDerivation {
@@ -52,7 +53,8 @@ stdenv.mkDerivation {
       --replace-fail "@ip@" "${iproute2}/bin/ip" \
       --replace-fail "@pkill@" "${procps}/bin/pkill" \
       --replace-fail "@pgrep@" "${procps}/bin/pgrep" \
-      --replace-fail "@systemctl@" "${systemd}/bin/systemctl"
+      --replace-fail "@systemctl@" "${systemd}/bin/systemctl" \
+      --replace-fail "@udhcpd@" "${busybox}/bin/udhcpd"
     runHook postInstall
   '';
 
diff --git a/overlay/asteroidos/usb-moded/usb-moded-switch.sh b/overlay/asteroidos/usb-moded/usb-moded-switch.sh
index e523889e..64b2c51e 100644
--- a/overlay/asteroidos/usb-moded/usb-moded-switch.sh
+++ b/overlay/asteroidos/usb-moded/usb-moded-switch.sh
@@ -28,6 +28,7 @@ if [ "$MODE" != "adb_mode" ]; then
 fi
 
 if [ "$MODE" != "developer_mode" ]; then
+  @pkill@ -x udhcpd 2>/dev/null || true
   for iface in usb0 rndis0; do
     if [ -e "/sys/class/net/$iface" ]; then
       @ip@ link set "$iface" down 2>/dev/null || true
@@ -84,6 +85,19 @@ case "$MODE" in
       @ip@ addr replace 192.168.2.15/24 dev "$NET_IF"
       @ip@ addr replace 172.16.42.1/24 dev "$NET_IF"
       @ip@ link set "$NET_IF" up
+
+      @pkill@ -x udhcpd 2>/dev/null || true
+      @cat@ > /run/usb-moded-udhcpd.conf <<EOF
+start 192.168.2.20
+end 192.168.2.30
+interface $NET_IF
+max_leases 10
+lease_file /run/usb-moded-udhcpd.leases
+pidfile /run/usb-moded-udhcpd.pid
+opt subnet 255.255.255.0
+opt lease 3600
+EOF
+      @udhcpd@ /run/usb-moded-udhcpd.conf 2>/dev/null || true
     fi
 
     @systemctl@ start --no-block sshd.service 2>/dev/null || true
-- 
2.56.0

