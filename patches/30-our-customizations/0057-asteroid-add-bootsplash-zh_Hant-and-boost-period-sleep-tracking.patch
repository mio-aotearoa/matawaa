++        const QDate startDate = QDate::fromString(startStr, Qt::ISODate);
++        if (!startDate.isValid()) {
++            continue;
++        }
++        QVariantMap item;
++        item.insert(QStringLiteral("startDate"), startStr);
++        item.insert(QStringLiteral("endDate"), obj.value(QStringLiteral("endDate")).toString());
++        item.insert(QStringLiteral("flow"), qBound(1, obj.value(QStringLiteral("flow")).toInt(2), 3));
++        parsed.append(item);
++    }
++
++    std::sort(parsed.begin(), parsed.end(), [](const QVariantMap &a, const QVariantMap &b) {
++        return a.value(QStringLiteral("startDate")).toString() > b.value(QStringLiteral("startDate")).toString();
++    });
