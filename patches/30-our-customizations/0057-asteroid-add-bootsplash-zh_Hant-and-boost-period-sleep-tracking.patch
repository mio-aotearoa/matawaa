diff --git a/overlay/asteroidos/asteroid-bootsplash/asteroid-bootsplash.c b/overlay/asteroidos/asteroid-bootsplash/asteroid-bootsplash.c
new file mode 100644
index 00000000..83ccf2dc
--- /dev/null
+++ b/overlay/asteroidos/asteroid-bootsplash/asteroid-bootsplash.c
@@ -0,0 +1,320 @@
+/*
+ * asteroid-bootsplash: Lightweight Linux framebuffer boot animation for AsteroidOS.
+ * Uses precomputed polar LUTs + RAM backbuffer + memcpy to /dev/fb0 for tear-free
+ * 30fps rendering on low-power ARM smartwatches.
+ * Listens on /run/psplash_fifo for "QUIT" (sent by asteroid-launcher.service).
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <math.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+static volatile sig_atomic_t g_running = 1;
+
+static void handle_signal(int sig) {
+    (void)sig;
+    g_running = 0;
+}
+
+static uint64_t now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000ULL + (uint64_t)(ts.tv_nsec / 1000000ULL);
+}
+
+static void unblank_fb(void) {
+    int fd = open("/sys/class/graphics/fb0/blank", O_WRONLY);
+    if (fd >= 0) {
+        ssize_t unused = write(fd, "0\n", 2);
+        (void)unused;
+        close(fd);
+    }
+}
+
+static inline uint8_t clamp_u8(float v) {
+    if (v <= 0.0f) return 0;
+    if (v >= 255.0f) return 255;
+    return (uint8_t)(v + 0.5f);
+}
+
+static inline float smoothstep(float edge0, float edge1, float x) {
+    float t = (x - edge0) / (edge1 - edge0);
+    if (t < 0.0f) t = 0.0f;
+    if (t > 1.0f) t = 1.0f;
+    return t * t * (3.0f - 2.0f * t);
+}
+
+static inline float wrap_angle_pos(float a) {
+    const float two_pi = (float)(2.0 * M_PI);
+    a = fmodf(a, two_pi);
+    if (a < 0.0f) a += two_pi;
+    return a;
+}
+
+typedef struct {
+    float base_r, base_g, base_b;
+    float angle;
+    float radial_ring;
+    float diamond;
+    uint8_t in_ring;
+} PixelLut;
+
+static PixelLut *build_lut(int w, int h) {
+    PixelLut *lut = calloc((size_t)w * (size_t)h, sizeof(PixelLut));
+    if (!lut) return NULL;
+
+    const int min_dim = w < h ? w : h;
+    const float cx = (float)w * 0.5f;
+    const float cy = (float)h * 0.5f;
+    const float ring_r = (float)min_dim * 0.25f;
+    const float ring_thick = (float)min_dim * 0.018f;
+
+    for (int y = 0; y < h; ++y) {
+        const float dy = ((float)y + 0.5f) - cy;
+        const float dy2 = dy * dy;
+        for (int x = 0; x < w; ++x) {
+            const float dx = ((float)x + 0.5f) - cx;
+            const float dist = sqrtf(dx * dx + dy2);
+            PixelLut *p = &lut[(size_t)y * (size_t)w + (size_t)x];
+
+            float glow = expf(-dist / ((float)min_dim * 0.28f));
+            float r = 5.0f + 4.0f * glow;
+            float g = 7.0f + 18.0f * glow;
+            float b = 11.0f + 26.0f * glow;
+
+            float d_ring = fabsf(dist - ring_r);
+            float track_a = 1.0f - smoothstep(ring_thick * 0.4f, ring_thick * 0.9f, d_ring);
+            if (track_a > 0.0f) {
+                r += track_a * 18.0f;
+                g += track_a * 32.0f;
+                b += track_a * 42.0f;
+            }
+
+            p->base_r = r;
+            p->base_g = g;
+            p->base_b = b;
+            p->diamond = (fabsf(dx) + fabsf(dy)) * 0.72f;
+            if (d_ring < ring_thick * 2.2f) {
+                p->in_ring = 1;
+                p->angle = wrap_angle_pos(atan2f(dy, dx));
+                p->radial_ring = 1.0f - smoothstep(ring_thick * 0.45f, ring_thick * 1.15f, d_ring);
+            }
+        }
+    }
+    return lut;
+}
+
+static void render_frame(
+    uint8_t *backbuf,
+    uint8_t *fbmem,
+    size_t screensize,
+    const struct fb_var_screeninfo *vinfo,
+    const struct fb_fix_screeninfo *finfo,
+    const PixelLut *lut,
+    float t_sec
+) {
+    const int w = (int)vinfo->xres;
+    const int h = (int)vinfo->yres;
+    const int min_dim = w < h ? w : h;
+    const float head_angle = wrap_angle_pos(t_sec * 3.1f);
+    const float pulse = 0.5f + 0.5f * sinf(t_sec * 2.8f);
+    const float core_r = (float)min_dim * (0.042f + 0.010f * pulse);
+    const float core_e0 = core_r * 0.75f;
+    const float core_e1 = core_r * 1.15f;
+    const float tail_len = 2.4f;
+    const float two_pi = (float)(2.0 * M_PI);
+
+    const int bytes_pp = (int)vinfo->bits_per_pixel / 8;
+    const uint32_t xoff = vinfo->xoffset;
+    const uint32_t yoff = vinfo->yoffset;
+
+    for (int y = 0; y < h; ++y) {
+        uint8_t *row = backbuf + ((size_t)(y + (int)yoff) * finfo->line_length) + ((size_t)xoff * (size_t)bytes_pp);
+        const PixelLut *lrow = lut + (size_t)y * (size_t)w;
+
+        for (int x = 0; x < w; ++x) {
+            const PixelLut *p = &lrow[x];
+            float r = p->base_r;
+            float g = p->base_g;
+            float b = p->base_b;
+
+            if (p->in_ring) {
+                float behind = head_angle - p->angle;
+                if (behind < 0.0f) behind += two_pi;
+                if (behind < tail_len) {
+                    float arc_fade = 1.0f - (behind / tail_len);
+                    arc_fade *= arc_fade;
+                    float intensity = arc_fade * p->radial_ring;
+                    r += intensity * 40.0f;
+                    g += intensity * 210.0f;
+                    b += intensity * 235.0f;
+                }
+            }
+
+            if (p->diamond < core_e1) {
+                float core_a = 1.0f - smoothstep(core_e0, core_e1, p->diamond);
+                if (core_a > 0.0f) {
+                    r += core_a * (50.0f + 35.0f * pulse);
+                    g += core_a * (220.0f + 25.0f * pulse);
+                    b += core_a * 245.0f;
+                }
+            }
+
+            uint8_t ur = clamp_u8(r);
+            uint8_t ug = clamp_u8(g);
+            uint8_t ub = clamp_u8(b);
+
+            if (vinfo->bits_per_pixel == 32) {
+                uint32_t pix = 0;
+                pix |= ((uint32_t)(ur >> (8 - vinfo->red.length))) << vinfo->red.offset;
+                pix |= ((uint32_t)(ug >> (8 - vinfo->green.length))) << vinfo->green.offset;
+                pix |= ((uint32_t)(ub >> (8 - vinfo->blue.length))) << vinfo->blue.offset;
+                if (vinfo->transp.length > 0) {
+                    pix |= ((uint32_t)((1U << vinfo->transp.length) - 1U)) << vinfo->transp.offset;
+                }
+                ((uint32_t *)row)[x] = pix;
+            } else if (vinfo->bits_per_pixel == 16) {
+                uint16_t pix = 0;
+                pix |= (uint16_t)(((ur >> (8 - vinfo->red.length)) << vinfo->red.offset));
+                pix |= (uint16_t)(((ug >> (8 - vinfo->green.length)) << vinfo->green.offset));
+                pix |= (uint16_t)(((ub >> (8 - vinfo->blue.length)) << vinfo->blue.offset));
+                ((uint16_t *)row)[x] = pix;
+            } else if (vinfo->bits_per_pixel == 24) {
+                uint8_t *out = row + x * 3;
+                if (vinfo->red.offset == 16) {
+                    out[0] = ub; out[1] = ug; out[2] = ur;
+                } else {
+                    out[0] = ur; out[1] = ug; out[2] = ub;
+                }
+            }
+        }
+    }
+
+    memcpy(fbmem, backbuf, screensize);
+}
+
+int main(int argc, char **argv) {
+    int once = 0;
+    for (int i = 1; i < argc; ++i) {
+        if (strcmp(argv[i], "--once") == 0) {
+            once = 1;
+        }
+    }
+
+    signal(SIGTERM, handle_signal);
+    signal(SIGINT, handle_signal);
+
+    unblank_fb();
+
+    int fbfd = open("/dev/fb0", O_RDWR);
+    if (fbfd < 0) {
+        fbfd = open("/dev/graphics/fb0", O_RDWR);
+    }
+    if (fbfd < 0) {
+        return 1;
+    }
+
+    struct fb_var_screeninfo vinfo;
+    struct fb_fix_screeninfo finfo;
+    if (ioctl(fbfd, FBIOGET_VSCREENINFO, &vinfo) < 0 ||
+        ioctl(fbfd, FBIOGET_FSCREENINFO, &finfo) < 0) {
+        close(fbfd);
+        return 1;
+    }
+
+    size_t screensize = (size_t)finfo.line_length * (size_t)(vinfo.yres + vinfo.yoffset);
+    if (screensize == 0 || finfo.smem_len == 0) {
+        close(fbfd);
+        return 1;
+    }
+    if (screensize > finfo.smem_len) {
+        screensize = finfo.smem_len;
+    }
+
+    uint8_t *fbmem = mmap(NULL, screensize, PROT_READ | PROT_WRITE, MAP_SHARED, fbfd, 0);
+    if (fbmem == MAP_FAILED) {
+        close(fbfd);
+        return 1;
+    }
+
+    uint8_t *backbuf = malloc(screensize);
+    PixelLut *lut = build_lut((int)vinfo.xres, (int)vinfo.yres);
+    if (!backbuf || !lut) {
+        free(backbuf);
+        free(lut);
+        munmap(fbmem, screensize);
+        close(fbfd);
+        return 1;
+    }
+
+    if (once) {
+        render_frame(backbuf, fbmem, screensize, &vinfo, &finfo, lut, 0.0f);
+        (void)ioctl(fbfd, FBIOPAN_DISPLAY, &vinfo);
+        free(backbuf);
+        free(lut);
+        munmap(fbmem, screensize);
+        close(fbfd);
+        return 0;
+    }
+
+    const char *fifo_path = "/run/psplash_fifo";
+    if (mkfifo(fifo_path, 0666) < 0 && errno != EEXIST) {
+        /* ignore */
+    }
+    chmod(fifo_path, 0666);
+    int fifofd = open(fifo_path, O_RDWR | O_NONBLOCK);
+
+    const uint64_t start_ms = now_ms();
+    const uint64_t max_runtime_ms = 120000ULL;
+    char buf[128];
+
+    while (g_running) {
+        uint64_t elapsed = now_ms() - start_ms;
+        if (elapsed >= max_runtime_ms) {
+            break;
+        }
+
+        if (fifofd >= 0) {
+            ssize_t n = read(fifofd, buf, sizeof(buf) - 1);
+            if (n > 0) {
+                buf[n] = '\0';
+                if (strstr(buf, "QUIT") != NULL) {
+                    break;
+                }
+            }
+        } else {
+            fifofd = open(fifo_path, O_RDWR | O_NONBLOCK);
+        }
+
+        render_frame(backbuf, fbmem, screensize, &vinfo, &finfo, lut, (float)elapsed / 1000.0f);
+        (void)ioctl(fbfd, FBIOPAN_DISPLAY, &vinfo);
+
+        struct timespec req = { 0, 33000000L }; /* ~30 fps */
+        nanosleep(&req, NULL);
+    }
+
+    if (fifofd >= 0) {
+        close(fifofd);
+    }
+    free(backbuf);
+    free(lut);
+    munmap(fbmem, screensize);
+    close(fbfd);
+    return 0;
+}
diff --git a/overlay/asteroidos/asteroid-bootsplash/default.nix b/overlay/asteroidos/asteroid-bootsplash/default.nix
new file mode 100644
index 00000000..39d93cb0
--- /dev/null
+++ b/overlay/asteroidos/asteroid-bootsplash/default.nix
@@ -0,0 +1,29 @@
+{
+  lib,
+  stdenv,
+}:
+
+stdenv.mkDerivation {
+  pname = "asteroid-bootsplash";
+  version = "1.0.0";
+
+  src = ./.;
+
+  buildPhase = ''
+    runHook preBuild
+    $CC -O2 -Wall -Wextra -std=c11 asteroid-bootsplash.c -lm -o asteroid-bootsplash
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    install -Dm755 asteroid-bootsplash $out/bin/asteroid-bootsplash
+    runHook postInstall
+  '';
+
+  meta = with lib; {
+    description = "Lightweight animated Linux framebuffer boot splash for AsteroidOS";
+    license = licenses.gpl3Plus;
+    platforms = platforms.linux;
+  };
+}
