++        QStringList dates;
++        for (int offset = -periodStartVariation; offset <= periodStartVariation; ++offset) {
++            dates.append(nextCenter.addDays(offset).toString(Qt::ISODate));
++        }
++
++        QVariantMap item;
++        item.insert(QStringLiteral("center"), nextCenter.toString(Qt::ISODate));
++        item.insert(QStringLiteral("windowStart"), windowStart.toString(Qt::ISODate));
++        item.insert(QStringLiteral("windowEnd"), windowEnd.toString(Qt::ISODate));
