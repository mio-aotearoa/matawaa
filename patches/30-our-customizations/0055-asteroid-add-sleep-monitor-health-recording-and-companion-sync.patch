++void PeriodDataLoader::recomputeMetrics()
++{
++    m_currentCycleDay = 0;
++    m_isPeriodActive = false;
++    m_currentFlow = 2;
++
++    m_validCycleLengthCount = 0;
++    m_minCycleLength = 0;
++    m_maxCycleLength = 0;
++    m_meanCycleLength = 0.0;
++    m_medianCycleLength = 0.0;
++    m_cycleStdDeviation = -1.0;
++    m_hasPrediction = false;
++    m_predictedPeriodStart.clear();
++    m_predictedWindowStart.clear();
++    m_predictedWindowEnd.clear();
++    m_predictedVariationDays = 0;
++    m_daysUntilNextPeriod = 0;
++    m_predictedMenses.clear();
++
++    const QDate today = QDate::currentDate();
++
++    // Collect valid start dates <= today (m_cycles is already sorted newest first)
++    struct CycleStart {
++        QDate date;
++        bool excluded = false;
++        int listIndex = -1;
++    };
++    std::vector<CycleStart> starts;
++    starts.reserve(static_cast<size_t>(m_cycles.size()));
++    for (int idx = 0; idx < m_cycles.size(); ++idx) {
++        auto m = m_cycles.at(idx).toMap();
++        m.remove(QStringLiteral("cycleLength"));
++        m_cycles[idx] = m;
++        const QDate start = QDate::fromString(m.value(QStringLiteral("startDate")).toString(), Qt::ISODate);
++        if (!start.isValid() || start > today) {
++            continue;
++        }
++        if (starts.empty()) {
++            // Port of getCycleDayNumber() from bloodyhealth/drip src/lib/cycle.js
++            const qint64 diffInDays = start.daysTo(today);
++            if (diffInDays >= 0 && diffInDays < kMaxCycleLength) {
++                m_currentCycleDay = static_cast<int>(diffInDays) + 1;
++            }
++            const QDate end = QDate::fromString(m.value(QStringLiteral("endDate")).toString(), Qt::ISODate);
++            m_isPeriodActive = !end.isValid() || end >= today;
++            m_currentFlow = qBound(1, m.value(QStringLiteral("flow"), 2).toInt(), 3);
++        }
++        starts.push_back(CycleStart{start, m.value(QStringLiteral("excluded")).toBool(), idx});
++    }
++
++    if (starts.size() < 2) {
++        return;
++    }
++
++    // Port of getAllCycleLengths() from bloodyhealth/drip src/lib/cycle.js:
++    // filter(length => length && length <= maxCycleLength), skipping user-excluded atypical cycles
++    // (addresses missed-log right-tail skew documented in Li et al. 2020 & Bull et al. 2019).
++    std::vector<int> cycleLengths;
++    for (size_t i = 0; i + 1 < starts.size(); ++i) {
++        const qint64 len = starts[i + 1].date.daysTo(starts[i].date);
++        if (len > 0) {
++            QVariantMap m = m_cycles.at(starts[i + 1].listIndex).toMap();
++            m.insert(QStringLiteral("cycleLength"), static_cast<int>(len));
++            m_cycles[starts[i + 1].listIndex] = m;
++        }
++        if (starts[i + 1].excluded) {
++            continue;
++        }
++        if (len > 0 && len <= kMaxCycleLength) {
++            cycleLengths.push_back(static_cast<int>(len));
++        }
++    }
++
++    m_validCycleLengthCount = static_cast<int>(cycleLengths.size());
++    if (cycleLengths.empty()) {
++        return;
++    }
++
++    const DripCycleLengthStats stats = computeDripCycleLengthStats(cycleLengths);
++    m_minCycleLength = stats.minimum;
++    m_maxCycleLength = stats.maximum;
++    m_meanCycleLength = stats.mean;
++    m_medianCycleLength = stats.median;
++    m_cycleStdDeviation = stats.stdDeviation;
++
++    // Port of getPredictedMenses() from bloodyhealth/drip src/lib/cycle.js
++    if (static_cast<int>(cycleLengths.size()) < kMinCyclesForPrediction) {
++        return;
++    }
++
++    const int periodDistance = static_cast<int>(std::round(stats.mean));
++    int periodStartVariation = 2;
++    if (stats.stdDeviation >= 0.0 && stats.stdDeviation < 1.5) {
