++void SleepDetector::addEpoch(qint64 epochSec, double angleZDeg, bool nonWear)
++{
++    if (epochSec <= 0 || !std::isfinite(angleZDeg)) {
++        ++m_invalidSamples;
++        return;
++    }
++    if (!m_epochs.empty()) {
++        if (epochSec <= m_epochs.back().timestampSec) {
++            ++m_invalidSamples;
++            return;
++        }
++        if (epochSec - m_epochs.back().timestampSec > 3 * kEpochSec) {
++            ++m_gaps;
++        }
++    }
++    m_epochs.push_back(AngleEpoch{epochSec, angleZDeg, nonWear});
++}
