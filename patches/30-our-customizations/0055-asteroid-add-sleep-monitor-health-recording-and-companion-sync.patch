++void SleepDetector::setUnits(AccelUnits units)
++{
++    m_units = units;
++    if (units == AccelUnits::MetersPerSecSq) {
++        m_unitScale = kStandardGravity;
++    } else if (units == AccelUnits::Gravity) {
++        m_unitScale = 1.0;
++    } else {
++        m_unitScale = 0.0;
