++namespace {
++
++// Port of getCycleLengthStats() from bloodyhealth/drip src/lib/cycle-length.js
++struct DripCycleLengthStats {
++    int minimum = 0;
++    int maximum = 0;
++    double mean = 0.0;
++    double median = 0.0;
++    double stdDeviation = -1.0; // < 0 represents null (fewer than 2 lengths)
++};
++
++DripCycleLengthStats computeDripCycleLengthStats(std::vector<int> cycleLengths)
++{
++    DripCycleLengthStats stats;
++    if (cycleLengths.empty()) {
++        return stats;
++    }
++
++    std::sort(cycleLengths.begin(), cycleLengths.end());
++    const int n = static_cast<int>(cycleLengths.size());
++    stats.minimum = cycleLengths.front();
++    stats.maximum = cycleLengths.back();
++
++    double sum = 0.0;
++    for (int len : cycleLengths) {
++        sum += static_cast<double>(len);
++    }
++    const double rawMean = sum / static_cast<double>(n);
++    stats.mean = std::round(rawMean * 100.0) / 100.0;
++
++    if (n % 2 == 1) {
++        stats.median = static_cast<double>(cycleLengths[n / 2]);
++    } else {
++        stats.median = static_cast<double>(cycleLengths[n / 2 - 1] + cycleLengths[n / 2]) / 2.0;
++    }
++
++    // Corrected standard deviation (unbiased sample variance, n - 1 denominator) using unrounded mean,
++    // matching bloodyhealth/drip src/lib/cycle-length.js.
++    if (n > 1) {
++        double sumOfSquares = 0.0;
++        for (int len : cycleLengths) {
++            const double diff = static_cast<double>(len) - rawMean;
++            sumOfSquares += diff * diff;
++        }
++        stats.stdDeviation =
++            std::round(std::sqrt(sumOfSquares / static_cast<double>(n - 1)) * 100.0) / 100.0;
++    }
++
++    return stats;
++}
++
++} // namespace
