++    }
++
++    // Overlap guard from drip: if (periodDistance - 5 < periodStartVariation) return []
++    if (periodDistance - 5 < periodStartVariation) {
++        return;
++    }
++
++    QDate nextCenter = starts.front().date;
++    for (int i = 0; i < 3; ++i) {
++        nextCenter = nextCenter.addDays(periodDistance);
++        const QDate windowStart = nextCenter.addDays(-periodStartVariation);
++        const QDate windowEnd = nextCenter.addDays(periodStartVariation);
