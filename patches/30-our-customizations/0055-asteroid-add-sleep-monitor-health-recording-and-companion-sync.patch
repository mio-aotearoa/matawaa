++namespace {
++
++constexpr double kRadToDeg = 57.2957795130823208768;
++constexpr double kStandardGravity = 9.80665;
++
++double medianOf(std::vector<double> &values)
++{
++    if (values.empty()) return 0.0;
++    const size_t n = values.size();
++    const size_t mid = n / 2;
++    std::nth_element(values.begin(), values.begin() + static_cast<ptrdiff_t>(mid), values.end());
++    const double hi = values[mid];
++    if (n % 2 == 1) {
++        return hi;
++    }
++    const double lo = *std::max_element(values.begin(), values.begin() + static_cast<ptrdiff_t>(mid));
++    return 0.5 * (lo + hi);
++}
++
++// Linear-interpolated quantile matching R's stats::quantile(..., type = 7)
++double quantileType7(std::vector<double> values, double prob)
++{
++    if (values.empty()) return 0.0;
++    std::sort(values.begin(), values.end());
++    const double idx = prob * static_cast<double>(values.size() - 1);
++    const size_t lo = static_cast<size_t>(std::floor(idx));
++    const size_t hi = static_cast<size_t>(std::ceil(idx));
++    const double frac = idx - static_cast<double>(lo);
++    return values[lo] + frac * (values[hi] - values[lo]);
++}
++
++struct Run {
++    int value = 0;
++    size_t start = 0;
++    size_t length = 0;
++};
++
++std::vector<Run> runLengthEncode(const std::vector<int> &bits)
++{
++    std::vector<Run> runs;
++    if (bits.empty()) return runs;
++    size_t start = 0;
++    for (size_t i = 1; i <= bits.size(); ++i) {
++        if (i == bits.size() || bits[i] != bits[start]) {
++            runs.push_back(Run{bits[start], start, i - start});
++            start = i;
++        }
++    }
++    return runs;
++}
