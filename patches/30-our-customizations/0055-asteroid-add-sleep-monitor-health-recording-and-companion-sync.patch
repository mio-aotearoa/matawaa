++void SleepDetector::reset()
++{
++    m_epochs.clear();
++    m_nonWearBlocks.clear();
++    m_bucketStartSec = -1;
++    m_sumX = m_sumY = m_sumZ = 0.0;
++    m_bucketCount = 0;
++    m_bucketOnCharger = false;
++    if (m_units == AccelUnits::Auto) {
++        m_unitScale = 0.0;
++    }
++    m_invalidSamples = 0;
++    m_gaps = 0;
++}
++
++bool SleepDetector::addSample(qint64 utcSec, double x, double y, double z, bool onCharger)
++{
++    if (utcSec <= 0 || !std::isfinite(x) || !std::isfinite(y) || !std::isfinite(z)) {
++        ++m_invalidSamples;
++        return false;
++    }
++    const double mag2 = x * x + y * y + z * z;
++    if (mag2 < 1e-9) {
++        ++m_invalidSamples;
++        return false;
++    }
++
++    const qint64 bucket = (utcSec / kEpochSec) * kEpochSec;
++    if (m_bucketStartSec >= 0 && bucket < m_bucketStartSec) {
++        ++m_invalidSamples;
++        return false;
++    }
++    if (m_bucketStartSec >= 0 && bucket > m_bucketStartSec) {
++        finalizeBucket();
++        if (bucket - m_bucketStartSec > 3 * kEpochSec) {
++            ++m_gaps;
++        }
++    }
++    if (m_bucketStartSec != bucket) {
++        m_bucketStartSec = bucket;
++        m_sumX = m_sumY = m_sumZ = 0.0;
++        m_bucketCount = 0;
++        m_bucketOnCharger = false;
++    }
++
++    m_sumX += x;
++    m_sumY += y;
++    m_sumZ += z;
++    ++m_bucketCount;
++    if (onCharger) {
++        m_bucketOnCharger = true;
++    }
++
++    // Latch unit scale once per session so transient bumps or free-fall samples
++    // never inject a 9.8x scaling jump into Welford variance/range statistics.
++    if (m_unitScale <= 0.0) {
++        const double mag = std::sqrt(mag2);
++        m_unitScale = (mag > 4.0) ? kStandardGravity : 1.0;
++    }
++    const double gx = x / m_unitScale;
++    const double gy = y / m_unitScale;
++    const double gz = z / m_unitScale;
++    const qint64 nwKey = (utcSec / kNonWearBlockSec) * kNonWearBlockSec;
++    auto &nwBlock = m_nonWearBlocks[nwKey];
++    if (nwBlock.lastCoveredEpoch != bucket) {
++        nwBlock.lastCoveredEpoch = bucket;
++        ++nwBlock.coveredEpochs;
++    }
++    ++nwBlock.sampleCount;
++    if (std::abs(gx) >= kClipThresholdG || std::abs(gy) >= kClipThresholdG || std::abs(gz) >= kClipThresholdG) {
++        ++nwBlock.clippedCount;
++    }
++    nwBlock.axes[0].add(gx);
++    nwBlock.axes[1].add(gy);
++    nwBlock.axes[2].add(gz);
++    return true;
++}
++
++void SleepDetector::finalizeBucket()
++{
++    if (m_bucketStartSec < 0 || m_bucketCount <= 0) {
++        return;
++    }
++    const double mx = m_sumX / static_cast<double>(m_bucketCount);
++    const double my = m_sumY / static_cast<double>(m_bucketCount);
++    const double mz = m_sumZ / static_cast<double>(m_bucketCount);
++    const double horiz = std::sqrt(mx * mx + my * my);
++    // van Hees et al. (2015): angle_z = atan(z / sqrt(x^2 + y^2)) * 180 / pi
++    // Pure axis ratio: invariant to constant accelerometer gain/unit scaling.
++    const double angleZ = std::atan2(mz, horiz) * kRadToDeg;
++    m_epochs.push_back(AngleEpoch{m_bucketStartSec, angleZ, m_bucketOnCharger});
++    m_sumX = m_sumY = m_sumZ = 0.0;
++    m_bucketCount = 0;
++    m_bucketOnCharger = false;
++}
++
++void SleepDetector::flushCurrentEpoch()
++{
++    finalizeBucket();
++}
