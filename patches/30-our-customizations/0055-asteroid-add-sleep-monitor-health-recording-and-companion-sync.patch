Date: Sat, 21 Nov 2026 20:51:35 +1100
Subject: [PATCH] asteroid: add bounded health recording, manual history and
 companion sync

---
 examples/asteroid/asteroid-desktop.nix        |   14 +
 overlay/asteroidos/community-apps/default.nix |    8 +
 .../community-apps/health-sleep-monitor.patch |  872 ++++++++++++
 .../sensorlogd-sleep-monitor.patch            | 1243 +++++++++++++++++
 4 files changed, 2137 insertions(+)
 create mode 100644 overlay/asteroidos/community-apps/health-sleep-monitor.patch
 create mode 100644 overlay/asteroidos/community-apps/sensorlogd-sleep-monitor.patch

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index 61225458..6defac30 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -708,6 +708,20 @@ in
         LD_LIBRARY_PATH = "${pkgs.libhybris}/lib:${pkgs.asteroid.libconnman-qt}/lib";
       };
 
+      # Background health/sleep/steps/HR sensor logger user daemon.
+      systemd.user.services.asteroid-sensorlogd = {
+        description = "AsteroidOS sensor logger (HR, steps, sleep)";
+        wantedBy = [ "default.target" ];
+        requires = [ "dbus.socket" ];
+        after = [ "dbus.socket" ];
+        unitConfig.ConditionUser = "!root";
+        serviceConfig = {
+          ExecStart = "${pkgs.asteroid.community-apps.sensorlogd}/bin/sensorlogd";
+          Restart = "on-failure";
+          RestartSec = 5;
+        };
+      };
+
       # Upstream asteroid-alarmclock installs share/systemd/user/alarmpresenter.service
       # plus the com.nokia.voland D-Bus activation file; expose the same user
       # service so Nemo.Alarms can present firing alarms on demand when the
