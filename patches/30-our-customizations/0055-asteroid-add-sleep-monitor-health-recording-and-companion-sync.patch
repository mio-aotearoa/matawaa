++SleepAnalysisResult SleepDetector::analyze() const
++{
++    std::vector<AngleEpoch> snapshot = m_epochs;
++    // Include any in-progress 5-second bucket without mutating m_epochs
++    if (m_bucketStartSec >= 0 && m_bucketCount > 0) {
++        const double mx = m_sumX / static_cast<double>(m_bucketCount);
++        const double my = m_sumY / static_cast<double>(m_bucketCount);
++        const double mz = m_sumZ / static_cast<double>(m_bucketCount);
++        const double horiz = std::sqrt(mx * mx + my * my);
++        const double angleZ = std::atan2(mz, horiz) * kRadToDeg;
++        if (!snapshot.empty() && snapshot.back().timestampSec == m_bucketStartSec) {
++            snapshot.back().angleZDeg = angleZ;
++            snapshot.back().nonWear = snapshot.back().nonWear || m_bucketOnCharger;
++        } else {
++            snapshot.push_back(AngleEpoch{m_bucketStartSec, angleZ, m_bucketOnCharger});
++        }
++    }
++
++    const auto nonWearBlocks = detectNonWearBlocks();
++    if (!nonWearBlocks.empty()) {
++        for (auto &ep : snapshot) {
++            const qint64 nwKey = (ep.timestampSec / kNonWearBlockSec) * kNonWearBlockSec;
++            auto it = nonWearBlocks.find(nwKey);
++            if (it != nonWearBlocks.end() && it->second) {
++                ep.nonWear = true;
++            }
++        }
++    }
++
++    return analyzeEpochs(snapshot);
++}
++
++SleepAnalysisResult SleepDetector::analyzeEpochs(const std::vector<AngleEpoch> &epochs)
++{
++    SleepAnalysisResult res;
++    if (static_cast<int>(epochs.size()) < kMinAnalysisEpochs) {
++        return res;
++    }
++
++    // Build a uniform 5-second timeline from first to last epoch, marking missing/non-wear epochs invalid.
++    const qint64 firstSec = epochs.front().timestampSec;
++    const qint64 lastSec = epochs.back().timestampSec;
++    if (lastSec <= firstSec) {
++        return res;
++    }
++    const qint64 spanEpochs = (lastSec - firstSec) / kEpochSec + 1;
++    // Cap at 24 hours (17280 epochs) to bound watch memory/CPU.
++    if (spanEpochs < kMinAnalysisEpochs || spanEpochs > 17280) {
++        return res;
++    }
++
++    const size_t N = static_cast<size_t>(spanEpochs);
++    std::vector<double> angle(N, std::numeric_limits<double>::quiet_NaN());
++    std::vector<bool> valid(N, false);
++    int nonWearEpochs = 0;
++    for (const auto &ep : epochs) {
++        if (ep.timestampSec < firstSec || ep.timestampSec > lastSec) continue;
++        const size_t idx = static_cast<size_t>((ep.timestampSec - firstSec) / kEpochSec);
++        if (idx < N && std::isfinite(ep.angleZDeg)) {
++            if (ep.nonWear) {
++                ++nonWearEpochs;
++                valid[idx] = false;
++            } else {
++                angle[idx] = ep.angleZDeg;
++                valid[idx] = true;
++            }
++        }
++    }
++    res.nonWearMinutes = (nonWearEpochs * kEpochSec) / 60;
++
++    // Step 1: Sustained Inactivity Bouts (van Hees et al., 2015, PLOS ONE)
++    // Mark all epochs belonging to any 5-minute (60-epoch) contiguous valid window
++    // whose angle_z range (max - min) is < 5.0 degrees.
++    std::vector<bool> sib(N, false);
++    for (size_t i = 0; i + kSibWindowEpochs <= N; ++i) {
++        double minA = std::numeric_limits<double>::infinity();
++        double maxA = -std::numeric_limits<double>::infinity();
++        bool allValid = true;
++        for (size_t j = 0; j < kSibWindowEpochs; ++j) {
++            if (!valid[i + j]) {
++                allValid = false;
++                break;
++            }
++            if (angle[i + j] < minA) minA = angle[i + j];
++            if (angle[i + j] > maxA) maxA = angle[i + j];
++        }
++        if (allValid && (maxA - minA) < kSibAngleThresholdDeg) {
++            for (size_t j = 0; j < kSibWindowEpochs; ++j) {
++                sib[i + j] = true;
++            }
++        }
++    }
++
++    // Step 2: HDCZA SPT window detection (van Hees et al., 2018, Sci Rep; GGIR R/HASPT.R)
++    // x[i] = 5-min rolling median of |diff(angle_z)| across 60 angle epochs (59 diffs).
++    std::vector<double> absDiff(N, 0.0);
++    std::vector<bool> diffValid(N, false);
++    for (size_t i = 1; i < N; ++i) {
++        if (valid[i] && valid[i - 1]) {
++            absDiff[i] = std::abs(angle[i] - angle[i - 1]);
++            diffValid[i] = true;
++        }
++    }
++
++    std::vector<double> rollMed(N, std::numeric_limits<double>::quiet_NaN());
++    std::vector<double> validRollMed;
++    validRollMed.reserve(N);
++    constexpr size_t kRollDiffs = static_cast<size_t>(kHdczaRollEpochs - 1);
++    const size_t halfWin = kRollDiffs / 2;
++    std::vector<double> scratch;
++    scratch.reserve(kRollDiffs);
++
++    for (size_t i = 0; i < N; ++i) {
++        if (!valid[i]) continue;
++        const size_t wStart = (i > halfWin) ? (i - halfWin) : 0;
++        const size_t wEnd = std::min(N, i + halfWin + 1);
++        scratch.clear();
++        for (size_t j = wStart; j < wEnd; ++j) {
++            if (diffValid[j]) {
++                scratch.push_back(absDiff[j]);
++            }
++        }
++        if (!scratch.empty()) {
++            const double m = medianOf(scratch);
++            rollMed[i] = m;
++            validRollMed.push_back(m);
++        }
++    }
++
++    if (validRollMed.empty()) {
++        return res;
++    }
++
++    // GGIR HASPT.R lines 113-121: threshold = clamp(quantile(x, 0.10) * 15, 0.13, 0.50)
++    double threshold = quantileType7(validRollMed, 0.10) * 15.0;
++    if (threshold < kHdczaMinThreshold) threshold = kHdczaMinThreshold;
++    if (threshold > kHdczaMaxThreshold) threshold = kHdczaMaxThreshold;
++    res.hdczaThreshold = threshold;
++
++    // nomov = 1 where valid && rollMed < threshold (invalid/non-wear treated as movement)
++    std::vector<int> nomov(N, 0);
++    for (size_t i = 0; i < N; ++i) {
++        if (valid[i] && rollMed[i] < threshold) {
++            nomov[i] = 1;
++        }
++    }
++
++    // GGIR HASPT.R Step -3: ignore nomov==1 blocks <= spt_min_block_dur (30 min)
++    for (const auto &run : runLengthEncode(nomov)) {
++        if (run.value == 1 && run.length <= static_cast<size_t>(kSptMinBlockEpochs)) {
++            std::fill(nomov.begin() + static_cast<ptrdiff_t>(run.start),
++                      nomov.begin() + static_cast<ptrdiff_t>(run.start + run.length), 0);
++        }
++    }
++
++    // GGIR HASPT.R Step -2: fill interior nomov==0 gaps < spt_max_gap_dur (60 min)
++    {
++        const auto runs = runLengthEncode(nomov);
++        for (size_t r = 1; r + 1 < runs.size(); ++r) {
++            if (runs[r].value == 0 && runs[r].length < static_cast<size_t>(kSptMaxGapEpochs)) {
++                std::fill(nomov.begin() + static_cast<ptrdiff_t>(runs[r].start),
++                          nomov.begin() + static_cast<ptrdiff_t>(runs[r].start + runs[r].length), 1);
++            }
++        }
++    }
++
++    // GGIR HASPT.R Step -1: keep the longest remaining nomov==1 block as the SPT window
++    size_t bestStart = 0;
++    size_t bestLen = 0;
++    for (const auto &run : runLengthEncode(nomov)) {
++        if (run.value == 1 && run.length > bestLen) {
++            bestStart = run.start;
++            bestLen = run.length;
++        }
++    }
++
++    if (bestLen == 0) {
++        return res;
++    }
++
++    const size_t bestEnd = bestStart + bestLen; // exclusive
++    res.sptStartSec = firstSec + static_cast<qint64>(bestStart) * kEpochSec;
++    res.sptEndSec = firstSec + static_cast<qint64>(bestEnd) * kEpochSec;
++
++    // Aggregate 5-second SIB states inside SPT into per-minute records (1 = sleep, 0 = awake)
++    struct MinuteBucket {
++        int validCount = 0;
++        int sibCount = 0;
++    };
++    std::map<qint64, MinuteBucket> perMinute;
++    for (size_t i = bestStart; i < bestEnd; ++i) {
++        if (!valid[i]) continue;
++        const qint64 sec = firstSec + static_cast<qint64>(i) * kEpochSec;
++        const qint64 minSec = (sec / 60) * 60;
++        auto &mb = perMinute[minSec];
++        ++mb.validCount;
++        if (sib[i]) ++mb.sibCount;
