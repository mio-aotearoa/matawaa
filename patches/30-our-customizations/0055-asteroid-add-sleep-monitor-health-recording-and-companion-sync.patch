++// SPDX-License-Identifier: GPL-3.0-or-later
++#pragma once
++
++#include <QDateTime>
++#include <QTimeZone>
++
++// A half-open interval in watch-local civil time. Construct both dates separately
++// so the saved end time also applies on daylight-saving transition nights.
++struct SleepWindow {
++    QDateTime start;
++    QDateTime end;
++
++    static SleepWindow currentOrNext(QDateTime now, QTime from, QTime to) {
++        QDate day = now.date();
++        if (now.time() < from) day = day.addDays(-1);
++        auto windowFor = [&](QDate date) -> SleepWindow {
++            return {QDateTime(date, from, now.timeZone()),
++                    QDateTime(date.addDays(to <= from ? 1 : 0), to, now.timeZone())};
++        };
++        SleepWindow window = windowFor(day);
++        if (now >= window.end) window = windowFor(day.addDays(1));
++        return window;
++    }
++};
