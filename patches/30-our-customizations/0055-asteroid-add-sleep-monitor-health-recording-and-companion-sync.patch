++// SPDX-License-Identifier: GPL-3.0-or-later
++/*
++ * Copyright (C) 2026 AsteroidOS / Matawaa
++ *
++ * Reads validated 2-field sleep/wake logs (<epoch_sec>:<0|1>) produced by
++ * SleepMonitorPlugin (van Hees 2015/2018 / GGIR). Legacy 4-field logs remain
++ * accessible via getDataForDate() marked legacy=true and are never promoted
++ * into sleep duration totals.
++ */
++#include "sleepDataLoader.h"
++#include "../common.h"
++
++#include <QDateTime>
++#include <QDir>
++#include <QFile>
++#include <QJsonDocument>
++#include <QJsonObject>
++#include <QMap>
++#include <QSettings>
++#include <QTextStream>
++#include <QVariantList>
++#include <QVariantMap>
++
++SleepDataLoader::SleepDataLoader() : QObject()
++{
++    m_iface = new QDBusInterface("org.asteroid.sensorlogd.logger", "/org/asteroid/sensorlogd/logger",
++                                 QString(), QDBusConnection::sessionBus(), this);
++    m_fileWatcher = new QFileSystemWatcher(this);
++    setupFilePath(QStringLiteral("sleepMonitor"));
++    m_fileWatcher->addPath(sensorDirPath(QStringLiteral("sleepMonitor")));
++    connect(m_fileWatcher, &QFileSystemWatcher::directoryChanged, this, &SleepDataLoader::dataChanged);
++}
++
++QVariant SleepDataLoader::getDataForDate(QDate date)
++{
++    QVariantList result;
++    QFile file(fileNameForDate(date, QStringLiteral("sleepMonitor")));
++    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return result;
++    QTextStream in(&file);
++    while (!in.atEnd()) {
++        const QString line = in.readLine().trimmed();
++        if (line.isEmpty()) continue;
++        const auto fields = line.split(QLatin1Char(':'));
++        if (fields.size() == 2) {
++            bool timeOk = false, stateOk = false;
++            const qint64 timestamp = fields[0].toLongLong(&timeOk);
++            const int state = fields[1].toInt(&stateOk);
++            if (!timeOk || timestamp <= 0 || !stateOk || (state != 0 && state != 1)) continue;
++            result.append(QVariantMap{{"timestamp", timestamp}, {"state", state}, {"legacy", false}});
++        } else if (fields.size() >= 3) {
++            bool timeOk = false, stageOk = false;
++            const qint64 timestamp = fields[0].toLongLong(&timeOk);
++            const int stage = fields[1].toInt(&stageOk);
++            if (!timeOk || timestamp <= 0 || !stageOk || stage < -1 || stage > 3) continue;
++            result.append(QVariantMap{{"timestamp", timestamp}, {"stage", stage}, {"legacy", true}});
++        }
++    }
++    return result;
++}
++
++QVariant SleepDataLoader::getTodayData() { return getDataForDate(QDate::currentDate()); }
++
++QVariant SleepDataLoader::getSleepSummary(QDate date)
++{
++    int sleepMinutes = 0;
++    int awakeMinutes = 0;
++    int legacyCount = 0;
++    qint64 onsetSec = 0;
++    qint64 wakeSec = 0;
++
++    // Deduplicate validated 2-field records by timestamp so overlapping sessions on
++    // the same wake date can never double-count sleep or awake duration.
++    QMap<qint64, int> deduped;
++    const QVariantList records = getDataForDate(date).toList();
++    for (const QVariant &v : records) {
++        const QVariantMap m = v.toMap();
++        if (m.value(QStringLiteral("legacy")).toBool()) {
++            ++legacyCount;
++            continue;
++        }
++        const qint64 ts = m.value(QStringLiteral("timestamp")).toLongLong();
++        const int state = m.value(QStringLiteral("state")).toInt();
++        if (ts > 0 && (state == 0 || state == 1)) {
++            deduped.insert(ts, state);
++        }
++    }
++    for (auto it = deduped.cbegin(); it != deduped.cend(); ++it) {
++        const qint64 ts = it.key();
++        const int state = it.value();
++        if (state == 1) {
++            if (onsetSec == 0 || ts < onsetSec) onsetSec = ts;
++            if (ts + 60 > wakeSec) wakeSec = ts + 60;
++            ++sleepMinutes;
++        } else if (state == 0) {
++            ++awakeMinutes;
++        }
++    }
++
++    QString lastStatus;
++    qint64 recordedSeconds = 0;
++    qint64 gaps = 0;
++    qint64 updatedSec = 0;
++    {
++        QFile statusFile(QDir(sensorDirPath(QStringLiteral("sleepMonitor"))).filePath(QStringLiteral("status.json")));
++        if (statusFile.open(QIODevice::ReadOnly)) {
++            const QJsonObject obj = QJsonDocument::fromJson(statusFile.readAll()).object();
++            lastStatus = obj.value(QStringLiteral("status")).toString();
++            recordedSeconds = obj.value(QStringLiteral("coveredSeconds")).toInteger();
++            gaps = obj.value(QStringLiteral("gaps")).toInteger();
++            updatedSec = obj.value(QStringLiteral("updatedSec")).toInteger();
++        }
++    }
++
++    QSettings settings("asteroid", "sensorlogd");
++    settings.sync();
++    const qint64 nowSec = QDateTime::currentSecsSinceEpoch();
++    const bool enabled = settings.value("sleepCapture/enabled", false).toBool()
++        && settings.value("sleepCapture/until", 0).toLongLong() > nowSec;
++    const bool recording = enabled && lastStatus == QStringLiteral("recording")
++        && updatedSec > 0 && (nowSec - updatedSec) <= 960;
++
++    return QVariantMap{
++        {QStringLiteral("hasData"), sleepMinutes > 0},
++        {QStringLiteral("sleepMinutes"), sleepMinutes},
++        {QStringLiteral("awakeMinutes"), awakeMinutes},
++        {QStringLiteral("onsetSec"), onsetSec},
++        {QStringLiteral("wakeSec"), wakeSec},
++        {QStringLiteral("recordedSeconds"), recordedSeconds},
++        {QStringLiteral("gaps"), gaps},
++        {QStringLiteral("lastStatus"), lastStatus},
++        {QStringLiteral("isRecording"), recording},
++        {QStringLiteral("captureEnabled"), enabled},
++        {QStringLiteral("recordingError"), settings.value("sleepCapture/lastError").toString()},
++        {QStringLiteral("legacyRecordCount"), legacyCount}
++    };
++}
++
++QVariant SleepDataLoader::getLatestRecordingSummary()
++{
++    QDate latest = QDate::currentDate();
++    const QDir directory(sensorDirPath(QStringLiteral("sleepMonitor")));
++    const QStringList files = directory.entryList({QStringLiteral("*.log")}, QDir::Files, QDir::Name | QDir::Reversed);
++    for (const QString &name : files) {
++        const QDate d = QDate::fromString(name.left(name.size() - 4), Qt::ISODate);
++        if (!d.isValid()) continue;
++        const QVariantMap summary = getSleepSummary(d).toMap();
++        if (summary.value(QStringLiteral("hasData")).toBool()) {
++            return summary;
++        }
++    }
++    return getSleepSummary(latest);
++}
++
++QVariant SleepDataLoader::getLastNightSummary() { return getLatestRecordingSummary(); }
++void SleepDataLoader::triggerDaemonRecording() { m_iface->call(QStringLiteral("triggerRecording")); }
