++// van Hees et al. (2013) / GGIR R/detect_nonwear_clipping.R ("2023" approach):
++// Evaluate 60-minute windows (4 contiguous 15-min blocks). Flag all 4 blocks as non-wear if
++// >= 2 of 3 axes have sample SD < 13 mg OR >= 2 of 3 axes have value range < 50 mg.
++// Also flag any 15-min block where >= 80% of samples are clipped (>= kClipThresholdG).
++std::map<qint64, bool> SleepDetector::detectNonWearBlocks() const
++{
++    std::map<qint64, bool> flagged;
++    for (const auto &kv : m_nonWearBlocks) {
++        if (kv.second.sampleCount > 0 && kv.second.clippedCount * 5 >= kv.second.sampleCount * 4) {
++            flagged[kv.first] = true;
++        }
++    }
++    if (m_nonWearBlocks.size() < static_cast<size_t>(kNonWearWindowBlocks)) {
++        return flagged;
++    }
++
++    for (auto it = m_nonWearBlocks.begin(); it != m_nonWearBlocks.end(); ++it) {
++        const qint64 startKey = it->first;
++        // Require 4 contiguous 15-minute blocks forming a 60-minute window
++        std::array<const NonWearBlock *, kNonWearWindowBlocks> win{};
++        bool complete = true;
++        for (int k = 0; k < kNonWearWindowBlocks; ++k) {
++            auto found = m_nonWearBlocks.find(startKey + static_cast<qint64>(k) * kNonWearBlockSec);
++            // Require 80% of five-second bins in each block before inferring non-wear.
++            if (found == m_nonWearBlocks.end() || found->second.coveredEpochs < kMinNonWearBlockEpochs) {
++                complete = false;
++                break;
++            }
++            win[k] = &found->second;
++        }
++        if (!complete) continue;
++
++        int sdQuietAxes = 0;
++        int rangeQuietAxes = 0;
++        for (int ax = 0; ax < 3; ++ax) {
++            // Exact parallel variance merge (Chan et al., 1979) across the 4 blocks
++            qint64 nTot = 0;
++            double meanTot = 0.0;
++            double m2Tot = 0.0;
++            double minTot = std::numeric_limits<double>::infinity();
++            double maxTot = -std::numeric_limits<double>::infinity();
++            for (int k = 0; k < kNonWearWindowBlocks; ++k) {
++                const AxisStats &b = win[k]->axes[ax];
++                if (b.count <= 0) continue;
++                if (b.minVal < minTot) minTot = b.minVal;
++                if (b.maxVal > maxTot) maxTot = b.maxVal;
++                if (nTot == 0) {
++                    nTot = b.count;
++                    meanTot = b.mean;
++                    m2Tot = b.m2;
++                } else {
++                    const double delta = b.mean - meanTot;
++                    const qint64 nNew = nTot + b.count;
++                    meanTot += delta * (static_cast<double>(b.count) / static_cast<double>(nNew));
++                    m2Tot += b.m2 + delta * delta * (static_cast<double>(nTot) * static_cast<double>(b.count) / static_cast<double>(nNew));
++                    nTot = nNew;
++                }
++            }
++            if (nTot < 2) continue;
++            const double rangeG = maxTot - minTot;
++            const double sdG = std::sqrt(m2Tot / static_cast<double>(nTot - 1));
++            if (sdG < kNonWearSdG) {
++                ++sdQuietAxes;
++            }
++            if (rangeG < kNonWearRangeG) {
++                ++rangeQuietAxes;
++            }
++        }
++
++        if (sdQuietAxes >= kNonWearMinAxes || rangeQuietAxes >= kNonWearMinAxes) {
++            for (int k = 0; k < kNonWearWindowBlocks; ++k) {
++                flagged[startKey + static_cast<qint64>(k) * kNonWearBlockSec] = true;
++            }
++        }
++    }
++
++    return flagged;
++}
