From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sun, 15 Nov 2026 14:19:25 +1100
Subject: [PATCH 1/1] kernels: shrink 4.14/4.9 ignore lists with arch
 auto-drops

Drop non-ARM arch hunks automatically for Hoki stable/OpenELA/AL2
(after adaptations, matching Beluga), strip redundant arch excludes,
keep AL2 tipc (not built), and document Beluga's exit.c drop as
already ported by adaptation 0002.
---
 devices/fossil-hoki/kernel/default.nix | 78 ++++++++++++--------------
 devices/oppo-beluga/kernel/default.nix |  2 +
 2 files changed, 37 insertions(+), 43 deletions(-)

diff --git a/devices/fossil-hoki/kernel/default.nix b/devices/fossil-hoki/kernel/default.nix
index 9c825243..4f978811 100644
--- a/devices/fossil-hoki/kernel/default.nix
+++ b/devices/fossil-hoki/kernel/default.nix
@@ -80,7 +80,9 @@ let
 
   # Kernel.org's incremental 4.14 patches each rewrite the Makefile's
   # VERSION/PATCHLEVEL/SUBLEVEL. The vendor Makefile is kept as-is and postPatch
-  # sets SUBLEVEL once, so those hunks are dropped for every version.
+  # sets SUBLEVEL once, so those hunks are dropped for every version. This
+  # kernel is 32-bit ARM only, so changes for other architectures are dropped
+  # as well (same rule as oppo-beluga).
   #
   # Two kinds of divergence remain:
   #   * a fix the vendor tree already carries: the whole file is listed in
@@ -94,6 +96,10 @@ let
       name = "linux-4.14.${range}.patch";
       adaptation = ./stable/${name}.patch;
       hasAdaptation = builtins.pathExists adaptation;
+      # Explicit excludes (and Makefile) are filtered first so adaptation
+      # patches still see the same file set they were written against. Non-ARM
+      # architecture hunks are stripped afterwards.
+      otherArches = "arch/(alpha|arc|arm64|avr32|blackfin|c6x|cris|frv|h8300|hexagon|ia64|m32r|m68k|metag|microblaze|mips|mn10300|nios2|openrisc|parisc|powerpc|s390|score|sh|sparc|tile|um|unicore32|x86|xtensa)/.*";
       droppedFiles = lib.concatStringsSep "|" (map lib.escapeRegex ([ "Makefile" ] ++ excludes));
     in
     runCommand name
@@ -111,7 +117,7 @@ let
                 url = "https://cdn.kernel.org/pub/linux/kernel/v4.x/incr/patch-4.14.${range}.xz";
                 inherit hash;
               };
-          inherit droppedFiles;
+          inherit droppedFiles otherArches;
         }
         // lib.optionalAttrs hasAdaptation { inherit adaptation; }
       )
@@ -125,7 +131,14 @@ let
         ${lib.optionalString hasAdaptation ''
           patch -p1 --batch -i "$adaptation"
         ''}
-        cp "${name}" "$out"
+        awk -v arches="$otherArches" '
+          /^diff --git / {
+            path = $3
+            sub(/^a\//, "", path)
+            skip = (path ~ "^(" arches ")$") || (path ~ /^Documentation\/arm64\//)
+          }
+          !skip { print }
+        ' "${name}" > "$out"
       '';
 
   # OpenELA kernel-lts 4.14.336 -> 4.14.357, fetched from the GitHub compare
@@ -140,6 +153,7 @@ let
       name = "openela-4.14.${lo}-${hi}.patch";
       adaptation = ./stable/${name}.patch;
       hasAdaptation = builtins.pathExists adaptation;
+      otherArches = "arch/(alpha|arc|arm64|avr32|blackfin|c6x|cris|frv|h8300|hexagon|ia64|m32r|m68k|metag|microblaze|mips|mn10300|nios2|openrisc|parisc|powerpc|s390|score|sh|sparc|tile|um|unicore32|x86|xtensa)/.*";
       droppedFiles = lib.concatStringsSep "|" (map lib.escapeRegex excludes);
     in
     runCommand name
@@ -149,7 +163,7 @@ let
             url = "https://github.com/openela/kernel-lts/compare/v4.14.${lo}-openela...v4.14.${hi}-openela.diff";
             inherit hash;
           };
-          inherit droppedFiles;
+          inherit droppedFiles otherArches;
         }
         // lib.optionalAttrs hasAdaptation { inherit adaptation; }
       )
@@ -166,7 +180,14 @@ let
         ${lib.optionalString hasAdaptation ''
           patch -p1 --batch -i "$adaptation"
         ''}
-        cp "${name}" "$out"
+        awk -v arches="$otherArches" '
+          /^diff --git / {
+            path = $3
+            sub(/^a\//, "", path)
+            skip = (path ~ "^(" arches ")$") || (path ~ /^Documentation\/arm64\//)
+          }
+          !skip { print }
+        ' "${name}" > "$out"
       '';
 
   # Amazon Linux 2's maintained 4.14 kernel: 4.14.355-287.768.amzn2 is OpenELA
@@ -188,6 +209,8 @@ let
   # and tcp callers have to stay vendor code with them. Those couplings were
   # found by building the tree, not by guessing, and every dropped file is
   # listed below with its reason.
+  # arm64/x86 and Documentation/arm64 hunks are stripped in amzn2Patch below
+  # (this target is armv7l only), so they are not listed in the seed.
   amzn2Excludes = [
     # AL2's swapin_readahead takes a vma and address; the vendor swap.h keeps
     # the vmf argument, so the caller has to stay vendor code too. The same
@@ -196,21 +219,6 @@ let
     "mm/swapfile.c"
     "mm/shmem.c"
     "include/linux/shmem_fs.h"
-    # arm64/x86 code is not built for this armv7l target, and the vendor tree
-    # carries its own arch backports.
-    "arch/arm64/Kconfig"
-    "arch/arm64/Makefile"
-    "arch/arm64/include/asm/Kbuild"
-    "arch/arm64/include/asm/cpucaps.h"
-    "arch/arm64/include/asm/spinlock.h"
-    "arch/arm64/kernel/alternative.c"
-    "arch/arm64/kernel/cpu-reset.h"
-    "arch/arm64/kernel/cpu_errata.c"
-    "arch/arm64/kernel/cpufeature.c"
-    "arch/arm64/kernel/machine_kexec.c"
-    "arch/arm64/kernel/topology.c"
-    "arch/x86/Kconfig"
-    "Documentation/arm64/silicon-errata.txt"
     # The block layer's freeze API differs: AL2 moves to a mutex-backed
     # mq_freeze_depth, which the vendor request_queue has no field for, so the
     # vendor blkdev.h has to stay with the vendor block code.
@@ -274,6 +282,8 @@ let
     "net/ipv6/syncookies.c"
     "net/ipv6/tcp_ipv6.c"
     "net/sched/sch_api.c"
+    # CONFIG_TIPC is unset on this defconfig, but the AL2 tipc hunk still fails
+    # to apply against the vendor bearer.c (per-netns sock helper callers).
     "net/tipc/bearer.c"
     # Vendor IMA carries its own template/measurement code.
     "security/integrity/ima/ima_api.c"
@@ -338,7 +348,9 @@ let
           /^diff --git / {
             path = $3
             sub(/^a\//, "", path)
-            skip = (index(dropped, " " path " ") > 0)
+            skip = (index(dropped, " " path " ") > 0) \
+              || (path ~ /^arch\/(arm64|x86)\//) \
+              || (path ~ /^Documentation\/arm64\//)
           }
           !skip { print }
         ' raw.patch > "$out"
@@ -349,7 +361,6 @@ let
     # The vendor tree already carries the perf-core and Intel PT fixes; only
     # syncookies still needs the vendor's sock_net() argument.
     (stableIncr "206-207" "sha256-U7olrDZuRkGt6GbXp6Lna20cERa5GX8RqXgbZGPrvX4=" [
-      "arch/x86/events/intel/pt.c"
       "include/linux/perf_event.h"
       "kernel/events/core.c"
     ])
@@ -429,7 +440,6 @@ let
     # rewritten around kthread_get_run, and its arm64 alternative.h places the
     # .org directives differently (this device is built for armv7l).
     (stableIncr "231-232" "sha256-p1W2eMItt4Xo5HlT9jTjVQpxu4k7Z0bJFe1g0O7w0Yo=" [
-      "arch/arm64/include/asm/alternative.h"
       "drivers/usb/usbip/vudc_sysfs.c"
       "fs/ext4/namei.c"
     ])
@@ -459,7 +469,6 @@ let
