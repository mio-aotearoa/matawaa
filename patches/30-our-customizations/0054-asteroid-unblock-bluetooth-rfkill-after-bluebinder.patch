From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matawaa <noreply@localhost>
Date: Tue, 17 Nov 2026 05:33:21 +1100
Subject: [PATCH 1/1] asteroid: unblock bluetooth rfkill after bluebinder

Persistent systemd-rfkill soft-block left bluetoothd unable to power the
adapter at boot ("Blocked through rfkill"). Clear sticky state and unblock
before bluetooth.service starts.
---
 examples/asteroid/asteroid-desktop.nix | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/examples/asteroid/asteroid-desktop.nix b/examples/asteroid/asteroid-desktop.nix
index 1539660e..74cb1d05 100644
--- a/examples/asteroid/asteroid-desktop.nix
+++ b/examples/asteroid/asteroid-desktop.nix
@@ -538,6 +538,18 @@ in
               fi
             ''}"
             "-${pkgs.asteroid.bluebinder}/libexec/bluebinder_post.sh"
+            # systemd-rfkill can restore a soft-block from
+            # /var/lib/systemd/rfkill/*bluetooth* before bluebinder is up;
+            # bluetoothd then fails with "Blocked through rfkill" and the UI
+            # toggle never powers the adapter. Clear sticky state and unblock
+            # before bluetooth.service (After this unit) starts.
+            "-${pkgs.writeShellScript "bluebinder-unblock-rfkill" ''
+              for f in /var/lib/systemd/rfkill/*bluetooth*; do
+                [ -f "$f" ] || continue
+                printf '0\n' > "$f" || true
+              done
+              ${pkgs.util-linux}/bin/rfkill unblock bluetooth || true
+            ''}"
           ];
           Restart = "always";
           # First start can race android-init / binder; give the HAL a moment.
