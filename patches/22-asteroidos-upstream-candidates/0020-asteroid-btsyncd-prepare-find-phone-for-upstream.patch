From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Mon, 23 Nov 2026 12:49:15 +1100
Subject: [PATCH] asteroid-btsyncd: fetch the upstream Find Phone PR

---
 overlay/asteroidos/asteroid-btsyncd/default.nix   |    7 ++++
 overlay/asteroidos/asteroid-btsyncd/find-phone.sh |   37 +++++++++++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 overlay/asteroidos/asteroid-btsyncd/find-phone.sh

diff --git a/overlay/asteroidos/asteroid-btsyncd/default.nix b/overlay/asteroidos/asteroid-btsyncd/default.nix
index 1f92795..19f1940 100644
--- a/overlay/asteroidos/asteroid-btsyncd/default.nix
+++ b/overlay/asteroidos/asteroid-btsyncd/default.nix
@@ -2,6 +2,7 @@
   lib,
   stdenv,
   fetchFromGitHub,
+  fetchpatch,
   cmake,
   pkg-config,
   systemd,
@@ -33,6 +34,11 @@ stdenv.mkDerivation {
   # Upstream repository: https://github.com/AsteroidOS/asteroid-btsyncd
   # Companion phone app protocol (Gadgetbridge): https://codeberg.org/Freeyourgadget/Gadgetbridge
   patches = [
+    # Add the Find Phone GATT service and D-Bus endpoint.
+    (fetchpatch {
+      url = "https://github.com/AsteroidOS/asteroid-btsyncd/pull/46.diff";
+      hash = "sha256-jOwLRozbiMjawsUyQin6G66svBzlLlUNpBsWHntGWkw=";
+    })
     # Generic App Bridge GATT service and D-Bus interface for remote camera and sensor sync
     ./app-bridge.patch
   ];
@@ -69,6 +75,7 @@ stdenv.mkDerivation {
   ];
 
   postInstall = ''
+    install -Dm755 ${./find-phone.sh} $out/bin/find-phone
     install -Dm755 ${./camera-shutter.sh} $out/bin/camera-shutter
     install -Dm644 ${./org.asteroidos.btsyncd.conf} $out/share/dbus-1/system.d/org.asteroidos.btsyncd.conf
   '';
diff --git a/overlay/asteroidos/asteroid-btsyncd/find-phone.sh b/overlay/asteroidos/asteroid-btsyncd/find-phone.sh
new file mode 100644
index 0000000..d34883f
--- /dev/null
+++ b/overlay/asteroidos/asteroid-btsyncd/find-phone.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+set -e
+
+DEST="org.asteroidos.btsyncd"
+OBJECT="/org/asteroidos/btsyncd/findphone"
+INTERFACE="org.asteroidos.btsyncd.FindPhone"
+
+usage() {
+    echo "Usage: find-phone [toggle|start|stop|status]"
+    exit 1
+}
+
+case "$1" in
+    ""|toggle)
+        busctl call "$DEST" "$OBJECT" "$INTERFACE" toggleRing 2>/dev/null || \
+        gdbus call --system --dest "$DEST" --object-path "$OBJECT" --method "$INTERFACE.toggleRing" 2>/dev/null || \
+        dbus-send --system --print-reply --dest="$DEST" "$OBJECT" "$INTERFACE.toggleRing"
+        ;;
+    start|on|ring)
+        busctl call "$DEST" "$OBJECT" "$INTERFACE" ringPhone b true 2>/dev/null || \
+        gdbus call --system --dest "$DEST" --object-path "$OBJECT" --method "$INTERFACE.ringPhone" true 2>/dev/null || \
+        dbus-send --system --print-reply --dest="$DEST" "$OBJECT" "$INTERFACE.ringPhone" boolean:true
+        ;;
+    stop|off|silence)
+        busctl call "$DEST" "$OBJECT" "$INTERFACE" ringPhone b false 2>/dev/null || \
+        gdbus call --system --dest "$DEST" --object-path "$OBJECT" --method "$INTERFACE.ringPhone" false 2>/dev/null || \
+        dbus-send --system --print-reply --dest="$DEST" "$OBJECT" "$INTERFACE.ringPhone" boolean:false
+        ;;
+    status)
+        busctl call "$DEST" "$OBJECT" "$INTERFACE" isRinging 2>/dev/null || \
+        gdbus call --system --dest "$DEST" --object-path "$OBJECT" --method "$INTERFACE.isRinging" 2>/dev/null || \
+        dbus-send --system --print-reply --dest="$DEST" "$OBJECT" "$INTERFACE.isRinging"
+        ;;
+    *)
+        usage
+        ;;
+esac
